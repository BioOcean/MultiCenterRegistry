@page "/quality/{QualityId:guid}"
@inherits BasePage

<PageTitle>@(_quality == null ? "质控详情" : $"{_quality.Name} - 质控详情")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="@GetPageClass()">
    <div class="detail-header">
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToList">返回</MudButton>
        <div>
            <h1>@(_quality?.Name ?? "质控详情")</h1>
            <div class="page-subtitle">@(_quality == null ? "" : FormatDate(_quality.QualityDate))</div>
        </div>
        <MudSpacer />
        @if (_quality != null)
        {
            <span class="status-pill @GetStatusClass(_quality.Status)">@GetStatusText(_quality.Status)</span>
        }
    </div>

    @if (_isLoading)
    {
        <MudPaper Class="loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>正在加载质控详情</span>
        </MudPaper>
    }
    else if (_quality == null)
    {
        <MudPaper Class="loading-panel" Elevation="0">未找到质控报表</MudPaper>
    }
    else
    {
        <MudPaper Class="summary-panel" Elevation="0">
            @foreach (var item in BuildSummaryItems())
            {
                <div class="summary-item">
                    <div class="summary-label">@item.Label</div>
                    <div class="summary-value">@ShowValue(item.Value)</div>
                </div>
            }
        </MudPaper>

        <MudPaper Class="action-panel" Elevation="0">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="TogglePreview">
                @(_isPreview ? "退出预览" : "PDF预览")
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       Href="@($"/exports/quality/{QualityId}.pdf")"
                       Target="_blank">下载PDF</MudButton>
            @if (_isPreview)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintPreviewAsync">打印</MudButton>
            }
            @if (!_isPreview && HasPermission(PermissionConstants.QualityCreate))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@(_isEditing ? Icons.Material.Filled.Close : Icons.Material.Filled.Edit)" OnClick="ToggleEdit">
                    @(_isEditing ? "取消编辑" : "编辑表单")
                </MudButton>
            }
            @if (!_isPreview && _isEditing && HasPermission(PermissionConstants.QualityCreate))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveItemsAsync">保存表单</MudButton>
            }
            @if (!_isPreview && (_quality.Status is 0 or 2) && HasPermission(PermissionConstants.QualityCreate))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" OnClick="SubmitQualityAsync">提交质控</MudButton>
            }
            @if (!_isPreview && _quality.Status == 1 && HasPermission(PermissionConstants.QualityManage))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Reply" OnClick="RejectQualityAsync">驳回质控</MudButton>
            }
        </MudPaper>

        @if (_rejects.Count > 0)
        {
            <MudPaper Class="reject-panel" Elevation="0">
                <div class="panel-title">
                    <h2>驳回记录</h2>
                    <span>@_rejects.Count 条</span>
                </div>
                <div class="reject-list">
                    @foreach (var reject in _rejects)
                    {
                        <div class="reject-item">
                            <div>@ShowValue(reject.Content)</div>
                            <span>@FormatDateTime(reject.CreatedAt)</span>
                        </div>
                    }
                </div>
            </MudPaper>
        }

        <MudPaper Class="form-panel" Elevation="0">
            <div class="panel-title">
                <div>
                    <h2>质控指标</h2>
                    <div class="page-subtitle">@ShowValue(_quality.TemplateName)</div>
                </div>
                <span>@_items.Count 个指标</span>
            </div>

            @if (_items.Count == 0)
            {
                <div class="empty-row">该质控报表暂无指标</div>
            }
            else
            {
                <div class="field-grid">
                    @foreach (var item in _items)
                    {
                        <div class="field-card">
                            <div class="field-name">@item.MetricName</div>
                            @if (_isEditing)
                            {
                                <input class="quality-number-input"
                                       type="number"
                                       min="0"
                                       value="@(item.CaseCount?.ToString(CultureInfo.InvariantCulture) ?? "")"
                                       @onchange="@((ChangeEventArgs args) => item.CaseCount = ParseInt(args.Value?.ToString()))" />
                            }
                            else
                            {
                                <div class="field-value">@ShowCount(item.CaseCount)</div>
                            }
                        </div>
                    }
                </div>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid QualityId { get; set; }

    private QualityReport? _quality;
    private readonly List<QualityReject> _rejects = [];
    private readonly List<QualityItemModel> _items = [];
    private bool _isLoading = true;
    private bool _isEditing;
    private bool _isPreview;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadQualityAsync();
    }

    private async Task LoadQualityAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _quality = await _registryContext.QualityReports.AsNoTracking().FirstOrDefaultAsync(x => x.Id == QualityId);
            _rejects.Clear();
            _items.Clear();
            if (_quality == null)
            {
                return;
            }

            _rejects.AddRange(await _registryContext.QualityRejects.AsNoTracking()
                .Where(x => x.QualityReportId == QualityId)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync());

            var items = await _registryContext.QualityReportItems.AsNoTracking()
                .Where(x => x.QualityReportId == QualityId)
                .OrderBy(x => x.Sort)
                .ThenBy(x => x.MetricName)
                .ToListAsync();
            _items.AddRange(items.Select(QualityItemModel.FromEntity));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BackToList() => inj_navigationManager.NavigateTo(RouteConstants.QualityList);

    private string GetPageClass() => _isPreview ? "detail-page preview-mode" : "detail-page";

    private void TogglePreview()
    {
        _isPreview = !_isPreview;
        if (_isPreview)
        {
            _isEditing = false;
        }
    }

    private async Task PrintPreviewAsync()
        => await inj_jsRuntime.InvokeVoidAsync("print");

    private void ToggleEdit()
    {
        _isEditing = !_isEditing;
        if (!_isEditing)
        {
            _ = LoadQualityAsync();
        }
    }

    private async Task SaveItemsAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.QualityCreate) || !await ConfirmAsync("确认保存当前质控表单修改？"))
        {
            return;
        }

        var ids = _items.Select(x => x.Id).ToList();
        var values = await _registryContext.QualityReportItems.Where(x => ids.Contains(x.Id)).ToListAsync();
        var now = ToDbTimestamp(DateTime.Now);
        foreach (var value in values)
        {
            var item = _items.First(x => x.Id == value.Id);
            value.CaseCount = item.CaseCount;
            value.UpdatedAt = now;
            value.UpdatedBy = CurrentUserId;
        }

        _registryContext.OperationLogs.Add(CreateOperationLog("质控", "保存表单", "quality", QualityId));
        await _registryContext.SaveChangesAsync();
        _isEditing = false;
        inj_snackbar.Add("质控表单已保存", Severity.Success);
        await LoadQualityAsync();
    }

    private async Task SubmitQualityAsync()
    {
        if (_registryContext == null || _quality == null || !await RequirePermissionAsync(PermissionConstants.QualityCreate) || !await ConfirmAsync("确认提交当前质控报表？"))
        {
            return;
        }

        if (_quality.Status is not (0 or 2))
        {
            inj_snackbar.Add("当前状态不能提交", Severity.Warning);
            return;
        }

        var now = ToDbTimestamp(DateTime.Now);
        var userName = await GetCurrentUserNameAsync();
        await _registryContext.QualityReports.Where(x => x.Id == QualityId)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.Status, 1)
                .SetProperty(x => x.QualityUserId, CurrentUserId)
                .SetProperty(x => x.QualityUserName, userName)
                .SetProperty(x => x.SubmittedAt, now)
                .SetProperty(x => x.UpdatedAt, now)
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
        _registryContext.OperationLogs.Add(CreateOperationLog("质控", "提交", "quality", QualityId));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("质控已提交", Severity.Success);
        await LoadQualityAsync();
    }

    private async Task RejectQualityAsync()
    {
        if (_registryContext == null || _quality == null)
        {
            return;
        }

        if (!await RequirePermissionAsync(PermissionConstants.QualityManage))
        {
            return;
        }

        var reason = await PromptAsync("请输入质控驳回原因");
        if (string.IsNullOrWhiteSpace(reason) || !await ConfirmAsync("确认驳回当前质控报表？"))
        {
            return;
        }

        if (_quality.Status != 1)
        {
            inj_snackbar.Add("当前状态不能驳回", Severity.Warning);
            return;
        }

        var now = ToDbTimestamp(DateTime.Now);
        await _registryContext.QualityReports.Where(x => x.Id == QualityId)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.Status, 2)
                .SetProperty(x => x.UpdatedAt, now)
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
        _registryContext.QualityRejects.Add(new QualityReject
        {
            QualityReportId = QualityId,
            Content = reason,
            CreatedAt = now!.Value,
            CreatedBy = CurrentUserId
        });
        _registryContext.OperationLogs.Add(CreateOperationLog("质控", "驳回", "quality", QualityId, reason));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("质控已驳回", Severity.Success);
        await LoadQualityAsync();
    }

    private IEnumerable<SummaryItem> BuildSummaryItems()
    {
        if (_quality == null)
        {
            yield break;
        }

        yield return new("质控月份", FormatDate(_quality.QualityDate));
        yield return new("疾病类型", _quality.TemplateName ?? RegistryFixedCatalog.GetDiseaseName(_quality.TemplateId));
        yield return new("医院", _quality.HospitalName ?? _quality.HospitalId);
        yield return new("质控员", _quality.QualityUserName ?? _quality.QualityUserId);
        yield return new("提交时间", FormatDateTime(_quality.SubmittedAt));
        yield return new("创建时间", FormatDateTime(_quality.CreatedAt));
        yield return new("更新时间", FormatDateTime(_quality.UpdatedAt));
    }

    private async Task<string?> GetCurrentUserNameAsync()
    {
        if (_registryContext == null || !Guid.TryParse(CurrentUserId, out var userId))
        {
            return null;
        }

        return await _registryContext.SystemUsers.AsNoTracking()
            .Where(x => x.Id == userId)
            .Select(x => x.DisplayName == "" ? x.Account : x.DisplayName)
            .FirstOrDefaultAsync();
    }

    private static string ShowValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string ShowCount(int? value) => value?.ToString(CultureInfo.InvariantCulture) ?? "-";

    private static int? ParseInt(string? value) => int.TryParse(value, out var result) ? Math.Max(0, result) : null;

    private static string FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string FormatDateTime(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm") ?? "-";

    private static DateTime? ToDbTimestamp(DateTime? value)
        => value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Unspecified) : null;

    private static string GetStatusText(int status)
        => status switch
        {
            0 => "未填报",
            1 => "已上报",
            2 => "已驳回",
            _ => $"状态 {status}"
        };

    private static string GetStatusClass(int status)
        => status switch
        {
            0 => "status-draft",
            1 => "status-submitted",
            2 => "status-returned",
            _ => "status-unknown"
        };

    private sealed record SummaryItem(string Label, string? Value);

    private sealed class QualityItemModel
    {
        public Guid Id { get; init; }
        public string MetricCode { get; init; } = "";
        public string MetricName { get; init; } = "";
        public int? CaseCount { get; set; }
        public int Sort { get; init; }

        public static QualityItemModel FromEntity(QualityReportItem item)
            => new()
            {
                Id = item.Id,
                MetricCode = item.MetricCode,
                MetricName = item.MetricName,
                CaseCount = item.CaseCount,
                Sort = item.Sort
            };
    }
}
