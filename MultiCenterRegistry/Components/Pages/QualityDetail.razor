@page "/quality/{QualityId:guid}"
@inherits BasePage

<PageTitle>@(_quality == null ? "质控详情" : $"{_quality.Name} - 质控详情")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="@GetPageClass()">
    <div class="detail-header">
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="BackToList">返回</MudButton>
        <div>
            <h1>@(_quality?.Name ?? "质控详情")</h1>
            <div class="page-subtitle">@(_quality == null ? "" : FormatDate(_quality.QualityDate))</div>
        </div>
        <MudSpacer />
        @if (_quality != null)
        {
            <span class="status-pill">@GetStatusText(_quality.Status)</span>
        }
    </div>

    @if (_isLoading)
    {
        <MudPaper Class="loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>正在加载质控详情</span>
        </MudPaper>
    }
    else if (_quality == null)
    {
        <MudPaper Class="loading-panel" Elevation="0">未找到质控报表</MudPaper>
    }
    else
    {
        <MudPaper Class="summary-panel" Elevation="0">
            @foreach (var item in BuildSummaryItems())
            {
                <div class="summary-item">
                    <div class="summary-label">@item.Label</div>
                    <div class="summary-value">@ShowValue(item.Value)</div>
                </div>
            }
        </MudPaper>

        <MudPaper Class="action-panel" Elevation="0">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="TogglePreview">
                @(_isPreview ? "退出预览" : "PDF预览")
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       Href="@($"/exports/quality/{QualityId}.pdf")"
                       Target="_blank">下载PDF</MudButton>
            @if (_isPreview)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintPreviewAsync">打印</MudButton>
            }
            @if (!_isPreview && HasPermission(PermissionConstants.QualityCreate))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@(_isEditing ? Icons.Material.Filled.Close : Icons.Material.Filled.Edit)" OnClick="ToggleEdit">
                    @(_isEditing ? "取消编辑" : "编辑表单")
                </MudButton>
            }
            @if (!_isPreview && _isEditing && HasPermission(PermissionConstants.QualityCreate))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveFormsAsync">保存表单</MudButton>
            }
            @if (!_isPreview && (_quality.Status is 0 or 2) && HasPermission(PermissionConstants.QualityCreate))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" OnClick="SubmitQualityAsync">提交质控</MudButton>
            }
            @if (!_isPreview && _quality.Status == 1 && HasPermission(PermissionConstants.QualityManage))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Reply" OnClick="RejectQualityAsync">驳回质控</MudButton>
            }
            @if (!_isPreview && HasPermission(PermissionConstants.QualityManage))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteQualityAsync">删除质控</MudButton>
            }
        </MudPaper>

        @if (_rejects.Count > 0)
        {
            <MudPaper Class="reject-panel" Elevation="0">
                <div class="panel-title">
                    <h2>驳回记录</h2>
                    <span>@_rejects.Count 条</span>
                </div>
                <div class="reject-list">
                    @foreach (var reject in _rejects)
                    {
                        <div class="reject-item">
                            <div>@ShowValue(reject.Content)</div>
                            <span>@FormatDateTime(reject.CreatedAt)</span>
                        </div>
                    }
                </div>
            </MudPaper>
        }

        @if (_forms.Count == 0)
        {
            <MudPaper Class="loading-panel" Elevation="0">该质控报表暂无表单数据</MudPaper>
        }
        else
        {
            @if (_forms.Count > 1)
            {
                <MudPaper Class="form-nav" Elevation="0">
                    @foreach (var form in _forms)
                    {
                        <a href="@($"#{form.Anchor}")">@form.Name</a>
                    }
                </MudPaper>
            }

            @foreach (var form in _forms)
            {
                <MudPaper id="@form.Anchor" Class="form-panel" Elevation="0">
                    <div class="panel-title">
                        <div>
                            <h2>@form.Name</h2>
                            <div class="page-subtitle">创建时间 @FormatDateTime(form.CreatedAt)</div>
                        </div>
                        <span>@form.Fields.Count 个字段</span>
                    </div>

                    <div class="field-grid">
                        @foreach (var field in form.Fields)
                        {
                            if (field.IsSection)
                            {
                                <div class="section-title">@field.FieldName</div>
                            }
                            else
                            {
                                <div class="field-card">
                                    <div class="field-name">@field.FieldName</div>
                                    @if (_isEditing)
                                    {
                                        <MudTextField T="string"
                                                      @bind-Value="field.EditValue"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Lines="3" />
                                    }
                                    else
                                    {
                                        <div class="field-value">@GetDisplayValue(field)</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </MudPaper>
            }
        }
    }
</MudContainer>

@code {
    [Parameter]
    public Guid QualityId { get; set; }

    private QualityReport? _quality;
    private readonly List<QualityReject> _rejects = [];
    private readonly List<FormBlock> _forms = [];
    private string? _templateName;
    private string? _hospitalName;
    private string? _qualityUserName;
    private bool _isLoading = true;
    private bool _isEditing;
    private bool _isPreview;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadQualityAsync();
    }

    private async Task LoadQualityAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _quality = await _registryContext.QualityReports.AsNoTracking().FirstOrDefaultAsync(x => x.Id == QualityId);
            _rejects.Clear();
            _forms.Clear();
            if (_quality == null)
            {
                return;
            }

            _templateName = await _registryContext.FormTemplateMaps.AsNoTracking()
                .Where(x => x.BusinessType == "quality" && x.SourceFollowTemplateId == _quality.TemplateId)
                .OrderBy(x => x.TemplateName)
                .Select(x => x.TemplateName)
                .FirstOrDefaultAsync();
            _hospitalName = Guid.TryParse(_quality.HospitalId, out var hospitalId)
                ? await _registryContext.SystemHospitals.AsNoTracking()
                    .Where(x => x.Id == hospitalId)
                    .Select(x => x.Name)
                    .FirstOrDefaultAsync()
                : _quality.HospitalId;
            _qualityUserName = Guid.TryParse(_quality.QualityUserId, out var userId)
                ? await _registryContext.SystemUsers.AsNoTracking()
                    .Where(x => x.Id == userId)
                    .Select(x => string.IsNullOrWhiteSpace(x.DisplayName) ? x.Account : x.DisplayName)
                    .FirstOrDefaultAsync()
                : _quality.QualityUserId;

            var rejects = await _registryContext.QualityRejects.AsNoTracking()
                .Where(x => x.QualityReportId == QualityId)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();
            _rejects.AddRange(rejects);

            var instances = await _registryContext.FormInstances.AsNoTracking()
                .Where(x => x.OwnerType == "quality" && x.OwnerId == QualityId)
                .OrderBy(x => x.CreatedAt)
                .ToListAsync();
            var instanceIds = instances.Select(x => x.Id).ToList();
            if (instanceIds.Count == 0)
            {
                return;
            }

            var templateIds = instances.Select(x => x.FormTemplateId).Distinct().ToList();
            var templates = await _registryContext.FormTemplates.AsNoTracking()
                .Where(x => templateIds.Contains(x.Id))
                .ToDictionaryAsync(x => x.Id);

            var values = await _registryContext.FormFieldValues.AsNoTracking()
                .Where(x => instanceIds.Contains(x.FormInstanceId))
                .OrderBy(x => x.Sort)
                .ThenBy(x => x.StorageKey)
                .ToListAsync();

            var definitionIds = values
                .Where(x => x.FormFieldDefinitionId.HasValue)
                .Select(x => x.FormFieldDefinitionId!.Value)
                .Distinct()
                .ToList();
            var definitions = definitionIds.Count == 0
                ? new Dictionary<Guid, RegistryFormFieldDefinition>()
                : await _registryContext.FormFieldDefinitions.AsNoTracking()
                    .Where(x => definitionIds.Contains(x.Id))
                    .ToDictionaryAsync(x => x.Id);

            foreach (var instance in instances)
            {
                var fields = values
                    .Where(x => x.FormInstanceId == instance.Id)
                    .Select(value =>
                    {
                        RegistryFormFieldDefinition? definition = null;
                        if (value.FormFieldDefinitionId.HasValue)
                        {
                            definitions.TryGetValue(value.FormFieldDefinitionId.Value, out definition);
                        }

                        return new FieldItem(
                            value.Id,
                            value.FieldName,
                            value.FieldValue,
                            value.FieldText,
                            definition?.Level ?? 2,
                            value.Sort);
                    })
                    .ToList();

                var name = templates.TryGetValue(instance.FormTemplateId, out var template)
                    ? template.FormName
                    : "质控表单";
                _forms.Add(new FormBlock(instance.Id, name, instance.CreatedAt, fields));
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BackToList() => inj_navigationManager.NavigateTo(RouteConstants.QualityList);

    private string GetPageClass() => _isPreview ? "detail-page preview-mode" : "detail-page";

    private void TogglePreview()
    {
        _isPreview = !_isPreview;
        if (_isPreview)
        {
            _isEditing = false;
        }
    }

    private async Task PrintPreviewAsync()
        => await inj_jsRuntime.InvokeVoidAsync("print");

    private void ToggleEdit()
    {
        _isEditing = !_isEditing;
        foreach (var field in _forms.SelectMany(x => x.Fields))
        {
            field.EditValue = string.IsNullOrWhiteSpace(field.FieldText) ? field.FieldValue : field.FieldText;
        }
    }

    private async Task SaveFormsAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.QualityCreate) || !await ConfirmAsync("确认保存当前质控表单修改？"))
        {
            return;
        }

        var fields = _forms.SelectMany(x => x.Fields).ToList();
        var ids = fields.Select(x => x.Id).ToList();
        var values = await _registryContext.FormFieldValues.Where(x => ids.Contains(x.Id)).ToListAsync();
        foreach (var value in values)
        {
            var field = fields.First(x => x.Id == value.Id);
            value.FieldValue = field.EditValue;
            value.FieldText = field.EditValue;
            value.UpdatedAt = DateTime.Now;
            value.UpdatedBy = CurrentUserId;
        }

        _registryContext.OperationLogs.Add(CreateOperationLog("质控", "保存表单", "quality", QualityId));
        await _registryContext.SaveChangesAsync();
        _isEditing = false;
        inj_snackbar.Add("质控表单已保存", Severity.Success);
        await LoadQualityAsync();
    }

    private async Task SubmitQualityAsync()
    {
        if (_registryContext == null || _quality == null || !await RequirePermissionAsync(PermissionConstants.QualityCreate) || !await ConfirmAsync("确认提交当前质控报表？"))
        {
            return;
        }

        if (_quality.Status is not (0 or 2))
        {
            inj_snackbar.Add("当前状态不能提交", Severity.Warning);
            return;
        }

        await _registryContext.QualityReports.Where(x => x.Id == QualityId)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.Status, 1)
                .SetProperty(x => x.QualityUserId, CurrentUserId)
                .SetProperty(x => x.UpdatedAt, DateTime.Now)
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
        _registryContext.OperationLogs.Add(CreateOperationLog("质控", "提交", "quality", QualityId));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("质控已提交", Severity.Success);
        await LoadQualityAsync();
    }

    private async Task RejectQualityAsync()
    {
        if (_registryContext == null || _quality == null)
        {
            return;
        }

        if (!await RequirePermissionAsync(PermissionConstants.QualityManage))
        {
            return;
        }

        var reason = await PromptAsync("请输入质控驳回原因");
        if (string.IsNullOrWhiteSpace(reason) || !await ConfirmAsync("确认驳回当前质控报表？"))
        {
            return;
        }

        if (_quality.Status != 1)
        {
            inj_snackbar.Add("当前状态不能驳回", Severity.Warning);
            return;
        }

        await _registryContext.QualityReports.Where(x => x.Id == QualityId)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.Status, 2)
                .SetProperty(x => x.UpdatedAt, DateTime.Now)
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
        _registryContext.QualityRejects.Add(new QualityReject
        {
            QualityReportId = QualityId,
            Content = reason,
            CreatedAt = DateTime.Now,
            CreatedBy = CurrentUserId
        });
        _registryContext.OperationLogs.Add(CreateOperationLog("质控", "驳回", "quality", QualityId, reason));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("质控已驳回", Severity.Success);
        await LoadQualityAsync();
    }

    private async Task DeleteQualityAsync()
    {
        if (_registryContext == null || _quality == null || !await RequirePermissionAsync(PermissionConstants.QualityManage))
        {
            return;
        }

        if (!await ConfirmAsync("确认删除该质控报表？表单、附件记录和驳回记录都会删除。"))
        {
            return;
        }

        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        var rejectIds = await _registryContext.QualityRejects.AsNoTracking()
            .Where(x => x.QualityReportId == QualityId)
            .Select(x => x.Id)
            .ToListAsync();
        await DeleteFormInstancesAsync("quality", new List<Guid> { QualityId });
        await _registryContext.QualityRejects.Where(x => x.QualityReportId == QualityId).ExecuteDeleteAsync();

        var targetIds = new List<Guid> { QualityId };
        targetIds.AddRange(rejectIds);
        await _registryContext.MigrationMaps.Where(x => targetIds.Contains(x.TargetId)).ExecuteDeleteAsync();
        await _registryContext.QualityReports.Where(x => x.Id == QualityId).ExecuteDeleteAsync();

        _registryContext.OperationLogs.Add(CreateOperationLog("质控", "删除", "quality", QualityId, _quality.Name));
        await _registryContext.SaveChangesAsync();
        await transaction.CommitAsync();

        inj_snackbar.Add("质控报表已删除", Severity.Success);
        inj_navigationManager.NavigateTo(RouteConstants.QualityList);
    }

    private async Task DeleteFormInstancesAsync(string ownerType, List<Guid> ownerIds)
    {
        if (_registryContext == null || ownerIds.Count == 0)
        {
            return;
        }

        var instanceIds = await _registryContext.FormInstances.AsNoTracking()
            .Where(x => x.OwnerType == ownerType && ownerIds.Contains(x.OwnerId))
            .Select(x => x.Id)
            .ToListAsync();
        if (instanceIds.Count == 0)
        {
            return;
        }

        var valueIds = await _registryContext.FormFieldValues.AsNoTracking()
            .Where(x => instanceIds.Contains(x.FormInstanceId))
            .Select(x => x.Id)
            .ToListAsync();
        if (valueIds.Count > 0)
        {
            await _registryContext.Files.Where(x => x.OwnerType == "form_field_value" && valueIds.Contains(x.OwnerId)).ExecuteDeleteAsync();
            await _registryContext.FormFieldValues.Where(x => valueIds.Contains(x.Id)).ExecuteDeleteAsync();
        }

        await _registryContext.FormInstances.Where(x => instanceIds.Contains(x.Id)).ExecuteDeleteAsync();
    }

    private IEnumerable<SummaryItem> BuildSummaryItems()
    {
        if (_quality == null)
        {
            yield break;
        }

        yield return new("质控月份", FormatDate(_quality.QualityDate));
        yield return new("疾病类型", _templateName ?? _quality.TemplateId);
        yield return new("医院", _hospitalName ?? _quality.HospitalId);
        yield return new("质控员", _qualityUserName ?? _quality.QualityUserId);
        yield return new("创建时间", FormatDateTime(_quality.CreatedAt));
        yield return new("更新时间", FormatDateTime(_quality.UpdatedAt));
    }

    private static string GetDisplayValue(FieldItem field)
        => ShowValue(FormValueDisplayMapper.GetDisplayText(field.FieldName, field.FieldText, field.FieldValue));

    private static string ShowValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string FormatDateTime(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm") ?? "-";

    private static string GetStatusText(int status)
        => status switch
        {
            0 => "未填报",
            1 => "已上报",
            2 => "已驳回",
            _ => $"状态 {status}"
        };

    private sealed record SummaryItem(string Label, string? Value);

    private sealed record FormBlock(Guid Id, string Name, DateTime CreatedAt, List<FieldItem> Fields)
    {
        public string Anchor => $"quality-form-{Id:N}";
    }

    private sealed class FieldItem(
        Guid id,
        string fieldName,
        string? fieldValue,
        string? fieldText,
        int level,
        int sort)
    {
        public Guid Id { get; } = id;
        public string FieldName { get; } = fieldName;
        public string? FieldValue { get; set; } = fieldValue;
        public string? FieldText { get; set; } = fieldText;
        public string? EditValue { get; set; } = string.IsNullOrWhiteSpace(fieldText) ? fieldValue : fieldText;
        public int Level { get; } = level;
        public int Sort { get; } = sort;
        public bool IsSection => Level <= 1;
    }
}
