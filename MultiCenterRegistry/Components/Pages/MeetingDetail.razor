@page "/meetings/{MeetingId:guid}"
@inherits BasePage

<PageTitle>@(_meeting == null ? "会议详情" : $"{_meeting.Title} - 会议详情")</PageTitle>

<div class="meeting-detail-page">
    @if (_showMeetingEditor)
    {
        <div class="meeting-dialog-mask" role="presentation">
            <section class="meeting-edit-dialog" role="dialog" aria-modal="true" aria-labelledby="meeting-edit-modal-title">
                <MeetingEdit MeetingId="MeetingId" Saved="OnMeetingSavedAsync" Cancelled="CloseMeetingEditor" />
            </section>
        </div>
    }

    @if (_isLoading)
    {
        <MudPaper Class="loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>正在加载会议详情</span>
        </MudPaper>
    }
    else if (_meeting == null)
    {
        <MudPaper Class="loading-panel" Elevation="0">未找到会议</MudPaper>
    }
    else
    {
        var filteredCases = GetFilteredCases();
        var pageCases = GetPagedCases(filteredCases);
        var totalPages = GetTotalPages(filteredCases.Count);
        <section class="meeting-board">
            <header class="meeting-board-header">
                <button type="button" class="meeting-back-button" @onclick="BackToList">
                    <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" />
                    <span>返回</span>
                </button>
                <div class="meeting-title-block">
                    <h1>评审会议</h1>
                    <span>@ShowValue(_meeting.Title)</span>
                </div>
                <span class="status-pill @GetMeetingStatusClass(_meeting.Status)">@GetMeetingStatusText(_meeting.Status)</span>
                @if (HasPermission(PermissionConstants.QualityManage))
                {
                    <div class="meeting-header-actions">
                        <button type="button" class="meeting-text-button" @onclick="EditMeeting">编辑会议</button>
                        @if (_meeting.Status == 0)
                        {
                            <button type="button" class="meeting-text-button primary" @onclick="AddCaseToMeetingAsync">添加病例</button>
                            <button type="button" class="meeting-text-button" @onclick="@(() => ChangeMeetingStatusAsync(1, StartMeetingAction))">开始会议</button>
                        }
                        @if (_meeting.Status == 1)
                        {
                            <button type="button" class="meeting-text-button" @onclick="@(() => ChangeMeetingStatusAsync(2, PublishMeetingAction))">发布会议</button>
                        }
                        @if (_meeting.Status == 2)
                        {
                            <button type="button" class="meeting-text-button" @onclick="@(() => ChangeMeetingStatusAsync(3, FinishMeetingAction))">结束会议</button>
                        }
                        <button type="button" class="meeting-text-button danger" @onclick="DeleteMeetingAsync">删除会议</button>
                    </div>
                }
            </header>

            <section class="meeting-info-grid">
                <div class="meeting-info-column">
                    <div class="meeting-info-row">
                        <span>评审主题：</span>
                        <strong>@ShowValue(_meeting.Title)</strong>
                    </div>
                    <div class="meeting-info-row">
                        <span>评审时间：</span>
                        <strong>@FormatDateTime(_meeting.MeetingTime) - @FormatDateTime(_meeting.EndTime)</strong>
                    </div>
                    <div class="meeting-info-row">
                        <span>评审地点：</span>
                        <strong>@ShowValue(_meeting.Place)</strong>
                    </div>
                </div>
                <div class="meeting-info-column">
                    <div class="meeting-info-row">
                        <span>评审组长：</span>
                        <strong>@ShowValue(LeaderName)</strong>
                    </div>
                    <div class="meeting-info-row">
                        <span>评审组员：</span>
                        <strong>@ShowValue(MemberNames)</strong>
                    </div>
                    <div class="meeting-info-row">
                        <span>本次评审病例数：</span>
                        <strong>@_cases.Count 例</strong>
                    </div>
                </div>
            </section>

            <section class="filter-panel meeting-case-filter">
                <label>
                    <span>所属医院：</span>
                    <select @bind="_filterHospital">
                        <option value="">请选择</option>
                        @foreach (var option in _hospitalFilterOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label>
                    <span>病案号：</span>
                    <input type="text" placeholder="请输入病案号" @bind="_filterPatientNumber" />
                </label>
                <label>
                    <span>患者姓名：</span>
                    <input type="text" placeholder="请输入患者姓名" @bind="_filterPatientName" />
                </label>
                <label class="meeting-date-filter">
                    <span>出院时间：</span>
                    <div class="meeting-date-range">
                        <input type="date" class="@GetDateFilterClass(_filterDischargeStart)" value="@_filterDischargeStart" @onchange="OnDischargeStartChanged" />
                        <em>-</em>
                        <input type="date" class="@GetDateFilterClass(_filterDischargeEnd)" value="@_filterDischargeEnd" @onchange="OnDischargeEndChanged" />
                    </div>
                </label>
                <label>
                    <span>手术类别：</span>
                    <select @bind="_filterSurgeryType">
                        <option value="">请选择</option>
                        @foreach (var option in _surgeryFilterOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <label>
                    <span>术者：</span>
                    <select @bind="_filterOperator">
                        <option value="">请选择</option>
                        @foreach (var option in _operatorFilterOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>
                <div class="meeting-filter-actions">
                    <button type="button" class="meeting-search-button" @onclick="ApplyFilters">查询</button>
                    <button type="button" class="meeting-reset-button" @onclick="ResetFilters">重置</button>
                </div>
            </section>

            <div class="meeting-table-wrap">
                <table class="meeting-case-table">
                    <thead>
                        <tr>
                            <th>序号</th>
                            <th>所属医院 <span>⇅</span></th>
                            <th>状态 <span>⇅</span></th>
                            <th>创建时间 <span>⇅</span></th>
                            <th>病案号 <span>⇅</span></th>
                            <th>患者姓名 <span>⇅</span></th>
                            <th>性别 <span>⇅</span></th>
                            <th>出院时间 <span>⇅</span></th>
                            <th>术者 <span>⇅</span></th>
                            <th>手术类别 <span>⇅</span></th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pageCases.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="meeting-empty-cell">无符合条件数据</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in pageCases)
                            {
                                <tr>
                                    <td>@item.Sort</td>
                                    <td title="@ShowValue(item.HospitalName)">@ShowValue(item.HospitalName)</td>
                                    <td><span class="@GetMeetingCaseStatusClass(item.SubStatus)">@GetSubStatusText(item.SubStatus)</span></td>
                                    <td>@FormatDate(item.CreatedAt)</td>
                                    <td title="@ShowValue(item.PatientNumber)">@ShowValue(item.PatientNumber)</td>
                                    <td title="@ShowValue(item.PatientName)">@ShowValue(item.PatientName)</td>
                                    <td>@ShowSex(item.PatientSex)</td>
                                    <td>@FormatDate(item.DischargeTime)</td>
                                    <td title="@ShowValue(item.OperatorName)">@ShowValue(item.OperatorName)</td>
                                    <td title="@ShowValue(item.SurgeryTypeName)">@ShowValue(item.SurgeryTypeName)</td>
                                    <td class="meeting-operation-cell">
                                        @if (CanOpenCaseDetail())
                                        {
                                            <button type="button" class="meeting-link-button" @onclick="@(() => OpenCase(item.CaseId))">查看病例</button>
                                        }
                                        @if (CanOpenAppraise(item))
                                        {
                                            <button type="button" class="meeting-link-button" @onclick="@(() => OpenAppraise(item.CaseId))">@GetAppraiseButtonText(item)</button>
                                        }
                                        @if (CanRemoveMeetingCase(item))
                                        {
                                            <button type="button" class="meeting-link-button danger" @onclick="@(() => RemoveCaseAsync(item.CaseId))">删除</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <footer class="pager meeting-detail-pager">
                <div class="pager-total">共 @filteredCases.Count 条</div>
                <div class="pager-pages">
                    <button type="button" class="pager-page wide" disabled="@(_currentPage <= 1)" @onclick="PreviousPage">上一页</button>
                    @foreach (var page in GetPagerItems(totalPages))
                    {
                        if (page < 0)
                        {
                            <span class="pager-ellipsis">...</span>
                        }
                        else
                        {
                            <button type="button" class="@GetPagerClass(page)" @onclick="@(() => GoToPage(page))">@(page)</button>
                        }
                    }
                    <button type="button" class="pager-page wide" disabled="@(_currentPage >= totalPages)" @onclick="@(() => NextPage(totalPages))">下一页</button>
                </div>
                <div class="pager-summary">第 @_currentPage / @totalPages 页 · 每页 @MeetingPageSize 条</div>
            </footer>
        </section>
    }
</div>

@code {
    private const string StartMeetingAction = "开始会议";
    private const string PublishMeetingAction = "发布会议";
    private const string FinishMeetingAction = "结束会议";

    [Parameter]
    public Guid MeetingId { get; set; }

    private ReviewMeeting? _meeting;
    private readonly List<ExpertItem> _experts = [];
    private readonly List<MeetingCaseItem> _cases = [];
    private readonly List<string> _hospitalFilterOptions = [];
    private readonly List<string> _operatorFilterOptions = [];
    private readonly List<string> _surgeryFilterOptions = [];
    private bool _isLoading = true;
    private bool _showMeetingEditor;
    private string _filterHospital = "";
    private string _filterPatientNumber = "";
    private string _filterPatientName = "";
    private string _filterDischargeStart = "";
    private string _filterDischargeEnd = "";
    private string _filterSurgeryType = "";
    private string _filterOperator = "";
    private int _currentPage = 1;
    private const int MeetingPageSize = 10;

    private string? LeaderName => _experts.FirstOrDefault(x => x.Level == 1)?.Name;

    private string MemberNames
        => string.Join("、", _experts.Select(x => x.Name).Where(x => !string.IsNullOrWhiteSpace(x)));

    protected override Task OnPageInitializedAsync() => LoadMeetingAsync();

    private async Task LoadMeetingAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        if (!HasAnyPermission(PermissionConstants.QualityManage, PermissionConstants.AppraiseEdit, PermissionConstants.AppraiseView))
        {
            inj_snackbar.Add("当前账号没有会议查看权限", Severity.Warning);
            return;
        }

        _isLoading = true;
        try
        {
            _meeting = await _registryContext.ReviewMeetings.AsNoTracking().FirstOrDefaultAsync(x => x.Id == MeetingId);
            _experts.Clear();
            _cases.Clear();
            _hospitalFilterOptions.Clear();
            _operatorFilterOptions.Clear();
            _surgeryFilterOptions.Clear();
            if (_meeting == null)
            {
                return;
            }

            var experts = await _registryContext.MeetingExperts.AsNoTracking()
                .Where(x => x.MeetingId == MeetingId)
                .OrderBy(x => x.Level)
                .ThenBy(x => x.ExpertId)
                .ToListAsync();

            var appraises = await _registryContext.CaseAppraises.AsNoTracking()
                .Where(x => x.MeetingId == MeetingId)
                .ToListAsync();
            var caseIds = appraises.Select(x => x.CaseId).Distinct().ToList();
            var cases = caseIds.Count == 0
                ? []
                : await _registryContext.Cases.AsNoTracking()
                    .Where(x => caseIds.Contains(x.Id))
                    .ToListAsync();

            var summaries = caseIds.Count == 0
                ? []
                : await _registryContext.CaseSummaries.AsNoTracking()
                    .Where(x => x.MeetingId == MeetingId && caseIds.Contains(x.CaseId))
                    .ToListAsync();

            var userIds = experts
                .Select(x => TryParseGuid(x.ExpertId))
                .Concat(appraises.Select(x => TryParseGuid(x.ExpertId)))
                .Concat(cases.Select(x => TryParseGuid(x.OperatorId)))
                .Where(x => x.HasValue)
                .Select(x => x!.Value)
                .Distinct()
                .ToList();
            var users = userIds.Count == 0
                ? new Dictionary<Guid, string>()
                : await _registryContext.SystemUsers.AsNoTracking()
                    .Where(x => userIds.Contains(x.Id))
                    .ToDictionaryAsync(x => x.Id, x => string.IsNullOrWhiteSpace(x.DisplayName) ? x.Account : x.DisplayName);

            foreach (var expert in experts)
            {
                _experts.Add(new ExpertItem(GetUserName(expert.ExpertId, users), expert.Level));
            }

            var hospitalIds = cases.Select(x => TryParseGuid(x.HospitalId)).Where(x => x.HasValue).Select(x => x!.Value).Distinct().ToList();
            var departmentIds = cases.Select(x => TryParseGuid(x.DepartmentId)).Where(x => x.HasValue).Select(x => x!.Value).Distinct().ToList();
            var hospitals = hospitalIds.Count == 0
                ? new Dictionary<Guid, string>()
                : await _registryContext.SystemHospitals.AsNoTracking()
                    .Where(x => hospitalIds.Contains(x.Id))
                    .ToDictionaryAsync(x => x.Id, x => x.Name);
            var departments = departmentIds.Count == 0
                ? new Dictionary<Guid, string>()
                : await _registryContext.SystemDepartments.AsNoTracking()
                    .Where(x => departmentIds.Contains(x.Id))
                    .ToDictionaryAsync(x => x.Id, x => string.IsNullOrWhiteSpace(x.DisplayName) ? x.Name : x.DisplayName!);

            foreach (var item in cases.OrderBy(x => x.Sort).ThenBy(x => x.PatientName))
            {
                var caseAppraises = appraises.Where(x => x.CaseId == item.Id).ToList();
                _cases.Add(new MeetingCaseItem(
                    item.Id,
                    item.PatientName,
                    item.PatientSex,
                    item.PatientAge,
                    item.PatientNumber,
                    GetName(item.HospitalId, hospitals, item.HospitalName),
                    GetName(item.DepartmentId, departments),
                    item.CreatedAt,
                    item.AdmissionTime,
                    item.DischargeTime,
                    GetName(item.OperatorId, users, item.OperatorName),
                    GetSurgeryTypeName(item),
                    item.Sort,
                    item.Status,
                    item.SubStatus,
                    caseAppraises.Count,
                    caseAppraises.Count(x => x.Status == 1),
                    summaries.Count(x => x.CaseId == item.Id)));
            }

            BuildFilterOptions();
            _currentPage = 1;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BackToList() => inj_navigationManager.NavigateTo(RouteConstants.MeetingList);

    private void OpenCase(Guid id) => inj_navigationManager.NavigateTo(RouteConstants.CaseDetail(id));

    private void OpenAppraise(Guid caseId) => inj_navigationManager.NavigateTo(RouteConstants.AppraiseDetail(MeetingId, caseId));

    private void BuildFilterOptions()
    {
        _hospitalFilterOptions.AddRange(_cases.Select(x => x.HospitalName).Where(HasText).Select(x => x!).Distinct().OrderBy(x => x));
        _operatorFilterOptions.AddRange(_cases.Select(x => x.OperatorName).Where(HasText).Select(x => x!).Distinct().OrderBy(x => x));
        _surgeryFilterOptions.AddRange(_cases.Select(x => x.SurgeryTypeName).Where(HasText).Select(x => x!).Distinct().OrderBy(x => x));
    }

    private List<MeetingCaseItem> GetFilteredCases()
    {
        var start = ParseDate(_filterDischargeStart);
        var end = ParseDate(_filterDischargeEnd);
        return _cases
            .Where(x => string.IsNullOrWhiteSpace(_filterHospital) || IsSameValue(x.HospitalName, _filterHospital))
            .Where(x => string.IsNullOrWhiteSpace(_filterPatientNumber) || ContainsText(x.PatientNumber, _filterPatientNumber))
            .Where(x => string.IsNullOrWhiteSpace(_filterPatientName) || ContainsText(x.PatientName, _filterPatientName))
            .Where(x => !start.HasValue || (x.DischargeTime.HasValue && x.DischargeTime.Value.Date >= start.Value.Date))
            .Where(x => !end.HasValue || (x.DischargeTime.HasValue && x.DischargeTime.Value.Date <= end.Value.Date))
            .Where(x => string.IsNullOrWhiteSpace(_filterSurgeryType) || IsSameValue(x.SurgeryTypeName, _filterSurgeryType))
            .Where(x => string.IsNullOrWhiteSpace(_filterOperator) || IsSameValue(x.OperatorName, _filterOperator))
            .OrderBy(x => x.Sort)
            .ThenBy(x => x.PatientName)
            .ThenBy(x => x.CaseId)
            .ToList();
    }

    private List<MeetingCaseItem> GetPagedCases(IReadOnlyList<MeetingCaseItem> filteredCases)
        => filteredCases
            .Skip((_currentPage - 1) * MeetingPageSize)
            .Take(MeetingPageSize)
            .ToList();

    private static int GetTotalPages(int totalCount)
        => Math.Max(1, (int)Math.Ceiling(totalCount / (double)MeetingPageSize));

    private void ApplyFilters()
    {
        _currentPage = 1;
    }

    private void ResetFilters()
    {
        _filterHospital = "";
        _filterPatientNumber = "";
        _filterPatientName = "";
        _filterDischargeStart = "";
        _filterDischargeEnd = "";
        _filterSurgeryType = "";
        _filterOperator = "";
        _currentPage = 1;
    }

    private void OnDischargeStartChanged(ChangeEventArgs args)
    {
        _filterDischargeStart = args.Value?.ToString() ?? "";
    }

    private void OnDischargeEndChanged(ChangeEventArgs args)
    {
        _filterDischargeEnd = args.Value?.ToString() ?? "";
    }

    private static string GetDateFilterClass(string value)
        => string.IsNullOrWhiteSpace(value) ? "date-input date-empty" : "date-input";

    private string GetPagerClass(int page)
        => page == _currentPage ? "pager-page active" : "pager-page";

    private IEnumerable<int> GetPagerItems(int totalPages)
    {
        if (totalPages <= 7)
        {
            for (var page = 1; page <= totalPages; page++)
            {
                yield return page;
            }

            yield break;
        }

        yield return 1;
        var start = Math.Max(2, _currentPage - 2);
        var end = Math.Min(totalPages - 1, _currentPage + 2);
        if (start > 2)
        {
            yield return -1;
        }

        for (var page = start; page <= end; page++)
        {
            yield return page;
        }

        if (end < totalPages - 1)
        {
            yield return -1;
        }

        yield return totalPages;
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
        }
    }

    private void NextPage(int totalPages)
    {
        if (_currentPage < totalPages)
        {
            _currentPage++;
        }
    }

    private void GoToPage(int page)
    {
        var totalPages = GetTotalPages(GetFilteredCases().Count);
        _currentPage = Math.Clamp(page, 1, totalPages);
    }

    private void OnPageInputChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var page))
        {
            GoToPage(page);
        }
    }

    private bool CanOpenCaseDetail()
        => !HasPermission(PermissionConstants.AppraiseEdit);

    private bool CanOpenAppraise(MeetingCaseItem item)
        => (HasPermission(PermissionConstants.AppraiseEdit) && item.SubStatus != 2)
           || (HasAnyPermission(PermissionConstants.AppraiseView, PermissionConstants.QualityManage) && item.SubStatus == 2);

    private string GetAppraiseButtonText(MeetingCaseItem item)
        => HasPermission(PermissionConstants.AppraiseEdit) && item.SubStatus != 2 ? "评审" : "查看评价";

    private bool CanRemoveMeetingCase(MeetingCaseItem item)
        => _meeting?.Status == 0
           && HasPermission(PermissionConstants.QualityManage)
           && !HasPermission(PermissionConstants.AppraiseEdit);

    private void EditMeeting() => _showMeetingEditor = true;

    private void CloseMeetingEditor() => _showMeetingEditor = false;

    private async Task OnMeetingSavedAsync(Guid meetingId)
    {
        _showMeetingEditor = false;
        await LoadMeetingAsync();
    }

    private async Task AddCaseToMeetingAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.QualityManage))
        {
            return;
        }

        if (_meeting?.Status != 0)
        {
            inj_snackbar.Add("只有未开始的会议可以添加病例", Severity.Warning);
            return;
        }

        var keywordText = await PromptAsync("请输入病例 ID、病案号或患者姓名，多个用逗号分隔");
        if (string.IsNullOrWhiteSpace(keywordText) || !await ConfirmAsync("确认将匹配到的病例加入会议？"))
        {
            return;
        }

        var tokens = keywordText.Split([',', '，', ';', '；', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var cases = new List<RegistryCase>();
        foreach (var token in tokens)
        {
            RegistryCase? item = null;
            if (Guid.TryParse(token, out var caseId))
            {
                item = await _registryContext.Cases.FirstOrDefaultAsync(x => x.Id == caseId);
            }

            item ??= await _registryContext.Cases.FirstOrDefaultAsync(x => x.PatientNumber == token || x.PatientName == token);
            if (item != null && cases.All(x => x.Id != item.Id))
            {
                cases.Add(item);
            }
        }

        if (cases.Count == 0)
        {
            inj_snackbar.Add("没有匹配到病例", Severity.Warning);
            return;
        }

        var experts = await _registryContext.MeetingExperts.AsNoTracking().Where(x => x.MeetingId == MeetingId).ToListAsync();
        if (experts.Count == 0)
        {
            inj_snackbar.Add("该会议还没有配置专家", Severity.Warning);
            return;
        }

        var submittedCases = cases.Where(x => x.Status == 2).ToList();
        if (submittedCases.Count == 0)
        {
            inj_snackbar.Add("匹配到的病例不是已上报状态，不能加入会议", Severity.Warning);
            return;
        }

        var caseIds = submittedCases.Select(x => x.Id).ToList();
        var existingCaseIds = await _registryContext.CaseAppraises.AsNoTracking()
            .Where(x => x.MeetingId == MeetingId && caseIds.Contains(x.CaseId))
            .Select(x => x.CaseId)
            .Distinct()
            .ToListAsync();
        var targetCases = submittedCases.Where(x => !existingCaseIds.Contains(x.Id)).ToList();
        if (targetCases.Count == 0)
        {
            inj_snackbar.Add("匹配到的病例已在会议中", Severity.Warning);
            return;
        }

        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        var now = DateTime.Now;
        foreach (var item in targetCases)
        {
            foreach (var expert in experts)
            {
                var appraise = new CaseAppraise
                {
                    MeetingId = MeetingId,
                    CaseId = item.Id,
                    ExpertId = expert.ExpertId,
                    Status = 0,
                    CreatedAt = now
                };
                _registryContext.CaseAppraises.Add(appraise);
            }

            _registryContext.CaseSummaries.Add(new CaseSummary
            {
                MeetingId = MeetingId,
                CaseId = item.Id,
                Content = "",
                Status = 0,
                CreatedAt = now,
                CreatedBy = experts.FirstOrDefault(x => x.Level == 1)?.ExpertId
            });

            item.SubStatus = 1;
            item.UpdatedAt = ToDbTimestamp(now);
            item.UpdatedBy = CurrentUserId;
        }

        _registryContext.OperationLogs.Add(CreateOperationLog("会议", "添加病例", "meeting", MeetingId, string.Join(",", targetCases.Select(x => x.Id))));
        await _registryContext.SaveChangesAsync();
        await transaction.CommitAsync();

        inj_snackbar.Add($"已添加 {targetCases.Count} 个病例", Severity.Success);
        await LoadMeetingAsync();
    }

    private async Task ChangeMeetingStatusAsync(int nextStatus, string action)
    {
        if (_registryContext == null || _meeting == null || !await RequirePermissionAsync(PermissionConstants.QualityManage))
        {
            return;
        }

        if (!await ConfirmAsync($"确认{action}？"))
        {
            return;
        }

        var currentStatus = _meeting.Status;
        var now = DateTime.Now;
        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        var updated = await _registryContext.ReviewMeetings
            .Where(x => x.Id == MeetingId && x.Status == currentStatus)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.Status, nextStatus)
                .SetProperty(x => x.UpdatedAt, now)
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
        if (updated == 0)
        {
            inj_snackbar.Add("会议状态已变化，请刷新后重试", Severity.Warning);
            await LoadMeetingAsync();
            return;
        }

        if (nextStatus == 3)
        {
            var caseIds = await _registryContext.CaseAppraises.AsNoTracking()
                .Where(x => x.MeetingId == MeetingId)
                .Select(x => x.CaseId)
                .Distinct()
                .ToListAsync();
            await ResetMeetingCasesAsync(MeetingId, caseIds, true, now);
        }

        _registryContext.OperationLogs.Add(CreateOperationLog("会议", action, "meeting", MeetingId, $"{currentStatus}->{nextStatus}"));
        await _registryContext.SaveChangesAsync();
        await transaction.CommitAsync();
        inj_snackbar.Add($"{action}成功", Severity.Success);
        await LoadMeetingAsync();
    }

    private async Task MoveCaseAsync(Guid caseId, int offset)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.QualityManage))
        {
            return;
        }

        var ordered = _cases.OrderBy(x => x.Sort).ThenBy(x => x.PatientName).ThenBy(x => x.CaseId).ToList();
        var index = ordered.FindIndex(x => x.CaseId == caseId);
        var targetIndex = index + offset;
        if (index < 0 || targetIndex < 0 || targetIndex >= ordered.Count)
        {
            return;
        }

        var caseIds = ordered.Select(x => x.CaseId).ToList();
        var caseRows = await _registryContext.Cases.Where(x => caseIds.Contains(x.Id)).ToListAsync();
        var rowById = caseRows.ToDictionary(x => x.Id);
        var now = DateTime.Now;
        for (var i = 0; i < ordered.Count; i++)
        {
            if (rowById.TryGetValue(ordered[i].CaseId, out var row))
            {
                row.Sort = (i + 1) * 10;
                row.UpdatedAt = now;
                row.UpdatedBy = CurrentUserId;
            }
        }

        if (!rowById.TryGetValue(ordered[index].CaseId, out var current) || !rowById.TryGetValue(ordered[targetIndex].CaseId, out var target))
        {
            return;
        }

        (current.Sort, target.Sort) = (target.Sort, current.Sort);
        _registryContext.OperationLogs.Add(CreateOperationLog("会议", "调整病例排序", "meeting", MeetingId, caseId.ToString()));
        await _registryContext.SaveChangesAsync();
        await LoadMeetingAsync();
    }

    private async Task RemoveCaseAsync(Guid caseId)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.QualityManage) || !await ConfirmAsync("确认从该会议移除病例？相关评审和汇总也会删除。"))
        {
            return;
        }

        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        await ResetMeetingCasesAsync(MeetingId, new[] { caseId }, false, DateTime.Now);
        _registryContext.OperationLogs.Add(CreateOperationLog("会议", "移除病例", "meeting", MeetingId, caseId.ToString()));
        await _registryContext.SaveChangesAsync();
        await transaction.CommitAsync();

        inj_snackbar.Add("病例已移除", Severity.Success);
        await LoadMeetingAsync();
    }

    private async Task DeleteMeetingAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.QualityManage) || !await ConfirmAsync("确认删除该会议？会议专家、评审和汇总都会删除。"))
        {
            return;
        }

        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        var caseIds = await _registryContext.CaseAppraises.AsNoTracking()
            .Where(x => x.MeetingId == MeetingId)
            .Select(x => x.CaseId)
            .Distinct()
            .ToListAsync();
        await ResetMeetingCasesAsync(MeetingId, caseIds, true, DateTime.Now);
        await _registryContext.CaseVotes.Where(x => x.MeetingId == MeetingId).ExecuteDeleteAsync();
        await _registryContext.CaseSummaries.Where(x => x.MeetingId == MeetingId).ExecuteDeleteAsync();
        await _registryContext.CaseAppraises.Where(x => x.MeetingId == MeetingId).ExecuteDeleteAsync();
        await _registryContext.MeetingExperts.Where(x => x.MeetingId == MeetingId).ExecuteDeleteAsync();
        await _registryContext.ReviewMeetings.Where(x => x.Id == MeetingId).ExecuteDeleteAsync();
        _registryContext.OperationLogs.Add(CreateOperationLog("会议", "删除", "meeting", MeetingId));
        await _registryContext.SaveChangesAsync();
        await transaction.CommitAsync();

        inj_snackbar.Add("会议已删除", Severity.Success);
        inj_navigationManager.NavigateTo(RouteConstants.MeetingList);
    }

    private async Task ResetMeetingCasesAsync(Guid meetingId, IReadOnlyCollection<Guid> caseIds, bool onlyIncomplete, DateTime now)
    {
        if (_registryContext == null || caseIds.Count == 0)
        {
            return;
        }

        IQueryable<RegistryCase> caseQuery = _registryContext.Cases.Where(x => caseIds.Contains(x.Id));
        if (onlyIncomplete)
        {
            caseQuery = caseQuery.Where(x => x.Status == 2 && x.SubStatus != 2);
        }

        var resetCaseIds = await caseQuery.Select(x => x.Id).ToListAsync();
        if (resetCaseIds.Count == 0)
        {
            return;
        }

        await _registryContext.CaseVotes.Where(x => x.MeetingId == meetingId && resetCaseIds.Contains(x.CaseId)).ExecuteDeleteAsync();
        await _registryContext.CaseSummaries.Where(x => x.MeetingId == meetingId && resetCaseIds.Contains(x.CaseId)).ExecuteDeleteAsync();
        await _registryContext.CaseAppraises.Where(x => x.MeetingId == meetingId && resetCaseIds.Contains(x.CaseId)).ExecuteDeleteAsync();
        await _registryContext.Cases
            .Where(x => resetCaseIds.Contains(x.Id))
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.SubStatus, 0)
                .SetProperty(x => x.Sort, 0)
                .SetProperty(x => x.UpdatedAt, ToDbTimestamp(now))
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
    }

    private IEnumerable<SummaryItem> BuildSummaryItems()
    {
        if (_meeting == null)
        {
            yield break;
        }

        var leader = _experts.FirstOrDefault(x => x.Level == 1)?.Name;
        yield return new("会议时间", $"{FormatDateTime(_meeting.MeetingTime)} - {FormatDateTime(_meeting.EndTime)}");
        yield return new("地点", _meeting.Place);
        yield return new("分组", _meeting.GroupInfo);
        yield return new("组长", leader);
        yield return new("专家数", _experts.Count.ToString(CultureInfo.InvariantCulture));
        yield return new("病例数", _cases.Count.ToString(CultureInfo.InvariantCulture));
    }

    private bool IsFirstCase(Guid caseId)
        => _cases.OrderBy(x => x.Sort).ThenBy(x => x.PatientName).ThenBy(x => x.CaseId).FirstOrDefault()?.CaseId == caseId;

    private bool IsLastCase(Guid caseId)
        => _cases.OrderByDescending(x => x.Sort).ThenByDescending(x => x.PatientName).ThenByDescending(x => x.CaseId).FirstOrDefault()?.CaseId == caseId;

    private static Guid? TryParseGuid(string? value) => Guid.TryParse(value, out var id) ? id : null;

    private static DateTime ToDbTimestamp(DateTime value)
        => DateTime.SpecifyKind(value, DateTimeKind.Unspecified);

    private static string GetUserName(string? id, IReadOnlyDictionary<Guid, string> users)
    {
        var userId = TryParseGuid(id);
        return userId.HasValue && users.TryGetValue(userId.Value, out var name) ? name : ShowValue(id);
    }

    private static string GetName(string? id, IReadOnlyDictionary<Guid, string> names)
    {
        var guid = TryParseGuid(id);
        return guid.HasValue && names.TryGetValue(guid.Value, out var name) ? name : ShowValue(id);
    }

    private static string GetName(string? id, IReadOnlyDictionary<Guid, string> names, string? fallback)
    {
        var guid = TryParseGuid(id);
        if (guid.HasValue && names.TryGetValue(guid.Value, out var name))
        {
            return name;
        }

        return ShowValue(fallback ?? id);
    }

    private static string GetSurgeryTypeName(RegistryCase item)
        => ShowValue(item.SurgeryTypeText ?? item.DiseaseName ?? RegistryFixedCatalog.GetDiseaseName(item.DiseaseId ?? item.SurgeryTypeValue));

    private static bool HasText(string? value) => !string.IsNullOrWhiteSpace(value) && value != "-";

    private static bool ContainsText(string? value, string keyword)
        => !string.IsNullOrWhiteSpace(value)
           && value.Contains(keyword.Trim(), StringComparison.OrdinalIgnoreCase);

    private static bool IsSameValue(string? left, string? right)
        => string.Equals(left?.Trim(), right?.Trim(), StringComparison.OrdinalIgnoreCase);

    private static DateTime? ParseDate(string? value)
        => DateTime.TryParse(value, out var date) ? date.Date : null;

    private static string ShowSex(string? value)
        => ShowValue(RegistryFixedCatalog.GetSexName(value));

    private static string ShowValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string FormatDateTime(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm") ?? "-";

    private static string GetMeetingStatusText(int status)
        => status switch
        {
            0 => "未开始",
            1 => "已开始",
            2 => "已发布",
            3 => "已结束",
            _ => $"状态 {status}"
        };

    private static string GetCaseStatusText(int status)
        => status switch
        {
            0 => "待审核",
            1 => "已回退",
            2 => "已上报",
            3 => "待填写",
            4 => "审核失败",
            _ => $"状态 {status}"
        };

    private static string GetSubStatusText(int status)
        => status switch
        {
            0 => "待分配",
            1 => "待评审",
            2 => "评审完成",
            _ => $"子状态 {status}"
        };

    private static string GetMeetingStatusClass(int status)
        => status switch
        {
            0 => "pending",
            1 => "running",
            2 => "published",
            3 => "finished",
            _ => "pending"
        };

    private static string GetMeetingCaseStatusClass(int status)
        => status switch
        {
            0 => "meeting-case-status pending",
            1 => "meeting-case-status reviewing",
            2 => "meeting-case-status finished",
            _ => "meeting-case-status pending"
        };

