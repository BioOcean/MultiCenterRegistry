@page "/meetings/new"
@page "/meetings/{MeetingId:guid}/edit"
@inherits BasePage

<PageTitle>@(IsNew ? "新建会议" : "编辑会议")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="@PageClass">
    @if (IsModal)
    {
        <div class="panel-title">
            <span id="@(IsNew ? "meeting-create-modal-title" : "meeting-edit-modal-title")">@(IsNew ? "新建会议" : "编辑会议")</span>
            <button type="button" class="modal-close" title="关闭" @onclick="Back">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
            </button>
        </div>
    }
    else
    {
        <div class="detail-header">
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="Back">返回</MudButton>
            <div>
                <h1>@(IsNew ? "新建会议" : "编辑会议")</h1>
                <div class="page-subtitle">保存后会同步会议专家配置</div>
            </div>
        </div>
    }

    @if (_isLoading)
    {
        <MudPaper Class="loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>正在加载会议</span>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="form-panel" Elevation="0">
            <MudTextField T="string" @bind-Value="_title" Label="会议主题" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_meetingTime" Label="开始时间" Placeholder="yyyy-MM-dd HH:mm" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_endTime" Label="结束时间" Placeholder="yyyy-MM-dd HH:mm" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_place" Label="会议地点" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudTextField T="string" @bind-Value="_groupInfo" Label="分组" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudSelect T="int" @bind-Value="_status" Label="状态" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int" Value="0">未开始</MudSelectItem>
                <MudSelectItem T="int" Value="1">已开始</MudSelectItem>
                <MudSelectItem T="int" Value="2">已发布</MudSelectItem>
                <MudSelectItem T="int" Value="3">已结束</MudSelectItem>
            </MudSelect>
            <MudSelect T="string"
                       MultiSelection="true"
                       SelectedValues="_selectedExpertIds"
                       SelectedValuesChanged="OnExpertIdsChanged"
                       ToStringFunc="GetExpertText"
                       Label="评审专家"
                       Placeholder="请选择专家"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                @foreach (var expert in _expertOptions)
                {
                    <MudSelectItem T="string" Value="@expert.Id">@expert.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_leaderId" Label="评审组长" Placeholder="请选择组长" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(!_selectedExpertIds.Any())">
                @foreach (var expert in SelectedExpertOptions)
                {
                    <MudSelectItem T="string" Value="@expert.Id">@expert.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" @bind-Value="_description" Label="说明" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" />

            <div class="actions editor-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">保存</MudButton>
            </div>
        </MudPaper>
    }
</MudContainer>

@code {
    [Parameter]
    public Guid? MeetingId { get; set; }

    [Parameter]
    public bool IsModal { get; set; }

    [Parameter]
    public EventCallback<Guid> Saved { get; set; }

    [Parameter]
    public EventCallback Cancelled { get; set; }

    private readonly List<ExpertOption> _expertOptions = [];
    private string _title = "";
    private string _meetingTime = "";
    private string _endTime = "";
    private string _place = "";
    private string _groupInfo = "";
    private string _description = "";
    private string _leaderId = "";
    private IEnumerable<string> _selectedExpertIds = [];
    private int _status;
    private bool _isLoading = true;

    private bool IsNew => !MeetingId.HasValue || MeetingId.Value == Guid.Empty;

    private string PageClass => IsModal ? "edit-page modal-edit-content" : "edit-page";

    private List<ExpertOption> SelectedExpertOptions
        => _selectedExpertIds
            .Select(id => _expertOptions.FirstOrDefault(x => IsSameValue(x.Id, id)) ?? new ExpertOption(id, id))
            .OrderBy(x => x.Name)
            .ToList();

    protected override Task OnPageInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            await LoadExpertOptionsAsync();

            if (IsNew)
            {
                _meetingTime = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
                return;
            }

            var meeting = await _registryContext.ReviewMeetings.AsNoTracking().FirstOrDefaultAsync(x => x.Id == MeetingId);
            if (meeting == null)
            {
                return;
            }

            _title = meeting.Title;
            _meetingTime = meeting.MeetingTime.ToString("yyyy-MM-dd HH:mm");
            _endTime = meeting.EndTime?.ToString("yyyy-MM-dd HH:mm") ?? "";
            _place = meeting.Place ?? "";
            _groupInfo = meeting.GroupInfo ?? "";
            _description = meeting.Description ?? "";
            _status = meeting.Status;

            var experts = await _registryContext.MeetingExperts.AsNoTracking()
                .Where(x => x.MeetingId == meeting.Id)
                .OrderBy(x => x.Level)
                .ThenBy(x => x.ExpertId)
                .ToListAsync();
            _leaderId = experts.FirstOrDefault(x => x.Level == 1)?.ExpertId ?? "";
            _selectedExpertIds = experts.Select(x => x.ExpertId).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            await EnsureSelectedExpertsInOptionsAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.QualityManage))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_title) || !DateTime.TryParse(_meetingTime, out var meetingTime))
        {
            inj_snackbar.Add("请填写会议主题和正确的开始时间", Severity.Warning);
            return;
        }

        DateTime? endTime = null;
        if (!string.IsNullOrWhiteSpace(_endTime))
        {
            if (!DateTime.TryParse(_endTime, out var parsedEndTime))
            {
                inj_snackbar.Add("结束时间格式不正确", Severity.Warning);
                return;
            }

            endTime = parsedEndTime;
        }

        var expertIds = GetSelectedIds(_selectedExpertIds);
        var leaderId = _leaderId.Trim();
        if (expertIds.Count == 0 || string.IsNullOrWhiteSpace(leaderId) || !expertIds.Contains(leaderId, StringComparer.OrdinalIgnoreCase))
        {
            inj_snackbar.Add("请选择评审专家和评审组长", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认保存会议信息？"))
        {
            return;
        }

        var meetingId = IsNew ? Guid.NewGuid() : MeetingId!.Value;
        var now = DateTime.Now;
        var meeting = IsNew
            ? new ReviewMeeting
            {
                Id = meetingId,
                OldMeetingId = meetingId.ToString(),
                CreatedAt = now,
                CreatedBy = CurrentUserId
            }
            : await _registryContext.ReviewMeetings.FirstAsync(x => x.Id == meetingId);

        meeting.Title = _title.Trim();
        meeting.MeetingTime = meetingTime;
        meeting.EndTime = endTime;
        meeting.Place = string.IsNullOrWhiteSpace(_place) ? null : _place.Trim();
        meeting.GroupInfo = string.IsNullOrWhiteSpace(_groupInfo) ? null : _groupInfo.Trim();
        meeting.Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
        meeting.Status = _status;
        meeting.UpdatedAt = now;
        meeting.UpdatedBy = CurrentUserId;

        if (IsNew)
        {
            _registryContext.ReviewMeetings.Add(meeting);
        }

        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        var currentExperts = await _registryContext.MeetingExperts.Where(x => x.MeetingId == meetingId).ToListAsync();
        var currentExpertIds = currentExperts.Select(x => x.ExpertId).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var removedExpertIds = currentExpertIds.Except(expertIds, StringComparer.OrdinalIgnoreCase).ToList();
        var addedExpertIds = expertIds.Except(currentExpertIds, StringComparer.OrdinalIgnoreCase).ToList();

        _registryContext.MeetingExperts.RemoveRange(currentExperts);
        foreach (var expertId in expertIds)
        {
            _registryContext.MeetingExperts.Add(new MeetingExpert
            {
                MeetingId = meetingId,
                ExpertId = expertId,
                Level = expertId.Equals(leaderId, StringComparison.OrdinalIgnoreCase) ? 1 : 2
            });
        }

        if (!IsNew)
        {
            await SyncAppraisesForExpertChangesAsync(meetingId, addedExpertIds, removedExpertIds, now);
        }

        _registryContext.OperationLogs.Add(CreateOperationLog("会议", IsNew ? "新建" : "编辑", "meeting", meetingId));
        await _registryContext.SaveChangesAsync();
        await transaction.CommitAsync();

        inj_snackbar.Add("会议已保存", Severity.Success);
        if (IsModal)
        {
            await Saved.InvokeAsync(meetingId);
            return;
        }

        inj_navigationManager.NavigateTo(RouteConstants.MeetingDetail(meetingId));
    }

    private async Task Back()
    {
        if (IsModal)
        {
            await Cancelled.InvokeAsync();
            return;
        }

        if (IsNew)
        {
            inj_navigationManager.NavigateTo(RouteConstants.MeetingList);
            return;
        }

        inj_navigationManager.NavigateTo(RouteConstants.MeetingDetail(MeetingId!.Value));
    }

    private async Task LoadExpertOptionsAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        string[] expertPermissionCodes = [PermissionConstants.AppraiseEdit, PermissionConstants.AppraiseView];
        var rows = await (
            from user in _registryContext.SystemUsers.AsNoTracking()
            join userRole in _registryContext.SystemMapUserRoles.AsNoTracking() on user.Id equals userRole.UserId
            join rolePermission in _registryContext.SystemMapRolePermissions.AsNoTracking() on userRole.RoleId equals rolePermission.RoleId
            join permission in _registryContext.SystemPermissions.AsNoTracking() on rolePermission.PermissionId equals permission.Id
            where user.IsValid && permission.Code != null && expertPermissionCodes.Contains(permission.Code)
            select new { user.Id, user.DisplayName, user.Account })
            .ToListAsync();

        _expertOptions.Clear();
        _expertOptions.AddRange(rows
            .GroupBy(x => x.Id)
            .Select(x => x.First())
            .OrderBy(x => x.DisplayName)
            .ThenBy(x => x.Account)
            .Select(x => new ExpertOption(x.Id.ToString(), x.DisplayName == "" ? x.Account : x.DisplayName)));
    }

    private async Task EnsureSelectedExpertsInOptionsAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        var missingIds = GetSelectedIds(_selectedExpertIds)
            .Where(id => !_expertOptions.Any(x => IsSameValue(x.Id, id)))
            .Select(TryParseGuid)
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .ToList();
        if (missingIds.Count == 0)
        {
            return;
        }

        _expertOptions.AddRange(await _registryContext.SystemUsers.AsNoTracking()
            .Where(x => missingIds.Contains(x.Id))
            .OrderBy(x => x.DisplayName)
            .ThenBy(x => x.Account)
            .Select(x => new ExpertOption(x.Id.ToString(), x.DisplayName == "" ? x.Account : x.DisplayName))
            .ToListAsync());
    }

    private void OnExpertIdsChanged(IEnumerable<string> values)
    {
        var selected = GetSelectedIds(values);
        _selectedExpertIds = selected;
        if (!selected.Contains(_leaderId, StringComparer.OrdinalIgnoreCase))
        {
            _leaderId = selected.FirstOrDefault() ?? "";
        }
    }

    private string GetExpertText(string value)
        => _expertOptions.FirstOrDefault(x => IsSameValue(x.Id, value))?.Name ?? value;

    private static List<string> GetSelectedIds(IEnumerable<string>? values)
        => values?
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];

    private static Guid? TryParseGuid(string? value)
        => Guid.TryParse(value, out var guid) ? guid : null;

    private static bool IsSameValue(string? left, string? right)
        => string.Equals(left?.Trim(), right?.Trim(), StringComparison.OrdinalIgnoreCase);

    private async Task SyncAppraisesForExpertChangesAsync(
        Guid meetingId,
        List<string> addedExpertIds,
        List<string> removedExpertIds,
        DateTime now)
    {
        if (_registryContext == null)
        {
            return;
        }

        if (removedExpertIds.Count > 0)
        {
            await _registryContext.CaseVotes.Where(x => x.MeetingId == meetingId && x.CreatedBy != null && removedExpertIds.Contains(x.CreatedBy)).ExecuteDeleteAsync();
            await _registryContext.CaseAppraises.Where(x => x.MeetingId == meetingId && removedExpertIds.Contains(x.ExpertId)).ExecuteDeleteAsync();
        }

        if (addedExpertIds.Count == 0)
        {
            return;
        }

        var existingAppraises = await _registryContext.CaseAppraises.AsNoTracking()
            .Where(x => x.MeetingId == meetingId)
            .Select(x => new { x.CaseId, x.ExpertId })
            .ToListAsync();
        var caseIds = existingAppraises.Select(x => x.CaseId).Distinct().ToList();
        if (caseIds.Count == 0)
        {
            return;
        }

        foreach (var expertId in addedExpertIds)
        {
            foreach (var caseId in caseIds)
            {
                if (existingAppraises.Any(x => x.CaseId == caseId && x.ExpertId.Equals(expertId, StringComparison.OrdinalIgnoreCase)))
                {
                    continue;
                }

                var appraise = new CaseAppraise
                {
                    MeetingId = meetingId,
                    CaseId = caseId,
                    ExpertId = expertId,
                    Status = 0,
                    CreatedAt = now
                };
                _registryContext.CaseAppraises.Add(appraise);
            }
        }
    }

    private sealed record ExpertOption(string Id, string Name);
}
