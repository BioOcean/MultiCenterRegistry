@inherits BasePage

<PageTitle>新建病例</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="@PageClass">
    <div class="case-dialog-head">
        <div class="case-dialog-title">
            <span class="case-dialog-icon">
                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" />
            </span>
            <span id="case-create-modal-title">新建病例</span>
        </div>
        <MudIconButton Class="case-dialog-close" Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" title="关闭" OnClick="Back" />
    </div>

    @if (_isLoading)
    {
        <div class="@BodyClass">
            <MudPaper Class="loading-panel" Elevation="0">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <span>正在加载基础数据</span>
            </MudPaper>
        </div>
    }
    else
    {
        <div class="@BodyClass">
            <div class="case-create-form">
                <section class="case-create-section">
                    <div class="case-create-grid">
                        <div class="case-create-field case-create-span-2">
                            <div class="case-create-label"><span class="case-required">*</span>医院</div>
                            <MudSelect T="string" @bind-Value="_hospitalId" Placeholder="请选择医院" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var hospital in _hospitals)
                                {
                                    <MudSelectItem T="string" Value="@hospital.Id.ToString()">@hospital.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </div>
                </section>

                @if (HasSelectedHospital)
                {
                    <section class="case-create-section">
                        <div class="case-create-grid">
                            <div class="case-create-field">
                                <div class="case-create-label"><span class="case-required">*</span>病案号</div>
                                <MudTextField T="string" @bind-Value="_patientNumber" Placeholder="请输入病案号" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>

                            <div class="case-create-field">
                                <div class="case-create-label">患者姓名</div>
                                <MudTextField T="string" @bind-Value="_patientName" Placeholder="请输入患者姓名" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>

                            <div class="case-create-field">
                                <div class="case-create-label">性别</div>
                                <div class="case-choice-group">
                                    @foreach (var option in _sexOptions)
                                    {
                                        <button type="button" class="@GetChoiceClass(_patientSex, option.Value)" @onclick="@(() => SetPatientSex(option.Value))">@option.Text</button>
                                    }
                                </div>
                            </div>

                            <div class="case-create-field">
                                <div class="case-create-label">年龄</div>
                                <MudTextField T="string" @bind-Value="_patientAge" Placeholder="请输入年龄" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>

                            <div class="case-create-field">
                                <div class="case-create-label">入院时间</div>
                                <MudDatePicker @bind-Date="_admissionTime" Placeholder="请选择入院时间" DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>

                            <div class="case-create-field">
                                <div class="case-create-label"><span class="case-required">*</span>出院时间</div>
                                <MudDatePicker @bind-Date="_dischargeTime" Placeholder="请选择出院时间" DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>

                            <div class="case-create-field case-create-span-2">
                                <div class="case-create-label"><span class="case-required">*</span>手术类别</div>
                                <div class="case-choice-group">
                                    @foreach (var option in SurgeryOptions)
                                    {
                                        <button type="button" class="@GetChoiceClass(_diseaseId, option.Value)" @onclick="@(() => SetDisease(option.Value))">@option.Text</button>
                                    }
                                </div>
                            </div>

                            <div class="case-create-field">
                                <div class="case-create-label">离院方式</div>
                                <MudSelect T="string" @bind-Value="_dischargeMode" Placeholder="请选择离院方式" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var option in _dischargeOptions)
                                    {
                                        <MudSelectItem T="string" Value="@option.Value">@option.Text</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            <div class="case-create-field">
                                <div class="case-create-label">情况/原因说明</div>
                                <MudSelect T="string" @bind-Value="_reason" Placeholder="请选择情况/原因说明" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var option in _reasonOptions)
                                    {
                                        <MudSelectItem T="string" Value="@option.Value">@option.Text</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>

                            @if (ShouldShowReasonSupplement)
                            {
                                <div class="case-create-field case-create-span-2 case-create-textarea-field">
                                    <div class="case-create-label">补充说明</div>
                                    <MudTextField T="string"
                                                  @bind-Value="_reasonSupplement"
                                                  Placeholder="请输入补充说明"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Lines="4" />
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>

        <div class="@ActionsClass">
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="Back">取消</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!CanCreate)" OnClick="SaveAsync">创建</MudButton>
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public EventCallback<Guid> Saved { get; set; }

    [Parameter]
    public EventCallback Cancelled { get; set; }

    private readonly List<ChoiceOption> _sexOptions = [new("1", "男"), new("2", "女")];
    private readonly List<ChoiceOption> _dischargeOptions =
    [
        new("死亡", "死亡"),
        new("自动出院", "自动出院"),
        new("非医嘱离院", "非医嘱离院"),
        new("救护车", "救护车")
    ];
    private readonly List<ChoiceOption> _reasonOptions =
    [
        new("1", "非心内科患者"),
        new("2", "患者自行离院"),
        new("3", "首页填写错误"),
        new("4", "其他")
    ];
    private readonly List<DiseaseOption> _diseases = [];
    private readonly List<SystemHospital> _hospitals = [];
    private string _patientName = "";
    private string _patientSex = "";
    private string _patientAge = "";
    private string _patientNumber = "";
    private string _diseaseId = "";
    private string _hospitalId = "";
    private string _dischargeMode = "";
    private string _reason = "";
    private string _reasonSupplement = "";
    private DateTime? _admissionTime;
    private DateTime? _dischargeTime;
    private bool _isLoading = true;

    private const string PageClass = "edit-page modal-edit-content";
    private const string BodyClass = "case-dialog-body";
    private const string ActionsClass = "case-dialog-actions";
    private bool HasSelectedHospital => !string.IsNullOrWhiteSpace(_hospitalId);
    private bool CanCreate => HasSelectedHospital
                              && !string.IsNullOrWhiteSpace(_patientNumber)
                              && _dischargeTime.HasValue
                              && !string.IsNullOrWhiteSpace(_diseaseId);
    private bool ShouldShowReasonSupplement => string.Equals(_reason, "4", StringComparison.OrdinalIgnoreCase);
    private IEnumerable<ChoiceOption> SurgeryOptions => _diseases.Select(x => new ChoiceOption(x.Id, x.Name));

    protected override async Task OnPageInitializedAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            var maps = await _registryContext.FormTemplateMaps.AsNoTracking()
                .Where(x => x.BusinessType == "case")
                .OrderBy(x => x.TemplateName)
                .ToListAsync();
            _diseases.AddRange(maps.Select(x => new DiseaseOption(x.SourceFollowTemplateId, x.TemplateName)));

            _hospitals.AddRange(await _registryContext.SystemHospitals.AsNoTracking()
                .OrderBy(x => x.Name)
                .ToListAsync());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.CaseCreate))
        {
            return;
        }

        if (!CanCreate)
        {
            inj_snackbar.Add("请选择医院，并填写病案号、出院时间和手术类别", Severity.Warning);
            return;
        }

        string? operatorName = null;
        if (!string.IsNullOrWhiteSpace(CurrentUserId) && Guid.TryParse(CurrentUserId, out var operatorGuid))
        {
            operatorName = await _registryContext.SystemUsers.AsNoTracking()
                .Where(x => x.Id == operatorGuid)
                .Select(x => x.DisplayName == "" ? x.Account : x.DisplayName)
                .FirstOrDefaultAsync();
        }

        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        var now = ToDbTimestamp(DateTime.Now);
        var caseId = Guid.NewGuid();
        try
        {
            var maxSort = await _registryContext.Cases.Select(x => (int?)x.Sort).MaxAsync() ?? 0;
            var item = new RegistryCase
            {
                Id = caseId,
                OldCaseId = caseId.ToString(),
                PatientName = _patientName.Trim(),
                PatientSex = EmptyToNull(_patientSex),
                PatientSexText = FormValueDisplayMapper.Normalize("性别", _patientSex),
                PatientAge = EmptyToNull(_patientAge),
                PatientNumber = EmptyToNull(_patientNumber),
                IdNumber = null,
                DiseaseId = _diseaseId,
                HospitalId = EmptyToNull(_hospitalId),
                HospitalName = _hospitals.FirstOrDefault(x => x.Id.ToString().Equals(_hospitalId, StringComparison.OrdinalIgnoreCase))?.Name,
                DepartmentId = null,
                OperatorId = EmptyToNull(CurrentUserId),
                OperatorName = operatorName,
                AdmissionTime = ToDbTimestamp(_admissionTime),
                DischargeTime = ToDbTimestamp(_dischargeTime),
                OperationTime = null,
                SurgeryTypeValue = _diseaseId,
                SurgeryTypeText = FormValueDisplayMapper.Normalize("手术类别", _diseaseId),
                Status = 3,
                SubStatus = 0,
                Sort = maxSort + 1,
                CreatedAt = now,
                CreatedBy = CurrentUserId
            };
            _registryContext.Cases.Add(item);

            await AddCaseFormsAsync(caseId, _diseaseId, now);
            var log = CreateOperationLog("病例", "新建", "case", caseId);
            log.CreatedAt = now;
            _registryContext.OperationLogs.Add(log);
            await _registryContext.SaveChangesAsync();
            await transaction.CommitAsync();
        }
        catch (DbUpdateException ex)
        {
            await transaction.RollbackAsync();
            inj_loggerFactory.CreateLogger("CaseEdit").LogError(ex, "创建病例失败");
            inj_snackbar.Add($"病例创建失败：{GetExceptionMessage(ex)}", Severity.Error);
            return;
        }

        inj_snackbar.Add("病例已创建", Severity.Success);
        await Saved.InvokeAsync(caseId);
    }

    private async Task AddCaseFormsAsync(Guid caseId, string diseaseId, DateTime now)
    {
        if (_registryContext == null)
        {
            return;
        }

        var maps = await _registryContext.FormTemplateMaps.AsNoTracking()
            .Where(x => x.BusinessType == "case" && x.SourceFollowTemplateId == diseaseId)
            .ToListAsync();
        var templateIds = maps.Select(x => x.FormTemplateId).Distinct().ToList();
        var definitions = await _registryContext.FormFieldDefinitions.AsNoTracking()
            .Where(x => templateIds.Contains(x.FormTemplateId))
            .OrderBy(x => x.Sort)
            .ThenBy(x => x.StorageKey)
            .ToListAsync();
        var definitionsByTemplate = definitions
            .GroupBy(x => x.FormTemplateId)
            .ToDictionary(x => x.Key, x => x.ToList());

        foreach (var map in maps)
        {
            var instance = new RegistryFormInstance
            {
                OwnerType = "case",
                OwnerId = caseId,
                FormTemplateId = map.FormTemplateId,
                FormTemplateMapId = map.Id,
                SourceCustomFormId = map.SourceCustomFormId,
                SourceFollowTemplateId = map.SourceFollowTemplateId,
                Status = 0,
                CreatedAt = now,
                CreatedBy = CurrentUserId
            };
            _registryContext.FormInstances.Add(instance);

            if (!definitionsByTemplate.TryGetValue(map.FormTemplateId, out var fields))
            {
                continue;
            }

            foreach (var field in fields)
            {
                _registryContext.FormFieldValues.Add(new RegistryFormFieldValue
                {
                    FormInstanceId = instance.Id,
                    FormFieldDefinitionId = field.Id,
                    StorageKey = field.StorageKey,
                    SourceSubjectId = field.SourceSubjectId,
                    FieldCode = field.FieldCode,
                    FieldName = field.FieldName,
                    FieldValue = GetInitialFieldValue(field.FieldName),
                    Sort = field.Sort,
                    CreatedAt = now,
                    CreatedBy = CurrentUserId
                });
            }
        }
    }

    private async Task Back()
    {
        await Cancelled.InvokeAsync();
    }

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static DateTime ToDbTimestamp(DateTime value)
        => DateTime.SpecifyKind(value, DateTimeKind.Unspecified);

    private static DateTime? ToDbTimestamp(DateTime? value)
        => value.HasValue ? ToDbTimestamp(value.Value) : null;

    private static string GetExceptionMessage(Exception exception)
    {
        var root = exception.GetBaseException();
        return string.IsNullOrWhiteSpace(root.Message) ? exception.Message : root.Message;
    }

    private string? GetInitialFieldValue(string fieldName)
    {
        var name = fieldName.Trim();
        if (name.Equals("病案号", StringComparison.OrdinalIgnoreCase))
        {
            return EmptyToNull(_patientNumber);
        }

        if (name.Equals("患者姓名", StringComparison.OrdinalIgnoreCase))
        {
            return EmptyToNull(_patientName);
        }

        if (name.Equals("性别", StringComparison.OrdinalIgnoreCase))
        {
            return EmptyToNull(_patientSex);
        }

        if (name.Equals("年龄", StringComparison.OrdinalIgnoreCase))
        {
            return EmptyToNull(_patientAge);
        }

        if (name.Equals("入院时间", StringComparison.OrdinalIgnoreCase))
        {
            return FormatDate(_admissionTime);
        }

        if (name.Equals("出院时间", StringComparison.OrdinalIgnoreCase))
        {
            return FormatDate(_dischargeTime);
        }

        if (name.Equals("手术类型", StringComparison.OrdinalIgnoreCase) || name.Equals("手术类别", StringComparison.OrdinalIgnoreCase))
        {
            return EmptyToNull(_diseaseId);
        }

        if (name.Equals("离院方式", StringComparison.OrdinalIgnoreCase))
        {
            return EmptyToNull(_dischargeMode);
        }

        if (name.Equals("情况说明/原因说明", StringComparison.OrdinalIgnoreCase) || name.Equals("情况/原因说明", StringComparison.OrdinalIgnoreCase))
        {
            return EmptyToNull(_reason);
        }

        if (name.Equals("补充说明", StringComparison.OrdinalIgnoreCase))
        {
            return ShouldShowReasonSupplement ? EmptyToNull(_reasonSupplement) : null;
        }

        return null;
    }

    private static string? FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd");

    private static string GetChoiceClass(string currentValue, string optionValue)
        => string.Equals(currentValue, optionValue, StringComparison.OrdinalIgnoreCase)
            ? "case-choice-tag selected"
            : "case-choice-tag";

    private static string ToggleSingle(string currentValue, string optionValue)
        => string.Equals(currentValue, optionValue, StringComparison.OrdinalIgnoreCase) ? "" : optionValue;

    private void SetPatientSex(string value) => _patientSex = ToggleSingle(_patientSex, value);

    private void SetDisease(string value) => _diseaseId = ToggleSingle(_diseaseId, value);

    private sealed record DiseaseOption(string Id, string Name);

    private sealed record ChoiceOption(string Value, string Text);
}
