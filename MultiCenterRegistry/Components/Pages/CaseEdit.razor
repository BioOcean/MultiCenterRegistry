@inherits BasePage

<PageTitle>新建病例</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="@PageClass">
    <div class="case-dialog-head">
        <div class="case-dialog-title">
            <span class="case-dialog-icon">
                <MudIcon Icon="@Icons.Material.Filled.NoteAdd" />
            </span>
            <span id="case-create-modal-title">新建病例</span>
        </div>
        <MudIconButton Class="case-dialog-close" Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" title="关闭" OnClick="Back" />
    </div>

    @if (_isLoading)
    {
        <div class="@BodyClass">
            <MudPaper Class="loading-panel" Elevation="0">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <span>正在加载基础数据</span>
            </MudPaper>
        </div>
    }
    else
    {
        <div class="@BodyClass">
            <div class="case-create-form">
                <section class="case-create-section">
                    <div class="case-create-grid">
                        <div class="case-create-field case-create-span-2">
                            <div class="case-create-label">医院</div>
                            <McrSearchSelect Options="@_hospitals.Select(x => new FixedOption(x.Id.ToString(), x.Name)).ToList()"
                                             @bind-Value="_hospitalId"
                                             Placeholder="请选择医院" />
                        </div>
                    </div>
                </section>

                @if (HasSelectedHospital)
                {
                    <section class="case-create-section">
                        <div class="case-create-grid">
                            <div class="case-create-field">
                                <div class="case-create-label"><span class="case-required">*</span>病案号</div>
                                <MudTextField T="string" @bind-Value="_patientNumber" Placeholder="请输入病案号" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>
                            <div class="case-create-field">
                                <div class="case-create-label">患者姓名</div>
                                <MudTextField T="string" @bind-Value="_patientName" Placeholder="请输入患者姓名" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>
                            <div class="case-create-field">
                                <div class="case-create-label">性别</div>
                                <div class="case-choice-group">
                                    @foreach (var option in RegistryFixedCatalog.SexOptions)
                                    {
                                        <button type="button" class="@GetChoiceClass(_patientSex, option.Value)" @onclick="@(() => _patientSex = ToggleSingle(_patientSex, option.Value))">@option.Text</button>
                                    }
                                </div>
                            </div>
                            <div class="case-create-field">
                                <div class="case-create-label">年龄</div>
                                <MudTextField T="string" @bind-Value="_patientAge" Placeholder="请输入年龄" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.End" AdornmentText="岁" />
                            </div>
                            <div class="case-create-field">
                                <div class="case-create-label">入院时间</div>
                                <McrDateField Class="case-create-date-picker" @bind-Date="_admissionTime" Clearable="true" />
                            </div>
                            <div class="case-create-field">
                                <div class="case-create-label"><span class="case-required">*</span>出院时间</div>
                                <McrDateField Class="case-create-date-picker" @bind-Date="_dischargeTime" Clearable="true" />
                            </div>
                            <div class="case-create-field case-create-span-2">
                                <div class="case-create-label"><span class="case-required">*</span>手术类别</div>
                                <div class="case-choice-group">
                                    @foreach (var option in CreateSurgeryOptions)
                                    {
                                        <button type="button" class="@GetChoiceClass(_diseaseId, option.Value)" @onclick="@(() => SetDisease(option.Value))">@option.Text</button>
                                    }
                                </div>
                            </div>
                            <div class="case-create-field">
                                <div class="case-create-label">离院方式</div>
                                <MudTextField T="string" @bind-Value="_dischargeMode" Placeholder="请输入离院方式" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </div>
                            <div class="case-create-field">
                                <div class="case-create-label">情况/原因说明</div>
                                <McrSearchSelect Options="RegistryFixedCatalog.SituationReasons"
                                                 @bind-Value="_situationReason"
                                                 Placeholder="请选择" />
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>

        <div class="@ActionsClass">
            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="Back">取消</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!CanCreate)" OnClick="SaveAsync">创建</MudButton>
        </div>
    }
</MudContainer>

@code {
    [Parameter]
    public EventCallback<Guid> Saved { get; set; }

    [Parameter]
    public EventCallback Cancelled { get; set; }

    private static readonly IReadOnlyList<FixedOption> CreateSurgeryOptions =
    [
        new("6237dd62-15b9-4676-972d-bf32476b3546", "冠心病介入"),
        new("ae92e4fa-5e02-4d4c-a773-3dc79c4935bc", "导管消融"),
        new("f827ae4a-f24f-4df9-b92f-7601025a1864", "起搏器及CIED植入/置换"),
        new("c1174c60-2ef2-45f6-85dd-5269b567f996", "结构性心脏病介入")
    ];

    private readonly List<SystemHospital> _hospitals = [];
    private readonly List<string> _scopeHospitalIds = [];
    private string _patientName = "";
    private string _patientSex = "";
    private string _patientAge = "";
    private string _patientNumber = "";
    private string _diseaseId = "";
    private string _hospitalId = "";
    private string _operatorName = "";
    private string _dischargeMode = "";
    private string _situationReason = "";
    private DateTime? _admissionTime;
    private DateTime? _dischargeTime;
    private bool _isLoading = true;

    private const string PageClass = "edit-page modal-edit-content";
    private const string BodyClass = "case-dialog-body";
    private const string ActionsClass = "case-dialog-actions";

    private bool HasSelectedHospital => !string.IsNullOrWhiteSpace(_hospitalId);
    private bool CanCreate => HasSelectedHospital
                              && !string.IsNullOrWhiteSpace(_patientNumber)
                              && _dischargeTime.HasValue
                              && !string.IsNullOrWhiteSpace(_diseaseId);

    protected override async Task OnPageInitializedAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            await LoadRoleScopesAsync();
            var hospitalQuery = _registryContext.SystemHospitals.AsNoTracking();
            if (!HasPermission(PermissionConstants.QualityManage) && _scopeHospitalIds.Count > 0)
            {
                var scopeIds = _scopeHospitalIds.Select(TryParseGuid).Where(x => x.HasValue).Select(x => x!.Value).ToList();
                hospitalQuery = hospitalQuery.Where(x => scopeIds.Contains(x.Id));
            }

            _hospitals.AddRange(await hospitalQuery
                .OrderBy(x => x.Name)
                .ToListAsync());
            if (string.IsNullOrWhiteSpace(_hospitalId) && _hospitals.Count == 1)
            {
                _hospitalId = _hospitals[0].Id.ToString();
            }

            _operatorName = await GetCurrentUserNameAsync() ?? "";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadRoleScopesAsync()
    {
        if (_registryContext == null || !Guid.TryParse(CurrentUserId, out var userId) || CurrentRoleId == Guid.Empty)
        {
            return;
        }

        _scopeHospitalIds.Clear();
        _scopeHospitalIds.AddRange(await _registryContext.SystemUserRoleScopes.AsNoTracking()
            .Where(x => x.UserId == userId && x.RoleId == CurrentRoleId)
            .Select(x => x.HospitalId.ToString())
            .Distinct()
            .ToListAsync());
    }

    private async Task SaveAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.CaseCreate))
        {
            return;
        }

        if (!CanCreate)
        {
            inj_snackbar.Add("请选择医院，并填写病案号、出院时间和手术类别", Severity.Warning);
            return;
        }

        var now = ToDbTimestamp(DateTime.Now);
        var caseId = Guid.NewGuid();
        var hospital = _hospitals.FirstOrDefault(x => x.Id.ToString().Equals(_hospitalId, StringComparison.OrdinalIgnoreCase));
        var operatorName = string.IsNullOrWhiteSpace(_operatorName) ? await GetCurrentUserNameAsync() : _operatorName;
        var maxSort = await _registryContext.Cases.Select(x => (int?)x.Sort).MaxAsync() ?? 0;
        var item = new RegistryCase
        {
            Id = caseId,
            OldCaseId = caseId.ToString(),
            PatientName = _patientName.Trim(),
            PatientSex = EmptyToNull(_patientSex),
            PatientSexText = RegistryFixedCatalog.GetSexName(_patientSex),
            PatientAge = EmptyToNull(_patientAge),
            PatientNumber = EmptyToNull(_patientNumber),
            DiseaseId = _diseaseId,
            DiseaseName = RegistryFixedCatalog.GetDiseaseName(_diseaseId),
            HospitalId = EmptyToNull(_hospitalId),
            HospitalName = hospital?.Name,
            OperatorId = EmptyToNull(CurrentUserId),
            OperatorName = operatorName,
            AdmissionTime = ToDbTimestamp(_admissionTime),
            DischargeTime = ToDbTimestamp(_dischargeTime),
            SurgeryTypeValue = _diseaseId,
            SurgeryTypeText = RegistryFixedCatalog.GetDiseaseName(_diseaseId),
            DischargeMode = EmptyToNull(_dischargeMode),
            SituationReason = EmptyToNull(_situationReason),
            Status = 3,
            SubStatus = 0,
            Sort = maxSort + 1,
            CreatedAt = now,
            CreatedBy = CurrentUserId
        };

        if (!item.HospitalStayDays.HasValue && item.AdmissionTime.HasValue && item.DischargeTime.HasValue)
        {
            item.HospitalStayDays = Math.Max(0, (int)(item.DischargeTime.Value.Date - item.AdmissionTime.Value.Date).TotalDays);
        }

        _registryContext.Cases.Add(item);
        _registryContext.OperationLogs.Add(CreateOperationLog("病例", "新建", "case", caseId));
        await _registryContext.SaveChangesAsync();

        inj_snackbar.Add("病例已创建", Severity.Success);
        await Saved.InvokeAsync(caseId);
    }

    private async Task<string?> GetCurrentUserNameAsync()
    {
        if (_registryContext == null || !Guid.TryParse(CurrentUserId, out var userId))
        {
            return null;
        }

        return await _registryContext.SystemUsers.AsNoTracking()
            .Where(x => x.Id == userId)
            .Select(x => x.DisplayName == "" ? x.Account : x.DisplayName)
            .FirstOrDefaultAsync();
    }

    private async Task Back() => await Cancelled.InvokeAsync();

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static Guid? TryParseGuid(string? value)
        => Guid.TryParse(value, out var guid) ? guid : null;

    private static DateTime ToDbTimestamp(DateTime value) => DateTime.SpecifyKind(value, DateTimeKind.Unspecified);

    private static DateTime? ToDbTimestamp(DateTime? value) => value.HasValue ? ToDbTimestamp(value.Value) : null;

    private static string GetChoiceClass(string currentValue, string optionValue)
        => string.Equals(currentValue, optionValue, StringComparison.OrdinalIgnoreCase)
            ? "case-choice-tag selected"
            : "case-choice-tag";

    private static string ToggleSingle(string currentValue, string optionValue)
        => string.Equals(currentValue, optionValue, StringComparison.OrdinalIgnoreCase) ? "" : optionValue;

    private void SetDisease(string value)
    {
        _diseaseId = ToggleSingle(_diseaseId, value);
    }
}
