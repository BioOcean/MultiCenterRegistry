    private async Task SavePortalConfigAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.MessageManager))
        {
            return;
        }

        var title = _portalTitle.Trim();
        var content = _portalContent.Trim();
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(content))
        {
            inj_snackbar.Add("门户标题和门户介绍不能为空", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            await UpsertPortalConfigAsync(PortalTitleCode, "门户标题", title);
            await UpsertPortalConfigAsync(PortalContentCode, "门户介绍", content);
            await UpsertPortalConfigAsync(PortalAnnouncementCode, "登录公告", _portalAnnouncement.Trim());
            _registryContext.OperationLogs.Add(CreateOperationLog("门户介绍", "保存门户介绍配置", "portal_config", Guid.Empty));
            await _registryContext.SaveChangesAsync();
            _showPortalEditor = false;
            inj_snackbar.Add("门户介绍配置已保存", Severity.Success);
        }
        catch (Exception ex) when (IsMissingAdminContentTable(ex))
        {
            MarkSchemaMissing();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task UpsertPortalConfigAsync(string code, string title, string value)
    {
        var config = await _registryContext!.PortalConfigs.FirstOrDefaultAsync(x => x.Code == code);
        if (config == null)
        {
            _registryContext.PortalConfigs.Add(new PortalConfig
            {
                Code = code,
                Title = title,
                Value = value,
                UpdatedAt = DateTime.Now,
                UpdatedBy = CurrentUserId
            });
            return;
        }

        config.Title = title;
        config.Value = value;
        config.UpdatedAt = DateTime.Now;
        config.UpdatedBy = CurrentUserId;
    }

    private string GetArticleStatCardClass(string status)
        => _articleStatusValue == status ? "article-stat-card active" : "article-stat-card";

    private static string GetArticleStatusText(int status)
        => status == PublishedStatus ? "已发布" : "未发布";

    private static string GetArticleStatusClass(int status)
        => status == PublishedStatus ? "published" : "draft";

    private static string ShowDateTime(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) : "-";

    private static string ShowValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string GetSnippet(string? value)
    {
        var text = System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(value ?? "", "<[^>]+>", " "));
        text = System.Text.RegularExpressions.Regex.Replace(text, "\\s+", " ").Trim();
        return text.Length <= 80 ? text : $"{text[..80]}...";
    }

    private void MarkSchemaMissing()
    {
        _schemaMissing = true;
        inj_snackbar.Add("后台文献消息表不存在，请先执行 Script\\13_extend_admin_content.sql", Severity.Error);
    }

    private static bool IsMissingAdminContentTable(Exception ex)
    {
        var text = ex.ToString();
        return text.Contains("mcr.article", StringComparison.OrdinalIgnoreCase)
               || text.Contains("mcr.portal_config", StringComparison.OrdinalIgnoreCase)
               || (text.Contains("relation", StringComparison.OrdinalIgnoreCase)
                   && text.Contains("does not exist", StringComparison.OrdinalIgnoreCase));
    }

