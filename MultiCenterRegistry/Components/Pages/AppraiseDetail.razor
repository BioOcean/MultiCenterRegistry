    };

    private async Task SaveAppraiseAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.AppraiseEdit))
        {
            return;
        }

        var appraise = SelectedAppraise;
        if (appraise?.CanEdit != true)
        {
            inj_snackbar.Add("只能保存本人未提交的评审表单", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认保存当前评审表单修改？"))
        {
            return;
        }

        var entity = await _registryContext.CaseAppraises
            .FirstOrDefaultAsync(x => x.Id == appraise.Id && x.MeetingId == MeetingId && x.CaseId == CaseId && x.ExpertId == CurrentUserId && x.Status == 0);
        if (entity == null)
        {
            inj_snackbar.Add("当前评审状态已变化，请刷新后重试", Severity.Warning);
            await LoadAppraiseAsync();
            return;
        }

        ApplyAppraise(entity, appraise);
        _registryContext.OperationLogs.Add(CreateOperationLog("评审", "保存表单", "case", CaseId));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("评审表单已保存", Severity.Success);
        await LoadAppraiseAsync();
    }

    private async Task SubmitAppraiseAsync(Guid appraiseId)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.AppraiseEdit))
        {
            return;
        }

        var block = _appraises.FirstOrDefault(x => x.Id == appraiseId);
        var entity = await _registryContext.CaseAppraises
            .FirstOrDefaultAsync(x => x.Id == appraiseId && x.MeetingId == MeetingId && x.CaseId == CaseId && x.ExpertId == CurrentUserId);
        if (entity == null || block == null)
        {
            inj_snackbar.Add("只能提交本人评审", Severity.Warning);
            return;
        }

        if (entity.Status != 0)
        {
            inj_snackbar.Add("当前评审已提交，不能重复提交", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认提交当前评审？提交后状态会变为已评审。"))
        {
            return;
        }

        ApplyAppraise(entity, block);
        entity.Status = 1;
        entity.UpdatedAt = ToDbTimestamp(DateTime.Now);
        entity.UpdatedBy = CurrentUserId;
        _registryContext.OperationLogs.Add(CreateOperationLog("评审", "提交评审", "appraise", appraiseId));
        await _registryContext.SaveChangesAsync();
        await UpdateCaseReviewStatusAsync();
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("评审已提交", Severity.Success);
        await LoadAppraiseAsync();
    }

    private static void ApplyAppraise(CaseAppraise entity, AppraiseBlock appraise)
    {
        entity.Indication = EmptyToNull(appraise.Indication);
        entity.Operation = EmptyToNull(appraise.Operation);
        entity.DeviceComplete = EmptyToNull(appraise.DeviceComplete);
        entity.SurgeryLevelImplemented = EmptyToNull(appraise.SurgeryLevelImplemented);
        entity.HasManagementProblem = EmptyToNull(appraise.HasManagementProblem);
        entity.ManagementProblemDescription = ShouldShowManagementProblemDescription(appraise) ? EmptyToNull(appraise.ManagementProblemDescription) : null;
        entity.RescueTimely = EmptyToNull(appraise.RescueTimely);
        entity.RescueMeasureProper = EmptyToNull(appraise.RescueMeasureProper);
        entity.RescueDeviceComplete = EmptyToNull(appraise.RescueDeviceComplete);
        entity.DeathReason = EmptyToNull(appraise.DeathReason);
        entity.OtherDeathReason = ShouldShowOtherDeathReason(appraise) ? EmptyToNull(appraise.OtherDeathReason) : null;
        entity.NeedImprovement = EmptyToNull(appraise.NeedImprovement);
        entity.ImprovementContent = ShouldShowImprovementContent(appraise) ? EmptyToNull(appraise.ImprovementContent) : null;
        entity.UpdatedAt = ToDbTimestamp(DateTime.Now);
        entity.UpdatedBy = appraise.ExpertId;
    }

    private async Task UpdateCaseReviewStatusAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        var statuses = await _registryContext.CaseAppraises.AsNoTracking()
            .Where(x => x.MeetingId == MeetingId && x.CaseId == CaseId)
            .Select(x => x.Status)
            .ToListAsync();
        var subStatus = statuses.Count > 0 && statuses.All(x => x == 1) ? 2 : 1;
        await _registryContext.Cases.Where(x => x.Id == CaseId)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.SubStatus, subStatus)
                .SetProperty(x => x.UpdatedAt, ToDbTimestamp(DateTime.Now))
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
    }

    private bool CanEditSummary(CaseSummary summary)
        => summary.Status == 0
           && HasPermission(PermissionConstants.AppraiseEdit)
           && _meeting?.Status == 1
           && _isMeetingLeader;

    private async Task<CaseSummary?> GetOrCreateSummaryEntityAsync(CaseSummary summary, DateTime now)
    {
        if (_registryContext == null)
        {
            return null;
        }

        var entity = summary.Id == Guid.Empty
            ? null
            : await _registryContext.CaseSummaries.FirstOrDefaultAsync(x => x.Id == summary.Id && x.MeetingId == MeetingId && x.CaseId == CaseId);
        entity ??= await _registryContext.CaseSummaries.FirstOrDefaultAsync(x => x.MeetingId == MeetingId && x.CaseId == CaseId);
        if (entity != null)
        {
            return entity;
        }

        entity = new CaseSummary
        {
            MeetingId = MeetingId,
            CaseId = CaseId,
            Content = "",
            Status = 0,
            CreatedAt = now,
            CreatedBy = _meetingLeaderId ?? CurrentUserId,
            ExpertName = CurrentUserName
        };
        _registryContext.CaseSummaries.Add(entity);
        return entity;
    }

    private async Task SaveSummaryAsync(CaseSummary summary)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.AppraiseEdit) || !await RequireLeaderAsync(summary))
        {
            return;
        }

        if (summary.Status != 0)
        {
            inj_snackbar.Add("已提交的汇总不能修改", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(summary.Content))
        {
            inj_snackbar.Add("请先填写评审汇总", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认保存评审汇总？"))
        {
            return;
        }

        var now = ToDbTimestamp(DateTime.Now) ?? DateTime.Now;
        var entity = await GetOrCreateSummaryEntityAsync(summary, now);
        if (entity == null || entity.Status != 0)
        {
            inj_snackbar.Add("汇总状态已变化，请刷新后重试", Severity.Warning);
            await LoadAppraiseAsync();
            return;
        }

        entity.Content = summary.Content ?? "";
        entity.UpdatedAt = now;
        entity.UpdatedBy = CurrentUserId;
        _registryContext.OperationLogs.Add(CreateOperationLog("评审", "保存汇总", "summary", entity.Id));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("汇总已保存", Severity.Success);
        await LoadAppraiseAsync();
    }

    private async Task SubmitSummaryAsync(CaseSummary summary)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.AppraiseEdit) || !await RequireLeaderAsync(summary))
        {
            return;
        }

        if (summary.Status != 0)
        {
            inj_snackbar.Add("已提交的汇总不能重复提交", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(summary.Content))
        {
            inj_snackbar.Add("请先填写评审汇总", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认提交评审汇总？提交后病例会标记为已评审。"))
        {
            return;
        }

        var now = ToDbTimestamp(DateTime.Now) ?? DateTime.Now;
        var entity = await GetOrCreateSummaryEntityAsync(summary, now);
        if (entity == null || entity.Status != 0)
        {
            inj_snackbar.Add("汇总状态已变化，请刷新后重试", Severity.Warning);
            await LoadAppraiseAsync();
            return;
        }

        entity.Content = summary.Content ?? "";
        entity.Status = 1;
        entity.UpdatedAt = now;
        entity.UpdatedBy = CurrentUserId;

        await _registryContext.Cases.Where(x => x.Id == CaseId)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.SubStatus, 2)
                .SetProperty(x => x.UpdatedAt, now)
                .SetProperty(x => x.UpdatedBy, CurrentUserId));

        var meetingCaseIds = await _registryContext.CaseAppraises.AsNoTracking()
            .Where(x => x.MeetingId == MeetingId)
            .Select(x => x.CaseId)
            .Distinct()
            .ToListAsync();
        var submittedCaseIds = await _registryContext.CaseSummaries.AsNoTracking()
            .Where(x => x.MeetingId == MeetingId && x.Status == 1)
            .Select(x => x.CaseId)
            .Distinct()
            .ToListAsync();
        if (meetingCaseIds.Count > 0 && meetingCaseIds.All(x => submittedCaseIds.Contains(x)))
        {
            await _registryContext.ReviewMeetings.Where(x => x.Id == MeetingId)
                .ExecuteUpdateAsync(setters => setters
                    .SetProperty(x => x.Status, 2)
                    .SetProperty(x => x.UpdatedAt, now)
                    .SetProperty(x => x.UpdatedBy, CurrentUserId));
        }

        _registryContext.OperationLogs.Add(CreateOperationLog("评审", "提交汇总", "summary", entity.Id));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("汇总已提交", Severity.Success);
        await LoadAppraiseAsync();
    }

    private async Task<bool> RequireLeaderAsync(CaseSummary summary)
    {
        if (_registryContext == null)
        {
            return false;
        }

        if (_meeting?.Status != 1)
        {
            inj_snackbar.Add("当前会议状态不能维护评审汇总", Severity.Warning);
            return false;
        }

        var isMeetingLeader = await _registryContext.MeetingExperts.AsNoTracking()
            .AnyAsync(x => x.MeetingId == MeetingId && x.Level == 1 && x.ExpertId == CurrentUserId);
        if (isMeetingLeader)
        {
            return true;
        }

        inj_snackbar.Add("只有当前会议组长可以维护评审汇总", Severity.Warning);
        return false;
    }

