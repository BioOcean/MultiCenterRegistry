        AddChoiceStatistic("介入操作", OperationOptions, appraises.Select(x => x.Operation));
        AddChoiceStatistic("设备器械配套是否齐全", CompleteOptions, appraises.Select(x => x.DeviceComplete));
        AddChoiceStatistic("介入分级手术管理是否落实到位", RegistryFixedCatalog.YesNoOptions, appraises.Select(x => x.SurgeryLevelImplemented));
        AddChoiceStatistic("是否存在其他管理问题", RegistryFixedCatalog.YesNoOptions, appraises.Select(x => x.HasManagementProblem));
        AddChoiceStatistic("救治是否及时", RegistryFixedCatalog.YesNoOptions, appraises.Select(x => x.RescueTimely));
        AddChoiceStatistic("救治措施是否得当", RegistryFixedCatalog.YesNoOptions, appraises.Select(x => x.RescueMeasureProper));
        AddChoiceStatistic("救治药品设备是否齐全", CompleteOptions, appraises.Select(x => x.RescueDeviceComplete));
        AddChoiceStatistic("死亡原因", DeathReasonOptions, appraises.Select(x => x.DeathReason));
        AddChoiceStatistic("是否需要提交进一步改进措施", RegistryFixedCatalog.YesNoOptions, appraises.Select(x => x.NeedImprovement));
        AddTextStatistic("改进措施内容", appraises.Select(x => x.ImprovementContent));
    }

    private void AddChoiceStatistic(string fieldName, IReadOnlyList<FixedOption> options, IEnumerable<string?> values)
    {
        var valueList = values
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
        _statistics.Add(new FieldStatistic(fieldName, options
            .Select(x => new FieldStatisticOption(x.Text, valueList.Count(value => ContainsOptionValue(value, x))))
            .ToList()));
    }

    private void AddTextStatistic(string fieldName, IEnumerable<string?> values)
    {
        var textOptions = values
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select((x, index) => new FieldStatisticOption($"{index + 1}.{x!.Trim()}", null))
            .ToList();
        if (textOptions.Count > 0)
        {
            _statistics.Add(new FieldStatistic(fieldName, textOptions));
        }
    }

    private static bool ContainsOptionValue(string? value, FixedOption option)
        => !string.IsNullOrWhiteSpace(value)
           && value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
               .Any(x => IsSameValue(x, option.Value) || IsSameValue(x, option.Text));

