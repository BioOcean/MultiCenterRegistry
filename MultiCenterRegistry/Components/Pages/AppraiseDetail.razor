@page "/meetings/{MeetingId:guid}/cases/{CaseId:guid}/appraise"
@inherits BasePage

<PageTitle>@(_case == null ? "病例评审" : $"{_case.PatientName} - 病例评审")</PageTitle>

<div class="appraise-page">
    <div class="detail-header appraise-detail-header">
        <MudIconButton Class="appraise-back-button"
                       Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Primary"
                       Size="Size.Medium"
                       title="返回会议"
                       OnClick="BackToMeeting" />
        <div class="appraise-title-block">
            <h1>@(_case?.PatientName ?? "病例评审")</h1>
            @if (_case != null)
            {
                <div class="appraise-top-info">
                    @foreach (var item in BuildHeaderItems())
                    {
                        <span><strong>@item.Label：</strong>@ShowValue(item.Value)</span>
                    }
                </div>
            }
        </div>
        @if (_case != null)
        {
            <div class="appraise-header-actions">
                <span class="status-pill @GetSubStatusClass(_case.SubStatus)">@GetSubStatusText(_case.SubStatus)</span>
            </div>
        }
    </div>

    @if (_isLoading)
    {
        <MudPaper Class="loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>正在加载病例评审</span>
        </MudPaper>
    }
    else if (_meeting == null || _case == null)
    {
        <MudPaper Class="loading-panel" Elevation="0">未找到会议或病例</MudPaper>
    }
    else
    {
        <div class="appraise-workspace">
            <section class="appraise-case-column">
                <div class="case-preview-panel">
                    <div class="case-form-layout">
                        <nav class="case-form-nav">
                            <button type="button"
                                    class="@GetCasePreviewNavClass(CasePreviewAllKey)"
                                    @onclick="@(() => SelectCasePreviewSection(CasePreviewAllKey))">
                                <span class="form-nav-dot"></span>
                                <span class="form-nav-text">全部</span>
                                <span class="form-nav-count">@GetCasePreviewFieldCount(CasePreviewAllKey)</span>
                            </button>
                            @foreach (var previewSection in _caseSections)
                            {
                                <button type="button"
                                        class="@GetCasePreviewNavClass(previewSection.Key)"
                                        title="@previewSection.Title"
                                        @onclick="@(() => SelectCasePreviewSection(previewSection.Key))">
                                    <span class="form-nav-dot"></span>
                                    <span class="form-nav-text">@previewSection.Title</span>
                                    <span class="form-nav-count">@previewSection.Fields.Count</span>
                                </button>
                            }
                        </nav>
                        <div class="case-pdf-view">
                            <div class="case-pdf-page">
                                @foreach (var previewSection in GetSelectedCasePreviewSections())
                                {
                                    <section class="case-pdf-section">
                                        <h3>@previewSection.Title</h3>
                                        @foreach (var field in previewSection.Fields)
                                        {
                                            <div class="@GetPdfQuestionClass(field)">
                                                <div class="pdf-question-name">@field.Name</div>
                                                <div class="pdf-question-value">
                                                    @if (field.IsFile)
                                                    {
                                                        <div class="pdf-file-list">
                                                            <span class="muted">暂无附件</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @ShowValue(field.Value)
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </section>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="appraise-review-column">
                <div class="review-shell">
                    <nav class="review-mode-tabs">
                        <button type="button" class="@GetReviewTabClass(ReviewTabAppraise)" @onclick="@(() => SelectReviewTab(ReviewTabAppraise))">评审</button>
                        @if (CanShowSummaryTab())
                        {
                            <button type="button" class="@GetReviewTabClass(ReviewTabSummary)" @onclick="@(() => SelectReviewTab(ReviewTabSummary))">汇总</button>
                        }
                    </nav>
                    <div class="review-content-panel">
                        @if (_activeReviewTab == ReviewTabAppraise)
                        {
                            @if (_appraises.Count == 0)
                            {
                                <div class="empty-line">暂无评审</div>
                            }
                            else
                            {
                                <div class="expert-tabs">
                                    @foreach (var appraise in _appraises)
                                    {
                                        <button type="button"
                                                class="@GetExpertTabClass(appraise)"
                                                @onclick="@(() => SelectAppraise(appraise.Id))">
                                            @ShowValue(appraise.ExpertName)
                                        </button>
                                    }
                                </div>

                                @if (SelectedAppraise is { } selectedAppraise)
                                {
                                    <div class="selected-appraise-head">
                                        <strong>@ShowValue(selectedAppraise.ExpertName)</strong>
                                        <span>@GetAppraiseStatusText(selectedAppraise.Status)</span>
                                        <em>@FormatDateTime(selectedAppraise.UpdatedAt ?? selectedAppraise.CreatedAt)</em>
                                    </div>

                                    @if (selectedAppraise.Status == 1)
                                    {
                                        <div class="review-pdf-view">
                                            @foreach (var pdfSection in BuildAppraisePdfSections(selectedAppraise))
                                            {
                                                <section class="review-pdf-section">
                                                    <h3>@pdfSection.Title</h3>
                                                    <div class="review-pdf-grid">
                                                        @foreach (var field in pdfSection.Fields)
                                                        {
                                                            <div class="@(field.FullRow ? "review-pdf-field full-row" : "review-pdf-field")">
                                                                <span>@field.Name</span>
                                                                <strong>@ShowValue(field.Value)</strong>
                                                            </div>
                                                        }
                                                    </div>
                                                </section>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="@(selectedAppraise.CanEdit ? "review-form-list" : "review-form-list is-disabled")">
                                            <section class="review-form-section">
                                                <button type="button" class="review-section-header" @onclick="@(() => ToggleReviewSection(InterventionReviewSection))">
                                                    <span>介入信息</span>
                                                    <em>@(IsReviewSectionCollapsed(InterventionReviewSection) ? "展开" : "收起")</em>
                                                </button>
                                                @if (!IsReviewSectionCollapsed(InterventionReviewSection))
                                                {
                                                    <div class="review-question-grid">
                                                        @ReviewRow("介入适应症", ChoiceInput(selectedAppraise, IndicationOptions, selectedAppraise.Indication, value => selectedAppraise.Indication = value))
                                                        @ReviewRow("介入操作", ChoiceInput(selectedAppraise, OperationOptions, selectedAppraise.Operation, value => selectedAppraise.Operation = value))
                                                    </div>
                                                }
                                            </section>

                                            <section class="review-form-section">
                                                <button type="button" class="review-section-header" @onclick="@(() => ToggleReviewSection(ManageReviewSection))">
                                                    <span>医院管理</span>
                                                    <em>@(IsReviewSectionCollapsed(ManageReviewSection) ? "展开" : "收起")</em>
                                                </button>
                                                @if (!IsReviewSectionCollapsed(ManageReviewSection))
                                                {
                                                    <div class="review-question-grid">
                                                        @ReviewRow("设备器械配套是否齐全", ChoiceInput(selectedAppraise, CompleteOptions, selectedAppraise.DeviceComplete, value => selectedAppraise.DeviceComplete = value))
                                                        @ReviewRow("介入分级手术管理是否落实到位", ChoiceInput(selectedAppraise, RegistryFixedCatalog.YesNoOptions, selectedAppraise.SurgeryLevelImplemented, value => selectedAppraise.SurgeryLevelImplemented = value))
                                                        @ReviewRow("是否存在其他管理问题", ChoiceInput(selectedAppraise, RegistryFixedCatalog.YesNoOptions, selectedAppraise.HasManagementProblem, value => selectedAppraise.HasManagementProblem = value))
                                                        @if (ShouldShowManagementProblemDescription(selectedAppraise))
                                                        {
                                                            @ReviewRow("其他管理问题描述", TextAreaInput(selectedAppraise, selectedAppraise.ManagementProblemDescription, value => selectedAppraise.ManagementProblemDescription = value), true)
                                                        }
                                                    </div>
                                                }
                                            </section>

                                            <section class="review-form-section">
                                                <button type="button" class="review-section-header" @onclick="@(() => ToggleReviewSection(RescueReviewSection))">
                                                    <span>并发症救治</span>
                                                    <em>@(IsReviewSectionCollapsed(RescueReviewSection) ? "展开" : "收起")</em>
                                                </button>
                                                @if (!IsReviewSectionCollapsed(RescueReviewSection))
                                                {
                                                    <div class="review-question-grid">
                                                        @ReviewRow("救治是否及时", ChoiceInput(selectedAppraise, RegistryFixedCatalog.YesNoOptions, selectedAppraise.RescueTimely, value => selectedAppraise.RescueTimely = value))
                                                        @ReviewRow("救治措施是否得当", ChoiceInput(selectedAppraise, RegistryFixedCatalog.YesNoOptions, selectedAppraise.RescueMeasureProper, value => selectedAppraise.RescueMeasureProper = value))
                                                        @ReviewRow("救治药品设备是否齐全", ChoiceInput(selectedAppraise, CompleteOptions, selectedAppraise.RescueDeviceComplete, value => selectedAppraise.RescueDeviceComplete = value))
                                                    </div>
                                                }
                                            </section>

                                            <section class="review-form-section">
                                                <button type="button" class="review-section-header" @onclick="@(() => ToggleReviewSection(DeathReviewSection))">
                                                    <span>死亡信息</span>
                                                    <em>@(IsReviewSectionCollapsed(DeathReviewSection) ? "展开" : "收起")</em>
                                                </button>
                                                @if (!IsReviewSectionCollapsed(DeathReviewSection))
                                                {
                                                    <div class="review-question-grid">
                                                        @ReviewRow("死亡原因", ChoiceInput(selectedAppraise, DeathReasonOptions, selectedAppraise.DeathReason, value => selectedAppraise.DeathReason = value))
                                                        @if (ShouldShowOtherDeathReason(selectedAppraise))
                                                        {
                                                            @ReviewRow("其他死亡原因", TextInput(selectedAppraise, selectedAppraise.OtherDeathReason, value => selectedAppraise.OtherDeathReason = value))
                                                        }
                                                    </div>
                                                }
                                            </section>

                                            <section class="review-form-section">
                                                <button type="button" class="review-section-header" @onclick="@(() => ToggleReviewSection(ImproveReviewSection))">
                                                    <span>下一步改进措施</span>
                                                    <em>@(IsReviewSectionCollapsed(ImproveReviewSection) ? "展开" : "收起")</em>
                                                </button>
                                                @if (!IsReviewSectionCollapsed(ImproveReviewSection))
                                                {
                                                    <div class="review-question-grid">
                                                        @ReviewRow("是否需要提交进一步改进措施", ChoiceInput(selectedAppraise, RegistryFixedCatalog.YesNoOptions, selectedAppraise.NeedImprovement, value => selectedAppraise.NeedImprovement = value))
                                                        @if (ShouldShowImprovementContent(selectedAppraise))
                                                        {
                                                            @ReviewRow("改进措施内容", TextAreaInput(selectedAppraise, selectedAppraise.ImprovementContent, value => selectedAppraise.ImprovementContent = value), true)
                                                        }
                                                    </div>
                                                }
                                            </section>
                                        </div>
                                    }

                                    @if (selectedAppraise.CanEdit)
                                    {
                                        <div class="review-bottom-actions">
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveAppraiseAsync">保存</MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SubmitAppraiseAsync(selectedAppraise.Id))">提交</MudButton>
                                        </div>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <MudPaper Class="section-panel appraise-section-panel appraise-summary-section" Elevation="0">
                                <div class="panel-title">
                                    <h2>评审汇总</h2>
                                    <span>@_summaries.Count 条</span>
                                </div>
                                @if (_summaries.Count == 0)
                                {
                                    <div class="empty-line">暂无汇总</div>
                                }
                                else
                                {
                                    <div class="summary-list">
                                        @foreach (var summary in _summaries)
                                        {
                                            <div class="summary-note">
                                                <div class="note-head">
                                                    <strong>组长汇总</strong>
                                                    <span>@GetSummaryStatusText(summary.Status)</span>
                                                </div>
                                                @if (CanEditSummary(summary))
                                                {
                                                    <MudTextField T="string"
                                                                  @bind-Value="summary.Content"
                                                                  Class="summary-textarea"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Lines="4" />
                                                    <div class="inline-actions">
                                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="@(() => SaveSummaryAsync(summary))">保存汇总</MudButton>
                                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Upload" OnClick="@(() => SubmitSummaryAsync(summary))">提交汇总</MudButton>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="note-content">@ShowValue(summary.Content)</div>
                                                }
                                                <div class="muted">@FormatDateTime(summary.CreatedAt)</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </MudPaper>

                            <MudPaper Class="section-panel appraise-section-panel appraise-stat-section" Elevation="0">
                                <div class="panel-title">
                                    <h2>答案统计</h2>
                                    <span>@_statistics.Count 个字段</span>
                                </div>
                                @if (_statistics.Count == 0)
                                {
                                    <div class="empty-line">暂无可统计答案</div>
                                }
                                else
                                {
                                    <div class="stat-table">
                                        <div class="stat-table-head">
                                            <span>项目</span>
                                            <span>投票结果</span>
                                        </div>
                                        @foreach (var item in _statistics)
                                        {
                                            <div class="stat-table-row">
                                                <div class="stat-table-name">@item.FieldName</div>
                                                <div class="stat-table-result">
                                                @foreach (var option in item.Options)
                                                {
                                                    @if (option.Count.HasValue)
                                                    {
                                                        <span class="stat-option">@option.Text：@option.Count.Value 人</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="stat-text-line">@option.Text</span>
                                                    }
                                                }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </MudPaper>
                        }
                    </div>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private const string CasePreviewAllKey = "all";
    private const string ReviewTabAppraise = "appraise";
    private const string ReviewTabSummary = "summary";
    private const string InterventionReviewSection = "intervention";
    private const string ManageReviewSection = "manage";
    private const string RescueReviewSection = "rescue";
    private const string DeathReviewSection = "death";
    private const string ImproveReviewSection = "improve";

    private static readonly IReadOnlyList<FixedOption> IndicationOptions =
    [
        new("1", "合理"),
        new("2", "欠合理"),
        new("3", "不合理")
    ];

    private static readonly IReadOnlyList<FixedOption> OperationOptions =
    [
        new("1", "规范"),
        new("2", "欠规范"),
        new("3", "不规范"),
        new("4", "极不规范")
    ];

    private static readonly IReadOnlyList<FixedOption> CompleteOptions =
    [
        new("1", "齐全"),
        new("2", "不齐全")
    ];

    private static readonly IReadOnlyList<FixedOption> DeathReasonOptions =
    [
        new("1", "疾病相关"),
        new("2", "药物相关"),
        new("3", "操作相关"),
        new("4", "器械相关"),
        new("5", "其他")
    ];

    [Parameter]
    public Guid MeetingId { get; set; }

    [Parameter]
    public Guid CaseId { get; set; }

    private ReviewMeeting? _meeting;
    private RegistryCase? _case;
    private readonly List<CasePreviewSection> _caseSections = [];
    private readonly List<AppraiseBlock> _appraises = [];
    private readonly List<CaseSummary> _summaries = [];
    private readonly List<FieldStatistic> _statistics = [];
    private string? _hospitalName;
    private string? _departmentName;
    private string? _operatorName;
    private string? _meetingLeaderId;
    private string _selectedCasePreviewSectionKey = CasePreviewAllKey;
    private string _activeReviewTab = ReviewTabAppraise;
    private Guid? _selectedAppraiseId;
    private bool _isLoading = true;
    private bool _isMeetingLeader;
    private readonly HashSet<string> _collapsedReviewSections = [];

    protected override Task OnPageInitializedAsync() => LoadAppraiseAsync();

    private async Task LoadAppraiseAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _meeting = await _registryContext.ReviewMeetings.AsNoTracking().FirstOrDefaultAsync(x => x.Id == MeetingId);
            _case = await _registryContext.Cases.AsNoTracking().FirstOrDefaultAsync(x => x.Id == CaseId);
            _caseSections.Clear();
            _appraises.Clear();
            _summaries.Clear();
            _statistics.Clear();
            _hospitalName = null;
            _departmentName = null;
            _operatorName = null;
            _meetingLeaderId = null;
            _isMeetingLeader = false;
            if (_meeting == null || _case == null)
            {
                return;
            }

            await LoadCaseNamesAsync();
            await LoadLeaderStateAsync();
            BuildCasePreviewSections();

            var allAppraises = await _registryContext.CaseAppraises.AsNoTracking()
                .Where(x => x.MeetingId == MeetingId && x.CaseId == CaseId)
                .OrderBy(x => x.Status)
                .ThenBy(x => x.CreatedAt)
                .ToListAsync();
            allAppraises = allAppraises
                .OrderByDescending(x => IsCurrentUser(x.ExpertId))
                .ThenBy(x => x.Status)
                .ThenBy(x => x.CreatedAt)
                .ToList();
            var appraises = _isMeetingLeader
                ? allAppraises
                : allAppraises.Where(x => IsCurrentUser(x.ExpertId)).ToList();

            var summaries = await _registryContext.CaseSummaries.AsNoTracking()
                .Where(x => x.MeetingId == MeetingId && x.CaseId == CaseId)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();
            if (summaries.Count == 0 && _isMeetingLeader)
            {
                summaries.Add(CreateDraftSummary());
            }

            var summaryUserIds = summaries
                .Select(x => x.CreatedBy)
                .Append(_meetingLeaderId)
                .Where(x => !string.IsNullOrWhiteSpace(x));
            var summaryUsers = await LoadUserNamesAsync(summaryUserIds);
            foreach (var summary in summaries)
            {
                if (string.IsNullOrWhiteSpace(summary.ExpertName))
                {
                    summary.ExpertName = TryGetUserName(summary.CreatedBy ?? _meetingLeaderId, summaryUsers);
                }
            }

            _summaries.AddRange(summaries);

            var users = await LoadUserNamesAsync(appraises.Select(x => x.ExpertId));
            for (var i = 0; i < appraises.Count; i++)
            {
                var appraise = appraises[i];
                _appraises.Add(AppraiseBlock.FromEntity(
                    appraise,
                    GetUserName(appraise.ExpertId, users),
                    IsCurrentUser(appraise.ExpertId),
                    CanEditAppraise(appraise),
                    i == 0));
            }

            BuildStatistics(allAppraises);
            EnsureCasePreviewSelection();
            EnsureAppraiseSelection();
            EnsureReviewTab();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadCaseNamesAsync()
    {
        if (_registryContext == null || _case == null)
        {
            return;
        }

        var hospitalId = TryParseGuid(_case.HospitalId);
        if (hospitalId.HasValue)
        {
            _hospitalName = await _registryContext.SystemHospitals.AsNoTracking()
                .Where(x => x.Id == hospitalId.Value)
                .Select(x => x.Name)
                .FirstOrDefaultAsync();
        }

        var departmentId = TryParseGuid(_case.DepartmentId);
        if (departmentId.HasValue)
        {
            _departmentName = await _registryContext.SystemDepartments.AsNoTracking()
                .Where(x => x.Id == departmentId.Value)
                .Select(x => x.DisplayName ?? x.Name)
                .FirstOrDefaultAsync();
        }

        if (!string.IsNullOrWhiteSpace(_case.OperatorName) && !IsGuidText(_case.OperatorName))
        {
            _operatorName = _case.OperatorName;
            return;
        }

        var operatorId = TryParseGuid(_case.OperatorId) ?? TryParseGuid(_case.OperatorName);
        if (operatorId.HasValue)
        {
            _operatorName = await _registryContext.SystemUsers.AsNoTracking()
                .Where(x => x.Id == operatorId.Value)
                .Select(x => x.DisplayName == "" ? x.Account : x.DisplayName)
                .FirstOrDefaultAsync();
        }
    }

    private async Task LoadLeaderStateAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        var leader = await _registryContext.MeetingExperts.AsNoTracking()
            .Where(x => x.MeetingId == MeetingId && x.Level == 1)
            .OrderBy(x => x.Id)
            .FirstOrDefaultAsync();
        _meetingLeaderId = leader?.ExpertId;
        _isMeetingLeader = IsCurrentUser(_meetingLeaderId);
    }

    private async Task<Dictionary<Guid, string>> LoadUserNamesAsync(IEnumerable<string?> rawIds)
    {
        if (_registryContext == null)
        {
            return [];
        }

        var ids = rawIds
            .Select(TryParseGuid)
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .Distinct()
            .ToList();
        return ids.Count == 0
            ? []
            : await _registryContext.SystemUsers.AsNoTracking()
                .Where(x => ids.Contains(x.Id))
                .ToDictionaryAsync(x => x.Id, x => x.DisplayName == "" ? x.Account : x.DisplayName);
    }

    private void BuildCasePreviewSections()
    {
        if (_case == null)
        {
            return;
        }

        var basicFields = new List<CasePreviewField>
        {
            new("病案号", _case.PatientNumber),
            new("患者姓名", _case.PatientName),
            new("性别", ShowSex(_case.PatientSexText ?? _case.PatientSex)),
            new("年龄", _case.PatientAge),
            new("身份证号码", _case.IdNumber),
            new("住院科室", _departmentName ?? _case.DepartmentName ?? _case.DepartmentId),
            new("入院时间", FormatDate(_case.AdmissionTime)),
            new("出院时间", FormatDate(_case.DischargeTime)),
            new("住院天数", _case.HospitalStayDays?.ToString(CultureInfo.InvariantCulture)),
            new("手术类型", _case.DiseaseName ?? RegistryFixedCatalog.GetDiseaseName(_case.DiseaseId ?? _case.SurgeryTypeValue)),
            new("术者", _operatorName ?? _case.OperatorName ?? _case.OperatorId),
            new("是否急诊介入", RegistryFixedCatalog.GetYesNoName(_case.IsEmergencyIntervention)),
            new("情况说明/原因说明", RegistryFixedCatalog.GetSituationReasonName(_case.SituationReason)),
            new("离院方式", _case.DischargeMode)
        };

        if (ShouldShowCaseDeathTime(_case))
        {
            basicFields.Add(new("死亡时间", FormatDate(_case.DeathTime)));
        }

        if (ShouldShowCaseSituationSupplement(_case))
        {
            basicFields.Add(new("补充说明", _case.SituationSupplement));
        }

        if (GetDiseaseSpecificPreviewField() is { } diseaseSpecificField)
        {
            basicFields.Add(diseaseSpecificField);
        }

        AddCaseSection("case-basic", "患者基本信息", basicFields);
        AddCaseSection("case-summary", "病历摘要", [new("摘要内容", _case.CaseSummary, FullRow: true)]);
        AddCaseSection("case-discharge-diagnosis", "出院诊断", [new("出院诊断", _case.DischargeDiagnosis, FullRow: true)]);
        AddCaseSection("case-lab-exam", "相关实验室检查", [new("化验单图片上传", null, IsFile: true, FullRow: true)]);
        AddCaseSection("case-assist-exam", "主要辅助检查",
        [
            new("心电图图片上传", null, IsFile: true, FullRow: true),
            new("心脏彩超", null, IsFile: true, FullRow: true),
            new("其他检查", _case.OtherExam, FullRow: true)
        ]);
        AddCaseSection("case-intervention", "介入诊疗情况",
        [
            new("造影检查结果", _case.AngiographyResult, FullRow: true),
            new("介入经过", _case.InterventionProcess, FullRow: true)
        ]);
        AddCaseSection("case-rescue", "并发症救治情况", [new("救治经过", _case.RescueProcess, FullRow: true)]);
