    private RenderFragment ChoiceInput(AppraiseBlock appraise, IReadOnlyList<FixedOption> options, string? value, Action<string?> setter) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", appraise.CanEdit ? "review-choice-tags" : "review-choice-tags disabled");
        var sequence = 2;
        foreach (var option in options)
        {
            builder.OpenElement(sequence++, "button");
            builder.AddAttribute(sequence++, "type", "button");
            builder.AddAttribute(sequence++, "class", IsSameValue(value, option.Value) ? "review-choice-tag selected" : "review-choice-tag unselected");
            builder.AddAttribute(sequence++, "disabled", !appraise.CanEdit);
            builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => setter(IsSameValue(value, option.Value) ? null : option.Value)));
            builder.AddContent(sequence++, option.Text);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private RenderFragment TextInput(AppraiseBlock appraise, string? value, Action<string?> setter) => builder =>
    {
        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "class", "review-input");
        builder.AddAttribute(2, "type", "text");
        builder.AddAttribute(3, "value", value ?? "");
        builder.AddAttribute(4, "disabled", !appraise.CanEdit);
        builder.AddAttribute(5, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, args => setter(args.Value?.ToString())));
        builder.CloseElement();
    };

    private RenderFragment TextAreaInput(AppraiseBlock appraise, string? value, Action<string?> setter) => builder =>
    {
