    private static List<AppraisePdfSection> BuildAppraisePdfSections(AppraiseBlock appraise)
    {
        var sections = new List<AppraisePdfSection>
        {
            new("介入信息",
            [
                new("介入适应症", DisplayOption(IndicationOptions, appraise.Indication)),
                new("介入操作", DisplayOption(OperationOptions, appraise.Operation))
            ])
        };

        var manageFields = new List<AppraisePdfField>
        {
            new("设备器械配套是否齐全", DisplayOption(CompleteOptions, appraise.DeviceComplete)),
            new("介入分级手术管理是否落实到位", RegistryFixedCatalog.GetYesNoName(appraise.SurgeryLevelImplemented)),
            new("是否存在其他管理问题", RegistryFixedCatalog.GetYesNoName(appraise.HasManagementProblem))
        };
        if (ShouldShowManagementProblemDescription(appraise))
        {
            manageFields.Add(new("其他管理问题描述", appraise.ManagementProblemDescription, true));
        }

        sections.Add(new("医院管理", manageFields));
        sections.Add(new("并发症救治",
        [
            new("救治是否及时", RegistryFixedCatalog.GetYesNoName(appraise.RescueTimely)),
            new("救治措施是否得当", RegistryFixedCatalog.GetYesNoName(appraise.RescueMeasureProper)),
            new("救治药品设备是否齐全", DisplayOption(CompleteOptions, appraise.RescueDeviceComplete))
        ]));

        var deathFields = new List<AppraisePdfField>
        {
            new("死亡原因", DisplayOption(DeathReasonOptions, appraise.DeathReason))
        };
        if (ShouldShowOtherDeathReason(appraise))
        {
            deathFields.Add(new("其他死亡原因", appraise.OtherDeathReason));
        }

        sections.Add(new("死亡信息", deathFields));
        var improveFields = new List<AppraisePdfField>
        {
            new("是否需要提交进一步改进措施", RegistryFixedCatalog.GetYesNoName(appraise.NeedImprovement))
