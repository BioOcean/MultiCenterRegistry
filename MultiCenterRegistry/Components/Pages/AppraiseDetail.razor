@page "/meetings/{MeetingId:guid}/cases/{CaseId:guid}/appraise"
@inherits BasePage

<PageTitle>@(_case == null ? "病例评审" : $"{_case.PatientName} - 病例评审")</PageTitle>

<div class="appraise-page">
    <div class="detail-header appraise-detail-header">
        <MudIconButton Class="appraise-back-button"
                       Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Primary"
                       Size="Size.Medium"
                       title="返回会议"
                       OnClick="BackToMeeting" />
        <div class="appraise-title-block">
            <h1>@(_case?.PatientName ?? "病例评审")</h1>
            @if (_case != null)
            {
                <div class="appraise-top-info">
                    @foreach (var item in BuildHeaderItems())
                    {
                        <span><strong>@item.Label：</strong>@ShowValue(item.Value)</span>
                    }
                </div>
            }
        </div>
        @if (_case != null)
        {
            <div class="appraise-header-actions">
                <span class="status-pill @GetSubStatusClass(_case.SubStatus)">@GetSubStatusText(_case.SubStatus)</span>
            </div>
        }
    </div>

    @if (_isLoading)
    {
        <MudPaper Class="loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>正在加载病例评审</span>
        </MudPaper>
    }
    else if (_meeting == null || _case == null)
    {
        <MudPaper Class="loading-panel" Elevation="0">未找到会议或病例</MudPaper>
    }
    else
    {
        <div class="appraise-workspace">
            <section class="appraise-case-column">
        <div class="case-preview-panel">
            @if (_caseForms.Count == 0)
            {
                <div class="empty-line">该病例暂无表单数据</div>
            }
            else
            {
                <div class="case-form-layout">
                    <nav class="case-form-nav">
                        <button type="button"
                                class="@GetCasePreviewNavClass(CasePreviewAllKey)"
                                @onclick="@(() => SelectCasePreviewSection(CasePreviewAllKey))">
                            <span class="form-nav-dot"></span>
                            <span class="form-nav-text">全部</span>
                            <span class="form-nav-count">@GetCasePreviewFieldCount(CasePreviewAllKey)</span>
                        </button>
                        @foreach (var previewSection in GetCasePreviewSections())
                        {
                            <button type="button"
                                    class="@GetCasePreviewNavClass(previewSection.Key)"
                                    title="@previewSection.Title"
                                    @onclick="@(() => SelectCasePreviewSection(previewSection.Key))">
                                <span class="form-nav-dot"></span>
                                <span class="form-nav-text">@previewSection.Title</span>
                                <span class="form-nav-count">@previewSection.Fields.Count</span>
                            </button>
                        }
                    </nav>
                    <div class="case-pdf-view">
                        <div class="case-pdf-page">
                        @foreach (var previewSection in GetSelectedCasePreviewSections())
                        {
                            <section class="case-pdf-section">
                                <h3>@previewSection.Title</h3>
                                @foreach (var field in previewSection.Fields)
                                {
                                    <div class="@GetPdfQuestionClass(field)">
                                        <div class="pdf-question-name">@field.FieldName</div>
                                        <div class="pdf-question-value">
                                            @if (field.IsFile)
                                            {
                                                @RenderPreviewFiles(field)
                                            }
                                            else
                                            {
                                                @ShowValue(GetDisplayValue(field))
                                            }
                                        </div>
                                    </div>
                                }
                            </section>
                        }
                        </div>
                    </div>
                </div>
            }
        </div>
            </section>

            <section class="appraise-review-column">
                <div class="review-shell">
                    <nav class="review-mode-tabs">
                        <button type="button" class="@GetReviewTabClass(ReviewTabAppraise)" @onclick="@(() => SelectReviewTab(ReviewTabAppraise))">评审</button>
                        <button type="button" class="@GetReviewTabClass(ReviewTabSummary)" @onclick="@(() => SelectReviewTab(ReviewTabSummary))">汇总</button>
                    </nav>
                    <div class="review-content-panel">
                        @if (_activeReviewTab == ReviewTabAppraise)
                        {
                            @if (_appraises.Count == 0)
                            {
                                <div class="empty-line">暂无评审</div>
                            }
                            else
                            {
                                <div class="expert-tabs">
                                    @foreach (var appraise in _appraises)
                                    {
                                        <button type="button"
                                                class="@GetExpertTabClass(appraise)"
                                                @onclick="@(() => SelectAppraise(appraise.Id))">
                                            @ShowValue(appraise.ExpertName)
                                        </button>
                                    }
                                </div>

                                @if (SelectedAppraise is { } selectedAppraise)
                                {
                                    <div class="selected-appraise-head">
                                        <strong>@ShowValue(selectedAppraise.ExpertName)</strong>
                                        <span>@GetAppraiseStatusText(selectedAppraise.Status)</span>
                                        <em>@FormatDateTime(selectedAppraise.UpdatedAt ?? selectedAppraise.CreatedAt)</em>
                                    </div>

                                    @if (selectedAppraise.Forms.Count == 0)
                                    {
                                        <div class="empty-line">该专家暂无评审表单数据</div>
                                    }
                                    else
                                    {
                                        <div class="review-form-list">
                                            @foreach (var form in selectedAppraise.Forms)
                                            {
                                                @foreach (var reviewSection in GetReviewFormSections(form))
                                                {
                                                    var sectionKey = GetReviewSectionKey(selectedAppraise, form, reviewSection);
                                                    <section class="review-form-section">
                                                        <button type="button" class="review-section-header" @onclick="@(() => ToggleReviewSection(sectionKey))">
                                                            <span>@reviewSection.Title</span>
                                                            <em>@(IsReviewSectionCollapsed(sectionKey) ? "展开" : "收起")</em>
                                                        </button>
                                                        @if (!IsReviewSectionCollapsed(sectionKey))
                                                        {
                                                            <div class="review-question-grid">
                                                                @foreach (var field in reviewSection.Fields)
                                                                {
                                                                    <div class="@GetReviewQuestionClass(field)">
                                                                        <div class="review-question-title">@field.FieldName</div>
                                                                        <div class="review-question-control">
                                                                            @RenderReviewField(selectedAppraise, field)
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                    </section>
                                                }
                                            }
                                        </div>
                                    }

                                    @if (selectedAppraise.CanEdit)
                                    {
                                        <div class="review-bottom-actions">
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SaveAppraiseFormsAsync">保存</MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => SubmitAppraiseAsync(selectedAppraise.Id))">提交</MudButton>
                                        </div>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <MudPaper Class="section-panel appraise-section-panel appraise-summary-section" Elevation="0">
                                <div class="panel-title">
                                    <h2>评审汇总</h2>
                                    <span>@_summaries.Count 条</span>
                                </div>
                                @if (_summaries.Count == 0)
                                {
                                    <div class="empty-line">暂无汇总</div>
                                }
                                else
                                {
                                    <div class="summary-list">
                                        @foreach (var summary in _summaries)
                                        {
                                            <div class="summary-note">
                                                <div class="note-head">
                                                    <strong>@ShowValue(summary.ExpertName)</strong>
                                                    <span>@GetSummaryStatusText(summary.Status)</span>
                                                </div>
                                                @if (CanEditSummary(summary))
                                                {
                                                    <MudTextField T="string"
                                                                  @bind-Value="summary.Content"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Lines="4" />
                                                    <div class="inline-actions">
                                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="@(() => SaveSummaryAsync(summary))">保存汇总</MudButton>
                                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Upload" OnClick="@(() => SubmitSummaryAsync(summary))">提交汇总</MudButton>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="note-content">@ShowValue(summary.Content)</div>
                                                }
                                                <div class="muted">@FormatDateTime(summary.CreatedAt)</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </MudPaper>

                            <MudPaper Class="section-panel appraise-section-panel appraise-stat-section" Elevation="0">
                                <div class="panel-title">
                                    <h2>答案统计</h2>
                                    <span>@_statistics.Count 个字段</span>
                                </div>
                                @if (_statistics.Count == 0)
                                {
                                    <div class="empty-line">暂无可统计答案</div>
                                }
                                else
                                {
                                    <div class="stat-grid">
                                        @foreach (var item in _statistics)
                                        {
                                            <div class="stat-card">
                                                <div class="field-name">@item.FieldName</div>
                                                @foreach (var option in item.Options)
                                                {
                                                    <div class="stat-row">
                                                        <span>@option.Text</span>
                                                        <em>@option.Count 人</em>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </MudPaper>

                            @if (_votes.Count > 0)
                            {
                                <MudPaper Class="section-panel appraise-section-panel appraise-vote-section" Elevation="0">
                                    <div class="panel-title">
                                        <h2>投票记录</h2>
                                        <span>@_votes.Count 条</span>
                                    </div>
                                    <div class="vote-list">
                                        @foreach (var vote in _votes)
                                        {
                                            <div class="vote-item">
                                                <strong>@ShowValue(vote.ExpertName)</strong>
                                                <span>@(vote.Agreed ? "同意" : "不同意")</span>
                                                <em>@ShowValue(vote.Content)</em>
                                            </div>
                                        }
                                    </div>
                                </MudPaper>
                            }
                        }
                    </div>
                </div>
            </section>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_previewImageUrl))
    {
        <div class="image-preview-mask" role="presentation" @onclick="CloseImagePreview">
            <div class="image-preview-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
                <button type="button" class="image-preview-close" title="关闭" @onclick="CloseImagePreview">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
                <img src="@_previewImageUrl" alt="@_previewImageTitle" />
            </div>
        </div>
    }
</div>

@code {
    private const string CasePreviewAllKey = "all";
    private const string ReviewTabAppraise = "appraise";
    private const string ReviewTabSummary = "summary";

    [Parameter]
    public Guid MeetingId { get; set; }

    [Parameter]
    public Guid CaseId { get; set; }

    private ReviewMeeting? _meeting;
    private RegistryCase? _case;
    private readonly List<FormBlock> _caseForms = [];
    private readonly List<AppraiseBlock> _appraises = [];
    private readonly List<CaseSummary> _summaries = [];
    private readonly List<CaseVote> _votes = [];
    private readonly List<FieldStatistic> _statistics = [];
    private string? _hospitalName;
    private string? _departmentName;
    private string _selectedCasePreviewSectionKey = CasePreviewAllKey;
    private string _activeReviewTab = ReviewTabAppraise;
    private Guid? _selectedAppraiseId;
    private string? _previewImageUrl;
    private string? _previewImageTitle;
    private bool _isLoading = true;
    private bool _isMeetingLeader;
    private readonly HashSet<string> _collapsedReviewSections = [];

    protected override Task OnPageInitializedAsync() => LoadAppraiseAsync();

    private async Task LoadAppraiseAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _meeting = await _registryContext.ReviewMeetings.AsNoTracking().FirstOrDefaultAsync(x => x.Id == MeetingId);
            _case = await _registryContext.Cases.AsNoTracking().FirstOrDefaultAsync(x => x.Id == CaseId);
            _caseForms.Clear();
            _appraises.Clear();
            _summaries.Clear();
            _votes.Clear();
            _statistics.Clear();
            _hospitalName = null;
            _departmentName = null;
            _isMeetingLeader = false;
            if (_meeting == null || _case == null)
            {
                return;
            }

            await LoadCaseNamesAsync();
            await LoadLeaderStateAsync();
            await LoadCaseFormsAsync();

            var appraises = await _registryContext.CaseAppraises.AsNoTracking()
                .Where(x => x.MeetingId == MeetingId && x.CaseId == CaseId)
                .OrderBy(x => x.Status)
                .ThenBy(x => x.CreatedAt)
                .ToListAsync();
            appraises = appraises
                .OrderByDescending(x => IsCurrentUser(x.ExpertId))
                .ThenBy(x => x.Status)
                .ThenBy(x => x.CreatedAt)
                .ToList();
            var appraiseIds = appraises.Select(x => x.Id).ToList();

            var summaries = await _registryContext.CaseSummaries.AsNoTracking()
                .Where(x => x.MeetingId == MeetingId && x.CaseId == CaseId)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();
            _summaries.AddRange(summaries);

            var summaryIds = summaries.Select(x => x.Id).ToList();
            if (summaryIds.Count > 0)
            {
                var votes = await _registryContext.CaseVotes.AsNoTracking()
                    .Where(x => x.MeetingId == MeetingId && x.CaseId == CaseId && summaryIds.Contains(x.SummaryId))
                    .OrderByDescending(x => x.CreatedAt)
                    .ToListAsync();
                _votes.AddRange(votes);
            }

            var users = await LoadUserNamesAsync(appraises.Select(x => x.ExpertId));
            var instances = appraiseIds.Count == 0
                ? []
                : await _registryContext.FormInstances.AsNoTracking()
                    .Where(x => x.OwnerType == "appraise" && appraiseIds.Contains(x.OwnerId))
                    .OrderBy(x => x.CreatedAt)
                    .ToListAsync();
            var instanceIds = instances.Select(x => x.Id).ToList();

            var templateIds = instances.Select(x => x.FormTemplateId).Distinct().ToList();
            var templates = templateIds.Count == 0
                ? new Dictionary<Guid, RegistryFormTemplate>()
                : await _registryContext.FormTemplates.AsNoTracking()
                    .Where(x => templateIds.Contains(x.Id))
                    .ToDictionaryAsync(x => x.Id);

            var values = instanceIds.Count == 0
                ? []
                : await _registryContext.FormFieldValues.AsNoTracking()
                    .Where(x => instanceIds.Contains(x.FormInstanceId))
                    .OrderBy(x => x.Sort)
                    .ThenBy(x => x.StorageKey)
                    .ToListAsync();

            var definitionIds = values
                .Where(x => x.FormFieldDefinitionId.HasValue)
                .Select(x => x.FormFieldDefinitionId!.Value)
                .Distinct()
                .ToList();
            var definitions = definitionIds.Count == 0
                ? new Dictionary<Guid, RegistryFormFieldDefinition>()
                : await _registryContext.FormFieldDefinitions.AsNoTracking()
                    .Where(x => definitionIds.Contains(x.Id))
                    .ToDictionaryAsync(x => x.Id);

            var valueIds = values.Select(x => x.Id).ToList();
            var files = valueIds.Count == 0
                ? []
                : await _registryContext.Files.AsNoTracking()
                    .Where(x => x.OwnerType == "form_field_value" && valueIds.Contains(x.OwnerId))
                    .OrderBy(x => x.CreatedAt)
                    .ThenBy(x => x.FileName)
                    .ToListAsync();
            var filesByValue = files
                .GroupBy(x => x.OwnerId)
                .ToDictionary(x => x.Key, x => x.ToList());

            BuildAppraiseBlocks(appraises, users, instances, templates, values, definitions, filesByValue);
            BuildStatistics(values, definitions);
            EnsureCasePreviewSelection();
            EnsureAppraiseSelection();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadCaseNamesAsync()
    {
        if (_registryContext == null || _case == null)
        {
            return;
        }

        var hospitalId = TryParseGuid(_case.HospitalId);
        if (hospitalId.HasValue)
        {
            _hospitalName = await _registryContext.SystemHospitals.AsNoTracking()
                .Where(x => x.Id == hospitalId.Value)
                .Select(x => x.Name)
                .FirstOrDefaultAsync();
        }

        var departmentId = TryParseGuid(_case.DepartmentId);
        if (departmentId.HasValue)
        {
            _departmentName = await _registryContext.SystemDepartments.AsNoTracking()
                .Where(x => x.Id == departmentId.Value)
                .Select(x => x.DisplayName ?? x.Name)
                .FirstOrDefaultAsync();
        }
    }

    private async Task LoadLeaderStateAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isMeetingLeader = await _registryContext.MeetingExperts.AsNoTracking()
            .AnyAsync(x => x.MeetingId == MeetingId && x.Level == 1 && x.ExpertId == CurrentUserId);
    }

    private async Task LoadCaseFormsAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        var instances = await _registryContext.FormInstances.AsNoTracking()
            .Where(x => x.OwnerType == "case" && x.OwnerId == CaseId)
            .OrderBy(x => x.CreatedAt)
            .ToListAsync();
        var instanceIds = instances.Select(x => x.Id).ToList();
        if (instanceIds.Count == 0)
        {
            return;
        }

        var templateIds = instances.Select(x => x.FormTemplateId).Distinct().ToList();
        var templates = await _registryContext.FormTemplates.AsNoTracking()
            .Where(x => templateIds.Contains(x.Id))
            .ToDictionaryAsync(x => x.Id);

        var values = await _registryContext.FormFieldValues.AsNoTracking()
            .Where(x => instanceIds.Contains(x.FormInstanceId))
            .OrderBy(x => x.Sort)
            .ThenBy(x => x.StorageKey)
            .ToListAsync();

        var definitionIds = values
            .Where(x => x.FormFieldDefinitionId.HasValue)
            .Select(x => x.FormFieldDefinitionId!.Value)
            .Distinct()
            .ToList();
        var definitions = definitionIds.Count == 0
            ? new Dictionary<Guid, RegistryFormFieldDefinition>()
            : await _registryContext.FormFieldDefinitions.AsNoTracking()
                .Where(x => definitionIds.Contains(x.Id))
                .ToDictionaryAsync(x => x.Id);

        var valueIds = values.Select(x => x.Id).ToList();
        var files = valueIds.Count == 0
            ? []
            : await _registryContext.Files.AsNoTracking()
                .Where(x => x.OwnerType == "form_field_value" && valueIds.Contains(x.OwnerId))
                .OrderBy(x => x.CreatedAt)
                .ThenBy(x => x.FileName)
                .ToListAsync();
        var filesByValue = files
            .GroupBy(x => x.OwnerId)
            .ToDictionary(x => x.Key, x => x.ToList());

        foreach (var instance in instances)
        {
            var fields = values
                .Where(x => x.FormInstanceId == instance.Id)
                .Select(value => CreateFieldItem(value, definitions, filesByValue))
                .ToList();

            var name = templates.TryGetValue(instance.FormTemplateId, out var template)
                ? template.FormName
                : "病例表单";
            _caseForms.Add(new FormBlock(name, fields, instance.CreatedAt));
        }
    }

    private async Task<Dictionary<Guid, string>> LoadUserNamesAsync(IEnumerable<string?> rawIds)
    {
        if (_registryContext == null)
        {
            return [];
        }

        var ids = rawIds
            .Select(TryParseGuid)
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .Distinct()
            .ToList();
        return ids.Count == 0
            ? []
            : await _registryContext.SystemUsers.AsNoTracking()
                .Where(x => ids.Contains(x.Id))
                .ToDictionaryAsync(x => x.Id, x => x.DisplayName);
    }

    private void BuildAppraiseBlocks(
        List<CaseAppraise> appraises,
        IReadOnlyDictionary<Guid, string> users,
        List<RegistryFormInstance> instances,
        IReadOnlyDictionary<Guid, RegistryFormTemplate> templates,
        List<RegistryFormFieldValue> values,
        IReadOnlyDictionary<Guid, RegistryFormFieldDefinition> definitions,
        IReadOnlyDictionary<Guid, List<RegistryFile>> filesByValue)
    {
        for (var i = 0; i < appraises.Count; i++)
        {
            var appraise = appraises[i];
            var forms = new List<FormBlock>();
            foreach (var instance in instances.Where(x => x.OwnerId == appraise.Id))
            {
                var fields = values
                    .Where(x => x.FormInstanceId == instance.Id)
                    .Select(value => CreateFieldItem(value, definitions, filesByValue))
                    .ToList();

                var name = templates.TryGetValue(instance.FormTemplateId, out var template)
                    ? template.FormName
                    : "评审表单";
                forms.Add(new FormBlock(name, fields));
            }

            var canEdit = HasPermission(PermissionConstants.AppraiseEdit)
                && appraise.Status == 0
                && IsCurrentUser(appraise.ExpertId);
            _appraises.Add(new AppraiseBlock(
                appraise.Id,
                appraise.ExpertId,
                GetUserName(appraise.ExpertId, users),
                appraise.Status,
                appraise.CreatedAt,
                appraise.UpdatedAt,
                IsCurrentUser(appraise.ExpertId),
                canEdit,
                i == 0,
                forms));
        }
    }

    private static FieldItem CreateFieldItem(
        RegistryFormFieldValue value,
        IReadOnlyDictionary<Guid, RegistryFormFieldDefinition> definitions,
        IReadOnlyDictionary<Guid, List<RegistryFile>> filesByValue)
    {
        RegistryFormFieldDefinition? definition = null;
        if (value.FormFieldDefinitionId.HasValue)
        {
            definitions.TryGetValue(value.FormFieldDefinitionId.Value, out definition);
        }

        filesByValue.TryGetValue(value.Id, out var fieldFiles);
        return new FieldItem(
            value.Id,
            value.FieldName,
            value.FieldValue,
            value.FieldText,
            definition?.ControlType,
            definition?.Level ?? 2,
            value.Sort,
            definition?.DefaultOptions,
            fieldFiles ?? []);
    }

    private void BuildStatistics(
        List<RegistryFormFieldValue> values,
        IReadOnlyDictionary<Guid, RegistryFormFieldDefinition> definitions)
    {
        var rows = values
            .Select(value =>
            {
                RegistryFormFieldDefinition? definition = null;
                if (value.FormFieldDefinitionId.HasValue)
                {
                    definitions.TryGetValue(value.FormFieldDefinitionId.Value, out definition);
                }

                return new
                {
                    value.FieldName,
                    Value = FormValueDisplayMapper.GetDisplayText(value.FieldName, value.FieldText, value.FieldValue),
                    Level = definition?.Level ?? 2,
                    value.Sort
                };
            })
            .Where(x => x.Level > 1 && !string.IsNullOrWhiteSpace(x.Value))
            .ToList();

        var statistics = rows
            .GroupBy(x => x.FieldName)
            .Select(group => new
            {
                FieldName = group.Key,
                Sort = group.Min(x => x.Sort),
                Options = group
                    .GroupBy(x => x.Value!.Trim())
                    .Select(x => new FieldStatisticOption(x.Key, x.Count()))
                    .OrderByDescending(x => x.Count)
                    .ThenBy(x => x.Text)
                    .Take(8)
                    .ToList()
            })
            .Where(x => x.Options.Count > 0)
            .OrderBy(x => x.Sort)
            .ThenBy(x => x.FieldName)
            .Take(80)
            .Select(x => new FieldStatistic(x.FieldName, x.Options))
            .ToList();

        _statistics.AddRange(statistics);
    }

    private void EnsureCasePreviewSelection()
    {
        if (_selectedCasePreviewSectionKey == CasePreviewAllKey)
        {
            return;
        }

        if (GetCasePreviewSections().All(x => x.Key != _selectedCasePreviewSectionKey))
        {
            _selectedCasePreviewSectionKey = CasePreviewAllKey;
        }
    }

    private void EnsureAppraiseSelection()
    {
        if (_selectedAppraiseId.HasValue && _appraises.Any(x => x.Id == _selectedAppraiseId.Value))
        {
            return;
        }

        _selectedAppraiseId = CurrentAppraise?.Id ?? _appraises.FirstOrDefault()?.Id;
    }

    private AppraiseBlock? SelectedAppraise
        => _selectedAppraiseId.HasValue
            ? _appraises.FirstOrDefault(x => x.Id == _selectedAppraiseId.Value) ?? _appraises.FirstOrDefault()
            : _appraises.FirstOrDefault();

    private void SelectCasePreviewSection(string key) => _selectedCasePreviewSectionKey = key;

    private void SelectReviewTab(string tab) => _activeReviewTab = tab;

    private void SelectAppraise(Guid id) => _selectedAppraiseId = id;

    private string GetCasePreviewNavClass(string key)
        => _selectedCasePreviewSectionKey == key ? "form-nav-link active" : "form-nav-link";

    private string GetReviewTabClass(string tab)
        => _activeReviewTab == tab ? "review-mode-tab active" : "review-mode-tab";

    private string GetExpertTabClass(AppraiseBlock appraise)
        => SelectedAppraise?.Id == appraise.Id ? "expert-tab active" : "expert-tab";

    private List<CasePreviewSection> GetCasePreviewSections()
    {
        var sections = new List<CasePreviewSection>();
        var index = 0;
        foreach (var form in _caseForms)
        {
            CasePreviewSection? current = null;
            foreach (var field in form.Fields)
            {
                if (field.IsSection)
                {
                    current = new CasePreviewSection($"case-section-{index++}", field.FieldName);
                    sections.Add(current);
                    continue;
                }

                current ??= new CasePreviewSection($"case-section-{index++}", form.Name);
                if (!sections.Contains(current))
                {
                    sections.Add(current);
                }

                current.Fields.Add(field);
            }
        }

        return sections
            .Select(section =>
            {
                var visibleSection = new CasePreviewSection(section.Key, section.Title);
                visibleSection.Fields.AddRange(section.Fields.Where(field => IsVisibleCasePreviewField(section, field)));
                return visibleSection;
            })
            .Where(x => x.Fields.Count > 0)
            .ToList();
    }

    private List<CasePreviewSection> GetSelectedCasePreviewSections()
    {
        var sections = GetCasePreviewSections();
        if (_selectedCasePreviewSectionKey == CasePreviewAllKey)
        {
            return sections;
        }

        var selected = sections.FirstOrDefault(x => x.Key == _selectedCasePreviewSectionKey);
        return selected == null ? sections : [selected];
    }

    private int GetCasePreviewFieldCount(string key)
    {
        var sections = GetCasePreviewSections();
        return key == CasePreviewAllKey
            ? sections.Sum(x => x.Fields.Count)
            : sections.FirstOrDefault(x => x.Key == key)?.Fields.Count ?? 0;
    }

    private static string GetPdfQuestionClass(FieldItem field)
        => field.IsFile || IsLongTextField(field) ? "pdf-question full-row" : "pdf-question";

    private bool IsVisibleCasePreviewField(CasePreviewSection section, FieldItem field)
    {
        if (IsCaseComplicationFollowupField(section, field))
        {
            return IsCaseFieldSelected("是否组织医院或科室并发症讨论", "1", "是");
        }

        if (field.FieldName.Equals("冠心病介入", StringComparison.OrdinalIgnoreCase))
        {
            return IsCaseFieldSelected("手术类型", "6237DD62-15B9-4676-972D-BF32476B3546", "冠心病介入")
                   || IsCaseFieldSelected("手术类别", "6237DD62-15B9-4676-972D-BF32476B3546", "冠心病介入");
        }

        if (field.FieldName.Equals("死亡时间", StringComparison.OrdinalIgnoreCase))
        {
            return IsCaseFieldSelected("离院方式", "死亡", "死亡");
        }

        if (field.FieldName.Equals("补充说明", StringComparison.OrdinalIgnoreCase))
        {
            return IsCaseFieldSelected("情况说明/原因说明", "4", "其他")
                   || IsCaseFieldSelected("情况/原因说明", "4", "其他");
        }

        return true;
    }

    private static bool IsCaseComplicationFollowupField(CasePreviewSection section, FieldItem field)
    {
        if (!section.Title.Contains("并发症讨论", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var controller = section.Fields.FirstOrDefault(x => x.FieldName.Equals("是否组织医院或科室并发症讨论", StringComparison.OrdinalIgnoreCase));
        return controller != null && field.Sort > controller.Sort;
    }

    private bool IsCaseFieldSelected(string fieldName, string rawValue, string displayValue)
    {
        var field = _caseForms.SelectMany(x => x.Fields)
            .LastOrDefault(x => x.FieldName.Equals(fieldName, StringComparison.OrdinalIgnoreCase));
        if (field == null)
        {
            return false;
        }

        return SplitChoiceValues(GetRawEditValue(field)).Any(x =>
            IsSameOptionValue(x, rawValue)
            || IsSameOptionValue(x, displayValue)
            || IsSameOptionValue(FormValueDisplayMapper.Normalize(field.FieldName, x), displayValue));
    }

    private RenderFragment RenderPreviewFiles(FieldItem field) => @<div class="pdf-file-list">
        @if (field.Files.Count == 0)
        {
            <span class="muted">暂无附件</span>
        }
        else
        {
            @foreach (var file in field.Files)
            {
                if (IsImageFile(file))
                {
                    <button type="button" class="pdf-image-thumb" title="@file.FileName" @onclick="@(() => OpenImagePreview(file))">
                        <img src="@GetFileUrl(file, false)" alt="@file.FileName" />
                    </button>
                }
                else
                {
                    <a class="pdf-file-link" href="@GetFileUrl(file, false)" target="_blank" title="@file.FileName">
                        <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                        <span>@file.FileName</span>
                    </a>
                }
            }
        }
    </div>;

    private List<ReviewFormSection> GetReviewFormSections(FormBlock form)
    {
        var sections = new List<ReviewFormSection>();
        var index = 0;
        ReviewFormSection? current = null;
        foreach (var field in form.Fields)
        {
            if (field.IsSection)
            {
                current = new ReviewFormSection($"review-section-{index++}", field.FieldName);
                sections.Add(current);
                continue;
            }

            current ??= new ReviewFormSection($"review-section-{index++}", form.Name);
            if (!sections.Contains(current))
            {
                sections.Add(current);
            }

            current.Fields.Add(field);
        }

        return sections.Where(x => x.Fields.Count > 0).ToList();
    }

    private static string GetReviewSectionKey(AppraiseBlock appraise, FormBlock form, ReviewFormSection section)
        => $"{appraise.Id:N}:{form.Name}:{section.Key}";

    private bool IsReviewSectionCollapsed(string key) => _collapsedReviewSections.Contains(key);

    private void ToggleReviewSection(string key)
    {
        if (!_collapsedReviewSections.Add(key))
        {
            _collapsedReviewSections.Remove(key);
        }
    }

    private RenderFragment RenderReviewField(AppraiseBlock appraise, FieldItem field) => @<div>
        @if (field.IsFile)
        {
            @RenderPreviewFiles(field)
        }
        else if (IsChoiceField(field))
        {
            <div class="review-choice-tags">
                @foreach (var option in GetFieldOptions(field))
                {
                    <button type="button"
                            class="@GetReviewChoiceClass(field, option)"
                            disabled="@IsReviewFieldDisabled(appraise)"
                            @onclick="@(() => SetChoiceValue(appraise, field, option))">@option.Text</button>
                }
                @if (GetFieldOptions(field).Count == 0)
                {
                    <span class="review-choice-tag disabled">@GetDisplayValue(field)</span>
                }
            </div>
        }
        else if (IsLongTextField(field))
        {
            <textarea class="review-textarea"
                      value="@GetReviewInputValue(field)"
                      disabled="@IsReviewFieldDisabled(appraise)"
                      rows="@GetTextareaRows(field)"
                      @oninput="@((ChangeEventArgs args) => field.EditValue = args.Value?.ToString())"></textarea>
        }
        else
        {
            <input class="@GetReviewInputClass(field)"
                   type="@GetInputType(field)"
                   value="@GetReviewInputValue(field)"
                   disabled="@IsReviewFieldDisabled(appraise)"
                   @onchange="@((ChangeEventArgs args) => field.EditValue = args.Value?.ToString())" />
        }
    </div>;

    private static bool IsReviewFieldDisabled(AppraiseBlock appraise) => !appraise.CanEdit;

    private static bool IsChoiceField(FieldItem field) => field.ControlType is 2 or 3 || GetFieldOptions(field).Count > 0;

    private static bool IsLongTextField(FieldItem field) => field.ControlType == 10;

    private static bool IsDateField(FieldItem field)
        => field.ControlType == 4
           || field.FieldName.Contains("时间", StringComparison.OrdinalIgnoreCase)
           || field.FieldName.Contains("日期", StringComparison.OrdinalIgnoreCase);

    private static string GetInputType(FieldItem field) => IsDateField(field) ? "date" : "text";

    private static string GetReviewInputValue(FieldItem field)
        => IsDateField(field) ? NormalizeDateValue(GetRawEditValue(field)) : GetRawEditValue(field);

    private static string GetReviewInputClass(FieldItem field)
    {
        var classes = new List<string> { "review-input" };
        if (IsDateField(field))
        {
            classes.Add("date-input");
            if (string.IsNullOrWhiteSpace(GetReviewInputValue(field)))
            {
                classes.Add("date-empty");
            }
        }

        return string.Join(" ", classes);
    }

    private static string GetReviewQuestionClass(FieldItem field)
        => field.IsFile || IsLongTextField(field) ? "review-question full-row" : "review-question";

    private static string GetReviewChoiceClass(FieldItem field, FieldOption option)
    {
        var classes = new List<string> { "review-choice-tag" };
        classes.Add(IsOptionSelected(field, option) ? "selected" : "unselected");
        return string.Join(" ", classes);
    }

    private static IReadOnlyList<FieldOption> GetFieldOptions(FieldItem field)
    {
        var name = field.FieldName.Trim();
        if (name.Contains("适应症", StringComparison.OrdinalIgnoreCase))
        {
            return [new("1", "合理"), new("2", "欠合理"), new("3", "不合理")];
        }

        if (name.Contains("介入操作", StringComparison.OrdinalIgnoreCase))
        {
            return [new("1", "规范"), new("2", "欠规范"), new("3", "不规范"), new("4", "极不规范")];
        }

        if (name.Contains("齐全", StringComparison.OrdinalIgnoreCase))
        {
            return [new("1", "齐全"), new("2", "不齐全")];
        }

        if (name.Equals("死亡原因", StringComparison.OrdinalIgnoreCase))
        {
            return [new("1", "疾病相关"), new("2", "药物相关"), new("3", "操作相关"), new("4", "器械相关"), new("5", "其他")];
        }

        if (name.Contains("是否", StringComparison.OrdinalIgnoreCase) || field.DefaultOptions == "11")
        {
            return [new("1", "是"), new("2", "否")];
        }

        return [];
    }

    private static bool IsOptionSelected(FieldItem field, FieldOption option)
    {
        var values = SplitChoiceValues(GetRawEditValue(field)).ToList();
        return values.Any(x =>
            IsSameOptionValue(x, option.Value)
            || IsSameOptionValue(x, option.Text)
            || IsSameOptionValue(FormValueDisplayMapper.Normalize(field.FieldName, x), option.Text));
    }

    private static void SetChoiceValue(AppraiseBlock appraise, FieldItem field, FieldOption option)
    {
        if (IsReviewFieldDisabled(appraise))
        {
            return;
        }

        if (field.ControlType != 3)
        {
            field.EditValue = option.Text;
            return;
        }

        var values = SplitChoiceValues(field.EditValue).ToList();
        var existed = values.Any(x => IsSameOptionValue(x, option.Value) || IsSameOptionValue(x, option.Text));
        values = existed
            ? values.Where(x => !IsSameOptionValue(x, option.Value) && !IsSameOptionValue(x, option.Text)).ToList()
            : [.. values, option.Text];
        field.EditValue = values.Count == 0 ? null : string.Join(",", values);
    }

    private static int GetTextareaRows(FieldItem field)
    {
        var value = GetReviewInputValue(field);
        return Math.Clamp((value.Length / 90) + 3, 3, 10);
    }

    private static string GetRawEditValue(FieldItem field)
        => field.EditValue?.Trim()
           ?? field.FieldText?.Trim()
           ?? field.FieldValue?.Trim()
           ?? "";

    private static IEnumerable<string> SplitChoiceValues(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(['、', ',', '，', ';', '；', '|', '\n', '\r'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static bool IsSameOptionValue(string? left, string? right)
        => NormalizeOptionValue(left).Equals(NormalizeOptionValue(right), StringComparison.OrdinalIgnoreCase);

    private static string NormalizeOptionValue(string? value)
        => value?.Trim().Trim('{', '}').ToUpperInvariant() ?? "";

    private static string NormalizeDateValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "";
        }

        var text = value.Trim();
        if (DateTime.TryParse(text, out var date))
        {
            return date.ToString("yyyy-MM-dd");
        }

        return text.Length >= 10 ? text[..10] : text;
    }

    private static bool IsImageFile(RegistryFile file)
    {
        if (!string.IsNullOrWhiteSpace(file.ContentType) && file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var extension = System.IO.Path.GetExtension(file.FileName);
        return extension.Equals(".jpg", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".jpeg", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".png", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".gif", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".bmp", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".webp", StringComparison.OrdinalIgnoreCase);
    }

    private void OpenImagePreview(RegistryFile file)
    {
        _previewImageUrl = GetFileUrl(file, false);
        _previewImageTitle = file.FileName;
    }

    private void CloseImagePreview()
    {
        _previewImageUrl = null;
        _previewImageTitle = null;
    }

    private void BackToMeeting() => inj_navigationManager.NavigateTo(RouteConstants.MeetingDetail(MeetingId));

    private AppraiseBlock? CurrentAppraise => _appraises.FirstOrDefault(x => x.IsCurrentUser);

    private bool CanEditSummary(CaseSummary summary)
        => summary.Status == 0
           && HasPermission(PermissionConstants.AppraiseEdit)
           && (_isMeetingLeader || IsCurrentUser(summary.CreatedBy));

    private async Task SaveAppraiseFormsAsync()
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.AppraiseEdit))
        {
            return;
        }

        var appraise = SelectedAppraise;
        if (appraise?.CanEdit != true)
        {
            inj_snackbar.Add("只能保存本人未提交的评审表单", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认保存当前评审表单修改？"))
        {
            return;
        }

        var canSave = await _registryContext.CaseAppraises.AsNoTracking()
            .AnyAsync(x => x.Id == appraise.Id && x.MeetingId == MeetingId && x.CaseId == CaseId && x.ExpertId == CurrentUserId && x.Status == 0);
        if (!canSave)
        {
            inj_snackbar.Add("当前评审状态已变化，请刷新后重试", Severity.Warning);
            await LoadAppraiseAsync();
            return;
        }

        var fields = appraise.Forms.SelectMany(x => x.Fields).Where(x => !x.IsFile).ToList();
        var ids = fields.Select(x => x.Id).ToList();
        var values = await _registryContext.FormFieldValues.Where(x => ids.Contains(x.Id)).ToListAsync();
        foreach (var value in values)
        {
            var field = fields.First(x => x.Id == value.Id);
            value.FieldValue = field.EditValue;
            value.FieldText = field.EditValue;
            value.UpdatedAt = DateTime.Now;
            value.UpdatedBy = CurrentUserId;
        }

        _registryContext.OperationLogs.Add(CreateOperationLog("评审", "保存表单", "case", CaseId));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("评审表单已保存", Severity.Success);
        await LoadAppraiseAsync();
    }

    private async Task SubmitAppraiseAsync(Guid appraiseId)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.AppraiseEdit))
        {
            return;
        }

        var appraise = await _registryContext.CaseAppraises
            .FirstOrDefaultAsync(x => x.Id == appraiseId && x.MeetingId == MeetingId && x.CaseId == CaseId && x.ExpertId == CurrentUserId);
        if (appraise == null)
        {
            inj_snackbar.Add("只能提交本人评审", Severity.Warning);
            return;
        }

        if (appraise.Status != 0)
        {
            inj_snackbar.Add("当前评审已提交，不能重复提交", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认提交当前评审？提交后状态会变为已评审。"))
        {
            return;
        }

        appraise.Status = 1;
        appraise.UpdatedAt = DateTime.Now;
        appraise.UpdatedBy = CurrentUserId;
        _registryContext.OperationLogs.Add(CreateOperationLog("评审", "提交评审", "appraise", appraiseId));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("评审已提交", Severity.Success);
        await LoadAppraiseAsync();
    }

    private async Task SaveSummaryAsync(CaseSummary summary)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.AppraiseEdit) || !await RequireLeaderAsync(summary))
        {
            return;
        }

        if (summary.Status != 0)
        {
            inj_snackbar.Add("已提交的汇总不能修改", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(summary.Content))
        {
            inj_snackbar.Add("请先填写评审汇总", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认保存评审汇总？"))
        {
            return;
        }

        var affected = await _registryContext.CaseSummaries
            .Where(x => x.Id == summary.Id && x.MeetingId == MeetingId && x.CaseId == CaseId && x.Status == 0)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.Content, summary.Content ?? "")
                .SetProperty(x => x.UpdatedAt, DateTime.Now)
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
        if (affected == 0)
        {
            inj_snackbar.Add("汇总状态已变化，请刷新后重试", Severity.Warning);
            await LoadAppraiseAsync();
            return;
        }

        _registryContext.OperationLogs.Add(CreateOperationLog("评审", "保存汇总", "summary", summary.Id));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("汇总已保存", Severity.Success);
        await LoadAppraiseAsync();
    }

    private async Task SubmitSummaryAsync(CaseSummary summary)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.AppraiseEdit) || !await RequireLeaderAsync(summary))
        {
            return;
        }

        if (summary.Status != 0)
        {
            inj_snackbar.Add("已提交的汇总不能重复提交", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(summary.Content))
        {
            inj_snackbar.Add("请先填写评审汇总", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认提交评审汇总？提交后病例会标记为已评审。"))
        {
            return;
        }

        var affected = await _registryContext.CaseSummaries
            .Where(x => x.Id == summary.Id && x.MeetingId == MeetingId && x.CaseId == CaseId && x.Status == 0)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.Content, summary.Content ?? "")
                .SetProperty(x => x.Status, 1)
                .SetProperty(x => x.UpdatedAt, DateTime.Now)
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
        if (affected == 0)
        {
            inj_snackbar.Add("汇总状态已变化，请刷新后重试", Severity.Warning);
            await LoadAppraiseAsync();
            return;
        }

        await _registryContext.Cases.Where(x => x.Id == CaseId)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.SubStatus, 2)
                .SetProperty(x => x.UpdatedAt, DateTime.Now)
                .SetProperty(x => x.UpdatedBy, CurrentUserId));

        var meetingCaseIds = await _registryContext.CaseAppraises.AsNoTracking()
            .Where(x => x.MeetingId == MeetingId)
            .Select(x => x.CaseId)
            .Distinct()
            .ToListAsync();
        var submittedCaseIds = await _registryContext.CaseSummaries.AsNoTracking()
            .Where(x => x.MeetingId == MeetingId && x.Status == 1)
            .Select(x => x.CaseId)
            .Distinct()
            .ToListAsync();
        if (meetingCaseIds.Count > 0 && meetingCaseIds.All(x => submittedCaseIds.Contains(x)))
        {
            await _registryContext.ReviewMeetings.Where(x => x.Id == MeetingId)
                .ExecuteUpdateAsync(setters => setters
                    .SetProperty(x => x.Status, 2)
                    .SetProperty(x => x.UpdatedAt, DateTime.Now)
                    .SetProperty(x => x.UpdatedBy, CurrentUserId));
        }

        _registryContext.OperationLogs.Add(CreateOperationLog("评审", "提交汇总", "summary", summary.Id));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("汇总已提交", Severity.Success);
        await LoadAppraiseAsync();
    }

    private async Task<bool> RequireLeaderAsync(CaseSummary summary)
    {
        if (_registryContext == null)
        {
            return false;
        }

        var isMeetingLeader = await _registryContext.MeetingExperts.AsNoTracking()
            .AnyAsync(x => x.MeetingId == MeetingId && x.Level == 1 && x.ExpertId == CurrentUserId);
        if (isMeetingLeader)
        {
            return true;
        }

        var createdBy = await _registryContext.CaseSummaries.AsNoTracking()
            .Where(x => x.Id == summary.Id && x.MeetingId == MeetingId && x.CaseId == CaseId)
            .Select(x => x.CreatedBy)
            .FirstOrDefaultAsync();
        if (IsCurrentUser(createdBy))
        {
            return true;
        }

        inj_snackbar.Add("只有汇总创建人或当前会议组长可以维护评审汇总", Severity.Warning);
        return false;
    }

