        {
            new("是否组织医院或科室并发症讨论", RegistryFixedCatalog.GetYesNoName(_case.ComplicationDiscussion))
        };
        if (ShouldShowCaseDiscussionFollowup(_case))
        {
            discussionFields.AddRange(
            [
                new("发生原因", _case.OccurrenceReason, FullRow: true),
                new("死亡原因", _case.DeathReason, FullRow: true),
                new("经验教训", _case.LessonsLearned, FullRow: true),
                new("改进措施", _case.ImprovementMeasures, FullRow: true)
            ]);
        }

        AddCaseSection("case-discussion", "并发症讨论结论", discussionFields);
    }

