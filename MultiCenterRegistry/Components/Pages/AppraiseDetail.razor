    private static bool IsGuidText(string? value) => Guid.TryParse(value, out _);

    private static string GetUserName(string? id, IReadOnlyDictionary<Guid, string> users)
    {
        var userId = TryParseGuid(id);
        return userId.HasValue && users.TryGetValue(userId.Value, out var name) ? name : ShowValue(id);
    }

    private static string? TryGetUserName(string? id, IReadOnlyDictionary<Guid, string> users)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        var userId = TryParseGuid(id);
        return userId.HasValue && users.TryGetValue(userId.Value, out var name) ? name : id;
    }

    private static string DisplayOption(IReadOnlyList<FixedOption> options, string? value)
        => RegistryFixedCatalog.GetText(options, value);

    private static bool IsSameValue(string? left, string? right)
        => string.Equals(left?.Trim(), right?.Trim(), StringComparison.OrdinalIgnoreCase);

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string ShowValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string ShowSex(string? value)
        => ShowValue(RegistryFixedCatalog.GetSexName(value));

    private static string FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string FormatDateTime(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm") ?? "-";

    private static DateTime? ToDbTimestamp(DateTime? value)
        => value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Unspecified) : null;

    private static string GetSubStatusText(int status)
        => status switch
        {
            0 => "待分配",
            1 => "待评审",
            2 => "已评审",
            _ => $"子状态 {status}"
        };

    private static string GetSubStatusClass(int status)
        => status switch
        {
            0 => "status-draft",
            1 => "status-running",
            2 => "status-published",
            _ => "status-unknown"
        };

    private static string GetAppraiseStatusText(int status)
        => status switch
        {
            0 => "未提交",
            1 => "已提交",
            _ => $"状态 {status}"
        };

    private static string GetSummaryStatusText(int status)
        => status switch
        {
            0 => "未提交",
            1 => "已提交",
            _ => $"状态 {status}"
        };

