    private IQueryable<RegistryCase> ApplyRoleScope(IQueryable<RegistryCase> query)
    {
        if (HasPermission(PermissionConstants.QualityManage))
        {
            return query;
        }

        if (HasPermission(PermissionConstants.CaseApprove))
        {
            if (_scopeHospitalIds.Count == 0)
            {
                return query.Where(x => false);
            }

            return query.Where(x => x.HospitalId != null && _scopeHospitalIds.Contains(x.HospitalId));
        }

        if (HasPermission(PermissionConstants.CaseSubmit))
        {
            return query.Where(x => x.OperatorId == CurrentUserId);
        }

        return query.Where(x => false);
    }

    private async Task<IQueryable<RegistryCase>?> BuildCaseQueryAsync()
    {
        if (_registryContext == null)
        {
            return null;
        }

        var query = ApplyRoleScope(_registryContext.Cases.AsNoTracking());
        query = ApplyTabFilter(query);

        if (int.TryParse(_statusValue, out var status))
        {
            query = query.Where(x => x.Status == status);
        }

        if (!string.IsNullOrWhiteSpace(_hospitalFilterValue))
        {
            query = query.Where(x => x.HospitalId == _hospitalFilterValue);
        }

        if (!string.IsNullOrWhiteSpace(_patientNumberValue))
        {
            var patientNumber = _patientNumberValue.Trim();
            query = query.Where(x => x.PatientNumber != null && EF.Functions.ILike(x.PatientNumber, $"%{patientNumber}%"));
        }

        if (!string.IsNullOrWhiteSpace(_patientNameValue))
        {
            var patientName = _patientNameValue.Trim();
            query = query.Where(x => EF.Functions.ILike(x.PatientName, $"%{patientName}%"));
        }

        if (!TryReadDischargeRange(out var dischargeStart, out var dischargeEnd))
        {
            return null;
        }

        if (dischargeStart.HasValue)
        {
            query = query.Where(x => x.DischargeTime.HasValue && x.DischargeTime.Value >= dischargeStart.Value.Date);
        }

        if (dischargeEnd.HasValue)
        {
            var endExclusive = dischargeEnd.Value.Date.AddDays(1);
            query = query.Where(x => x.DischargeTime.HasValue && x.DischargeTime.Value < endExclusive);
        }

        var surgeryTypeValues = GetSelectedFilterValues(_surgeryTypeValues);
        if (surgeryTypeValues.Count > 0)
        {
            var surgeryTypeTexts = surgeryTypeValues
                .Select(RegistryFixedCatalog.GetDiseaseName)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .ToList();
            query = query.Where(x => (x.DiseaseId != null && surgeryTypeValues.Contains(x.DiseaseId))
                                     || (x.SurgeryTypeValue != null && surgeryTypeValues.Contains(x.SurgeryTypeValue))
                                     || (x.SurgeryTypeText != null && surgeryTypeTexts.Contains(x.SurgeryTypeText))
                                     || (x.SurgeryTypeText != null && surgeryTypeValues.Contains(x.SurgeryTypeText)));
        }

        var surgeonValues = GetSelectedFilterValues(_surgeonValues);
        if (surgeonValues.Count > 0)
        {
            query = query.Where(x => x.OperatorId != null && surgeonValues.Contains(x.OperatorId));
        }

        return query;
    }

    private void OnSurgeryTypeValuesChanged(IEnumerable<string> values)
        => _surgeryTypeValues = GetSelectedFilterValues(values);

    private void OnSurgeonValuesChanged(IEnumerable<string> values)
        => _surgeonValues = GetSelectedFilterValues(values);

    private string GetSurgeryTypeText(string value)
        => _surgeryTypeOptions.FirstOrDefault(x => IsSameFilterValue(x.Value, value))?.Text ?? value;

    private string GetSurgeonText(string value)
        => _surgeonOptions.FirstOrDefault(x => IsSameFilterValue(x.Value, value))?.Text ?? value;

    private static List<string> GetSelectedFilterValues(IEnumerable<string>? values)
        => values?
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList() ?? [];

    private static bool IsSameFilterValue(string left, string right)
        => string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    private bool TryReadDischargeRange(out DateTime? start, out DateTime? end)
    {
        start = _dischargeStartDate?.Date;
        end = _dischargeEndDate?.Date;

        if (start.HasValue && end.HasValue && start.Value.Date > end.Value.Date)
        {
            inj_snackbar.Add("出院开始时间不能晚于出院结束时间", Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task DeleteCaseAsync(Guid id, string patientName)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.CaseDelete))
        {
            return;
        }

        var currentStatus = await _registryContext.Cases.AsNoTracking()
            .Where(x => x.Id == id)
            .Select(x => (int?)x.Status)
            .FirstOrDefaultAsync();
        if (!currentStatus.HasValue)
        {
            inj_snackbar.Add("病例不存在", Severity.Warning);
            return;
        }

        if (currentStatus.Value == 2)
        {
            inj_snackbar.Add("已上报病例不能删除", Severity.Warning);
            return;
        }

        var createdBy = await _registryContext.Cases.AsNoTracking()
            .Where(x => x.Id == id)
            .Select(x => x.CreatedBy)
            .FirstOrDefaultAsync();
        if (IsHospitalQualityRole && !string.Equals(createdBy, CurrentUserId, StringComparison.OrdinalIgnoreCase))
        {
            inj_snackbar.Add("医院质控员只能删除自己创建的病例", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync($"确认删除病例“{patientName}”？病例附件、意见、评审和汇总都会删除。"))
        {
            return;
        }

        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        var appraiseIds = await _registryContext.CaseAppraises.AsNoTracking()
            .Where(x => x.CaseId == id)
            .Select(x => x.Id)
            .ToListAsync();
        var summaryIds = await _registryContext.CaseSummaries.AsNoTracking()
            .Where(x => x.CaseId == id)
            .Select(x => x.Id)
            .ToListAsync();
        var voteIds = await _registryContext.CaseVotes.AsNoTracking()
            .Where(x => x.CaseId == id)
            .Select(x => x.Id)
            .ToListAsync();
        var adviceIds = await _registryContext.CaseAdvices.AsNoTracking()
            .Where(x => x.CaseId == id)
            .Select(x => x.Id)
            .ToListAsync();

        await _registryContext.CaseVotes.Where(x => x.CaseId == id).ExecuteDeleteAsync();
        await _registryContext.CaseSummaries.Where(x => x.CaseId == id).ExecuteDeleteAsync();
        await _registryContext.CaseAppraises.Where(x => x.CaseId == id).ExecuteDeleteAsync();
        await _registryContext.CaseAdvices.Where(x => x.CaseId == id).ExecuteDeleteAsync();
        await _registryContext.Files.Where(x => x.OwnerType == "case" && x.OwnerId == id).ExecuteDeleteAsync();

        var targetIds = new List<Guid> { id };
        targetIds.AddRange(appraiseIds);
        targetIds.AddRange(summaryIds);
        targetIds.AddRange(voteIds);
        targetIds.AddRange(adviceIds);
        await _registryContext.MigrationMaps.Where(x => targetIds.Contains(x.TargetId)).ExecuteDeleteAsync();
        await _registryContext.Cases.Where(x => x.Id == id).ExecuteDeleteAsync();

        _registryContext.OperationLogs.Add(CreateOperationLog("病例", "删除", "case", id, patientName));
        await _registryContext.SaveChangesAsync();
        await transaction.CommitAsync();

        inj_snackbar.Add("病例已删除", Severity.Success);
        await LoadCasesAsync();
    }

    private async Task ImportCasesAsync(InputFileChangeEventArgs args)
    {
        if (_registryContext == null)
        {
            return;
        }

        if (!HasAnyPermission(PermissionConstants.ImportCase, PermissionConstants.QualityManage))
        {
            inj_snackbar.Add("当前账号没有导入病例权限", Severity.Warning);
            return;
        }

        var file = args.File;
        _isImporting = true;
        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024);
            var rows = await SimpleTableReader.ReadAsync(stream, file.Name);
            if (rows.Count == 0)
            {
                inj_snackbar.Add("导入文件没有数据", Severity.Warning);
                return;
            }

            if (!await ConfirmAsync($"确认导入 {rows.Count} 行病例？"))
            {
                return;
            }

            var now = DateTime.Now;
            var imported = 0;
            var skipped = 0;
            await using var transaction = await _registryContext.Database.BeginTransactionAsync();
            var hospitalNames = (await _registryContext.SystemHospitals.AsNoTracking()
                    .Select(x => new { Id = x.Id.ToString(), x.Name })
                    .ToListAsync())
                .ToDictionary(x => x.Id, x => x.Name, StringComparer.OrdinalIgnoreCase);
            var userNames = (await _registryContext.SystemUsers.AsNoTracking()
                    .Where(x => x.IsValid)
                    .Select(x => new { Id = x.Id.ToString(), Name = x.DisplayName == "" ? x.Account : x.DisplayName })
                    .ToListAsync())
                .ToDictionary(x => x.Id, x => x.Name, StringComparer.OrdinalIgnoreCase);
            var maxSort = await _registryContext.Cases.Select(x => (int?)x.Sort).MaxAsync() ?? 0;

            foreach (var row in rows)
            {
                var patientName = GetCell(row, "患者姓名");
                var diseaseId = GetCell(row, "疾病类型ID");
                if (string.IsNullOrWhiteSpace(diseaseId))
                {
                    diseaseId = GetCell(row, "手术类别ID");
                }

                if (string.IsNullOrWhiteSpace(diseaseId))
                {
                    var diseaseName = GetCell(row, "手术类别");
                    diseaseId = RegistryFixedCatalog.Diseases.FirstOrDefault(x => x.Text.Equals(diseaseName, StringComparison.OrdinalIgnoreCase))?.Value ?? "";
                }

                if (string.IsNullOrWhiteSpace(patientName)
                    || string.IsNullOrWhiteSpace(diseaseId)
                    || !RegistryFixedCatalog.Diseases.Any(x => x.Value.Equals(diseaseId, StringComparison.OrdinalIgnoreCase)))
                {
                    skipped++;
                    continue;
                }

                var patientNumber = GetCell(row, "病案号");
                if (!string.IsNullOrWhiteSpace(patientNumber) && await _registryContext.Cases.AsNoTracking().AnyAsync(x => x.PatientNumber == patientNumber))
                {
                    skipped++;
                    continue;
                }

                if (!TryParseDate(GetCell(row, "入院时间"), out var admissionTime)
                    || !TryParseDate(GetCell(row, "出院时间"), out var dischargeTime)
                    || !TryParseDate(GetCell(row, "手术时间"), out var operationTime)
                    || !TryParseDate(GetCell(row, "死亡时间"), out var deathTime))
                {
                    skipped++;
                    continue;
                }

                var caseId = Guid.NewGuid();
                maxSort++;
                var patientSex = EmptyToNull(GetCell(row, "性别"));
                var hospitalId = EmptyToNull(GetCell(row, "医院ID"));
                var operatorId = EmptyToNull(GetCell(row, "经办人ID"));
                var surgeryType = diseaseId;
                var hospitalStayDays = TryParseInt(GetCell(row, "住院天数"));
                if (!hospitalStayDays.HasValue && admissionTime.HasValue && dischargeTime.HasValue)
                {
                    hospitalStayDays = Math.Max(0, (int)(dischargeTime.Value.Date - admissionTime.Value.Date).TotalDays);
                }

                _registryContext.Cases.Add(new RegistryCase
                {
                    Id = caseId,
                    OldCaseId = caseId.ToString(),
                    PatientName = patientName,
                    PatientSex = patientSex,
                    PatientSexText = RegistryFixedCatalog.GetSexName(patientSex),
                    PatientAge = EmptyToNull(GetCell(row, "年龄")),
                    PatientNumber = EmptyToNull(patientNumber),
                    IdNumber = EmptyToNull(GetCell(row, "身份证号")),
                    DiseaseId = diseaseId,
                    DiseaseName = RegistryFixedCatalog.GetDiseaseName(diseaseId),
                    HospitalId = hospitalId,
                    HospitalName = hospitalId != null && hospitalNames.TryGetValue(hospitalId, out var hospitalName) ? hospitalName : null,
                    DepartmentId = EmptyToNull(GetCell(row, "科室ID")),
                    DepartmentName = EmptyToNull(GetCell(row, "住院科室")),
                    OperatorId = operatorId,
                    OperatorName = operatorId != null && userNames.TryGetValue(operatorId, out var operatorName) ? operatorName : null,
                    SurgeryTypeValue = surgeryType,
                    SurgeryTypeText = RegistryFixedCatalog.GetDiseaseName(diseaseId),
                    CoronaryIntervention = EmptyToNull(GetCell(row, "冠心病介入")),
                    AblationIntervention = EmptyToNull(GetCell(row, "导管消融")),
                    StructuralIntervention = EmptyToNull(GetCell(row, "结构性心脏病介入")),
                    IsEmergencyIntervention = EmptyToNull(GetCell(row, "是否急诊介入")),
                    DischargeMode = EmptyToNull(GetCell(row, "离院方式")),
                    SituationReason = EmptyToNull(GetCell(row, "情况/原因说明")),
                    SituationSupplement = EmptyToNull(GetCell(row, "补充说明")),
                    DeathTime = deathTime,
                    HospitalStayDays = hospitalStayDays,
                    CaseSummary = EmptyToNull(GetCell(row, "病例简介")),
                    DischargeDiagnosis = EmptyToNull(GetCell(row, "出院诊断")),
                    OtherExam = EmptyToNull(GetCell(row, "其他检查")),
                    AngiographyResult = EmptyToNull(GetCell(row, "造影结果")),
                    InterventionProcess = EmptyToNull(GetCell(row, "介入过程")),
                    RescueProcess = EmptyToNull(GetCell(row, "抢救过程")),
                    ComplicationDiscussion = EmptyToNull(GetCell(row, "并发症讨论")),
                    OccurrenceReason = EmptyToNull(GetCell(row, "发生原因")),
                    DeathReason = EmptyToNull(GetCell(row, "死亡原因")),
                    LessonsLearned = EmptyToNull(GetCell(row, "经验教训")),
                    ImprovementMeasures = EmptyToNull(GetCell(row, "改进措施")),
                    AdmissionTime = admissionTime,
                    DischargeTime = dischargeTime,
                    OperationTime = operationTime,
                    Status = 3,
                    SubStatus = 0,
                    Sort = maxSort,
                    CreatedAt = now,
                    CreatedBy = CurrentUserId
                });

                _registryContext.OperationLogs.Add(CreateOperationLog("病例", "导入", "case", caseId, file.Name));
                imported++;
            }

            await _registryContext.SaveChangesAsync();
            await transaction.CommitAsync();
            _showImportModal = false;
            inj_snackbar.Add($"导入完成：成功 {imported} 行，跳过 {skipped} 行", imported > 0 ? Severity.Success : Severity.Warning);
            await LoadCasesAsync();
        }
        finally
        {
            _isImporting = false;
        }
    }

    private static string ShowValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string ShowSex(string? value)
        => ShowValue(RegistryFixedCatalog.GetSexName(value));

    private static string ShowDischargeTime(CaseListItem item)
        => FormatDate(item.DischargeTime);

    private static string GetRawFieldValue(string? fieldText, string? fieldValue)
        => string.IsNullOrWhiteSpace(fieldText) ? fieldValue?.Trim() ?? "" : fieldText.Trim();

    private string GetStatusTabClass(string value)
        => _tabValue == value ? "status-tab active" : "status-tab";

    private static Guid? TryParseGuid(string? value) => Guid.TryParse(value, out var id) ? id : null;

    private static string GetCell(IReadOnlyDictionary<string, string> row, string name)
        => row.TryGetValue(name, out var value) ? value.Trim() : "";

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static int? TryParseInt(string value)
        => int.TryParse(value, out var result) ? result : null;

    private static bool TryParseDate(string value, out DateTime? result)
    {
        result = null;
        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (!DateTime.TryParse(value, out var parsed))
        {
            return false;
        }

        result = parsed;
        return true;
    }

    private static string FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string FormatExportDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "";

    private static string GetStatusText(int status)
        => status switch
        {
            0 => "待审核",
            1 => "已回退",
            2 => "已上报",
            3 => "待填写",
            4 => "审核失败",
            _ => $"状态 {status}"
        };

    private static string GetStatusClass(int status)
        => status switch
        {
            0 => "status-review",
            1 => "status-returned",
            2 => "status-submitted",
            3 => "status-draft",
            4 => "status-failed",
            _ => "status-unknown"
        };

    private sealed record CaseListItem(
        Guid Id,
        string PatientName,
        string? PatientSex,
        string? PatientSexText,
        string? PatientNumber,
        string? HospitalName,
        DateTime? DischargeTime,
        string? OperatorName,
        string? SurgeryTypeText,
        int Status,
        int SubStatus,
        int Sort,
        DateTime CreatedAt,
        string? CreatedBy);

    private sealed record StatusTab(string Value, string Text);
    private sealed record CaseFilterOption(string Value, string Text);
    private sealed record HospitalFilterOption(string Id, string Name);
    private sealed record CaseDisplayMaps(IReadOnlyDictionary<string, string> Hospitals, IReadOnlyDictionary<string, string> Users);
}
