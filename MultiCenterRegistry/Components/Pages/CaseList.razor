@page "/cases"
@inherits BasePage

<PageTitle>@(IsQualityCenterMode ? "病例报表" : "病例管理")</PageTitle>

<div class="case-page case-list-page">
    <div class="page-header">
        <div>
            <h1>@(IsQualityCenterMode ? "病例报表" : "病例管理")</h1>
            <div class="page-subtitle">共 @_totalCount 条病例</div>
        </div>
        <div class="header-actions">
            @if (HasAnyPermission(PermissionConstants.CaseEdit, PermissionConstants.CaseApprove, PermissionConstants.QualityManage))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="ToggleExportPanel">导出</MudButton>
            }
            @if (HasAnyPermission(PermissionConstants.ImportCase, PermissionConstants.QualityManage))
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.UploadFile" OnClick="OpenImportModal">导入</MudButton>
            }
            @if (HasPermission(PermissionConstants.CaseCreate))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateCase">创建病例</MudButton>
            }
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Default" title="刷新" OnClick="LoadCasesAsync" />
        </div>
    </div>

    @if (_showCreateCaseModal)
    {
        <div class="case-dialog-mask" role="presentation">
            <section class="case-edit-dialog" role="dialog" aria-modal="true" aria-labelledby="case-create-modal-title">
                <CaseEdit Saved="OnCaseCreated" Cancelled="CloseCreateCaseModal" />
            </section>
        </div>
    }

    @if (_showOperatorModal)
    {
        <div class="case-dialog-mask" role="presentation">
            <section class="case-operator-dialog" role="dialog" aria-modal="true" aria-labelledby="case-operator-modal-title">
                <div class="case-dialog-head">
                    <div class="case-dialog-title">
                        <span class="case-dialog-icon">
                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" />
                        </span>
                        <div>
                            <h2 id="case-operator-modal-title">替换术者</h2>
                            <p>将已选择的 @SelectionCount 条病例术者替换为指定账号。</p>
                        </div>
                    </div>
                    <MudIconButton Class="case-dialog-close" Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" title="关闭" OnClick="CloseOperatorModal" />
                </div>

                <div class="case-dialog-body">
                    <MudSelect T="string" @bind-Value="_targetOperatorId" Label="术者" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="string" Value="@("")">请选择术者</MudSelectItem>
                        @foreach (var item in _operatorOptions)
                        {
                            <MudSelectItem T="string" Value="@item.Value">@item.Text</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                <div class="case-dialog-actions">
                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="CloseOperatorModal" Disabled="@_isChangingOperator">取消</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="ChangeOperatorAsync" Disabled="@(_isChangingOperator || string.IsNullOrWhiteSpace(_targetOperatorId))">确认替换</MudButton>
                </div>
            </section>
        </div>
    }

    @if (_showImportModal)
    {
        <div class="case-dialog-mask" role="presentation">
            <section class="case-import-dialog" role="dialog" aria-modal="true" aria-labelledby="case-import-modal-title">
                <div class="case-dialog-head">
                    <div class="case-dialog-title">
                        <span class="case-dialog-icon">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" />
                        </span>
                        <div>
                            <h2 id="case-import-modal-title">导入Excel数据</h2>
                        <p>请使用标准模板导入，导入模式为仅新增数据。</p>
                        </div>
                    </div>
                    <MudIconButton Class="case-dialog-close" Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" title="关闭" OnClick="CloseImportModal" />
                </div>

                <div class="case-dialog-body">
                    <div class="import-template-row">
                        <div>
                            <strong>标准模板</strong>
                            <span>下载模板后按列填写病例数据，再上传 .xlsx 文件。</span>
                        </div>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FileDownload" Href="/imports/case-template.xlsx" Target="_blank">下载模板</MudButton>
                    </div>
                    <label class="import-dropzone @(_isImporting ? "importing" : "")">
                        <span class="import-dropzone-content">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                            <strong>@(_isImporting ? "正在导入，请稍候" : "选择或拖拽上传文件")</strong>
                            <span>仅支持 .xlsx，单个文件 10MB 以内</span>
                            <span class="import-upload-button">@(_isImporting ? "导入中" : "选择文件")</span>
                        </span>
                        <InputFile OnChange="ImportCasesAsync" accept=".xlsx" disabled="@_isImporting" />
                    </label>
                </div>

                <div class="case-dialog-actions">
                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="CloseImportModal" Disabled="@_isImporting">取消</MudButton>
                </div>
            </section>
        </div>
    }

    @if (_showExportPanel)
    {
        <MudPaper Class="export-panel case-export-panel" Elevation="0">
            <MudDatePicker @bind-Date="_exportStartDate"
                           Label="开始时间"
                           Placeholder="开始时间"
                           DateFormat="yyyy-MM-dd"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense" />
            <MudDatePicker @bind-Date="_exportEndDate"
                           Label="结束时间"
                           Placeholder="结束时间"
                           DateFormat="yyyy-MM-dd"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense" />
            @if (HasPermission(PermissionConstants.QualityManage))
            {
                <MudSelect T="string" @bind-Value="_exportHospitalId" Label="医院" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("")">全部医院</MudSelectItem>
                    @foreach (var hospital in _hospitalOptions)
                    {
                        <MudSelectItem T="string" Value="@hospital.Id">@hospital.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       Disabled="@(!CanExport)"
                       Href="@BuildExportUrl()"
                       Target="_blank">确认导出</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="ToggleExportPanel">取消</MudButton>
        </MudPaper>
    }

    <MudPaper Class="filter-panel case-filter-panel" Elevation="0">
        <MudSelect T="string" @bind-Value="_hospitalFilterValue" Label="所属医院" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_hospitalOptions.Count <= 1)">
            <MudSelectItem T="string" Value="@("")">全部医院</MudSelectItem>
            @foreach (var hospital in _hospitalOptions)
            {
                <MudSelectItem T="string" Value="@hospital.Id">@hospital.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" @bind-Value="_statusValue" Label="状态" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="string" Value="@("")">全部</MudSelectItem>
            <MudSelectItem T="string" Value="@("2")">已上报</MudSelectItem>
            <MudSelectItem T="string" Value="@("3")">待填写</MudSelectItem>
        </MudSelect>
        <MudTextField T="string"
                      @bind-Value="_patientNumberValue"
                      Label="病案号"
                      Placeholder="病案号"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      OnKeyDown="OnSearchKeyDown" />
        <MudTextField T="string"
                      @bind-Value="_patientNameValue"
                      Label="患者姓名"
                      Placeholder="患者姓名"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      OnKeyDown="OnSearchKeyDown" />
        <div class="case-date-range">
            <MudDatePicker @bind-Date="_dischargeStartDate"
                           Label="出院开始"
                           Placeholder="开始日期"
                           DateFormat="yyyy-MM-dd"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense" />
            <span class="case-date-separator">-</span>
            <MudDatePicker @bind-Date="_dischargeEndDate"
                           Label="出院结束"
                           Placeholder="结束日期"
                           DateFormat="yyyy-MM-dd"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense" />
        </div>
        <MudSelect T="string"
                   MultiSelection="true"
                   SelectedValues="_surgeryTypeValues"
                   SelectedValuesChanged="OnSurgeryTypeValuesChanged"
                   ToStringFunc="GetSurgeryTypeText"
                   Label="手术类别"
                   Placeholder="全部"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense">
            @foreach (var item in _surgeryTypeOptions)
            {
                <MudSelectItem T="string" Value="@item.Value">@item.Text</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string"
                   MultiSelection="true"
                   SelectedValues="_surgeonValues"
                   SelectedValuesChanged="OnSurgeonValuesChanged"
                   ToStringFunc="GetSurgeonText"
                   Label="术者"
                   Placeholder="全部"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense">
            @foreach (var item in _surgeonOptions)
            {
                <MudSelectItem T="string" Value="@item.Value">@item.Text</MudSelectItem>
            }
        </MudSelect>
        <div class="case-filter-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="SearchAsync">查询</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetFiltersAsync">重置</MudButton>
        </div>
    </MudPaper>

    <div class="status-tabs">
        @foreach (var tab in CurrentStatusTabs)
        {
            <button type="button" class="@GetStatusTabClass(tab.Value)" @onclick="@(() => ChangeTabAsync(tab.Value))">@tab.Text</button>
        }
    </div>

    <MudPaper Class="list-panel case-list-panel" Elevation="0">
        @if (_isLoading)
        {
            <div class="loading-row">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                <span>正在加载病例</span>
            </div>
        }
        else if (_cases.Count == 0)
        {
            <div class="empty-row">未找到病例</div>
        }
        else
        {
            <div class="table-wrap">
                <table class="case-table">
                    <colgroup>
                        @if (_isBatchOperatorMode)
                        {
                            <col class="case-select-col" />
                        }
                        <col class="case-hospital-col" />
                        <col class="case-status-col" />
                        <col class="case-created-col" />
                        <col class="case-number-col" />
                        <col class="case-name-col" />
                        <col class="case-sex-col" />
                        <col class="case-discharge-col" />
                        <col class="case-operator-col" />
                        <col class="case-surgery-col" />
                        <col class="case-operation-col" />
                    </colgroup>
                    <thead>
                        <tr>
                            @if (_isBatchOperatorMode)
                            {
                                <th class="selection-cell">
                                    <input class="case-check" type="checkbox" checked="@IsCurrentPageSelected" @onchange="ToggleCurrentPageSelection" title="选择全部可替换病例" />
                                </th>
                            }
                            <th>@SortHeader("hospital", "所属医院")</th>
                            <th>@SortHeader("status", "状态")</th>
                            <th>@SortHeader("createdAt", "创建时间")</th>
                            <th>@SortHeader("patientNumber", "病案号")</th>
                            <th>@SortHeader("patientName", "患者姓名")</th>
                            <th>@SortHeader("sex", "性别")</th>
                            <th>@SortHeader("dischargeTime", "出院时间")</th>
                            <th>@SortHeader("operator", "术者")</th>
                            <th>@SortHeader("surgeryType", "手术类别")</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _cases)
                        {
                            var surgeryTypeText = ShowValue(item.SurgeryTypeText);
                            var sexText = ShowSex(item.PatientSexText ?? item.PatientSex);
                            <tr>
                                @if (_isBatchOperatorMode)
                                {
                                    <td class="selection-cell">
                                        <input class="case-check" type="checkbox" checked="@IsCaseSelected(item)" disabled="@(!CanSelectForOperator(item))" @onchange="@((ChangeEventArgs args) => ToggleCaseSelection(item, args))" title="选择病例" />
                                    </td>
                                }
                                <td><span class="case-cell-text" title="@ShowValue(item.HospitalName)">@ShowValue(item.HospitalName)</span></td>
                                <td>
                                    <span class="status-pill @GetStatusClass(item.Status)">@GetStatusText(item.Status)</span>
                                </td>
                                <td>@FormatDate(item.CreatedAt)</td>
                                <td><span class="case-cell-text" title="@ShowValue(item.PatientNumber)">@ShowValue(item.PatientNumber)</span></td>
                                <td><span class="case-cell-text" title="@ShowValue(item.PatientName)">@ShowValue(item.PatientName)</span></td>
                                <td>@sexText</td>
                                <td>@ShowDischargeTime(item)</td>
                                <td><span class="case-cell-text" title="@ShowValue(item.OperatorName)">@ShowValue(item.OperatorName)</span></td>
                                <td><span class="case-cell-text" title="@surgeryTypeText">@surgeryTypeText</span></td>
                                <td class="operation-cell">
                                    <div class="case-row-actions">
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenCase(item.Id))">查看病例</MudButton>
                                        @if (CanViewCaseAppraise(item))
                                        {
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => OpenCaseAppraiseAsync(item.Id))">查看评价</MudButton>
                                        }
                                        @if (CanDeleteCase(item))
                                        {
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Delete"
                                                       OnClick="@(() => DeleteCaseAsync(item.Id, item.PatientName))">删除</MudButton>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="pager case-pager">
            @if (CanShowBatchChangeOperator)
            {
                <div class="case-batch-actions">
                    @if (!_isBatchOperatorMode)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ManageAccounts" OnClick="EnterBatchOperatorMode">批量更换术者</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ManageAccounts" Disabled="@(SelectionCount == 0)" OnClick="OpenOperatorModalAsync">更换术者</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="CancelBatchOperatorMode">返回</MudButton>
                    }
                </div>
            }
            <div class="pager-total">共 @_totalCount 条</div>
            <div class="pager-pages">
                <button type="button" class="pager-page wide" disabled="@(_pageIndex == 0 || _isLoading)" @onclick="PreviousPageAsync">上一页</button>
                @foreach (var page in GetPagerItems())
                {
                    if (page < 0)
                    {
                        <span class="pager-ellipsis">...</span>
                    }
                    else
                    {
                        <button type="button" class="@GetPageButtonClass(page)" disabled="@_isLoading" @onclick="@(() => GoToPageAsync(page))">@(page + 1)</button>
                    }
                }
                <button type="button" class="pager-page wide" disabled="@(_pageIndex + 1 >= TotalPages || _isLoading)" @onclick="NextPageAsync">下一页</button>
            </div>
            <div class="pager-summary">第 @(_pageIndex + 1) / @TotalPages 页 · 每页 @PageSize 条</div>
        </div>
    </MudPaper>
</div>

@code {
    private const int PageSize = 10;
    private readonly List<CaseListItem> _cases = [];
    private readonly StatusTab[] _statusTabs =
    [
        new("", "全部"),
        new("3", "待填写"),
        new("0", "待审核"),
        new("1", "已回退"),
        new("4", "审核失败"),
        new("2", "已上报")
    ];
    private readonly StatusTab[] _qualityCenterTabs =
    [
        new("", "全部"),
        new("pending", "待处理"),
        new("history", "既往病例")
    ];
    private string _hospitalFilterValue = "";
    private string _statusValue = "";
    private string _patientNumberValue = "";
    private string _patientNameValue = "";
    private DateTime? _dischargeStartDate;
    private DateTime? _dischargeEndDate;
    private IEnumerable<string> _surgeryTypeValues = [];
    private IEnumerable<string> _surgeonValues = [];
    private string _tabValue = "";
    private string _sortColumn = "";
    private bool _sortAscending = true;
    private DateTime? _exportStartDate;
    private DateTime? _exportEndDate;
    private string _exportHospitalId = "";
    private readonly List<HospitalFilterOption> _hospitalOptions = [];
    private readonly List<CaseFilterOption> _surgeryTypeOptions = [];
    private readonly List<CaseFilterOption> _surgeonOptions = [];
    private readonly List<CaseFilterOption> _operatorOptions = [];
    private readonly HashSet<Guid> _selectedCaseIds = [];
    private readonly HashSet<Guid> _excludedCaseIds = [];
    private readonly List<string> _scopeHospitalIds = [];
    private string _targetOperatorId = "";
    private int _pageIndex;
    private int _totalCount;
    private int _eligibleBatchTotalCount;
    private bool _isLoading;
    private bool _showExportPanel;
    private bool _showCreateCaseModal;
    private bool _showImportModal;
    private bool _isImporting;
    private bool _showOperatorModal;
    private bool _isChangingOperator;
    private bool _selectAllFiltered;
    private bool _isBatchOperatorMode;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)PageSize));

    private int SelectionCount => _selectAllFiltered ? Math.Max(0, _eligibleBatchTotalCount - _excludedCaseIds.Count) : _selectedCaseIds.Count;

    private bool IsCurrentPageSelected => _isBatchOperatorMode && _cases.Any(CanSelectForOperator) && _cases.Where(CanSelectForOperator).All(x => IsCaseSelected(x.Id));

    private bool IsQualityCenterMode => HasPermission(PermissionConstants.QualityManage);

    private bool IsHospitalQualityRole
        => HasPermission(PermissionConstants.CaseApprove)
           && !HasPermission(PermissionConstants.QualityManage)
           && !HasPermission(PermissionConstants.CaseSubmit);

    private IReadOnlyList<StatusTab> CurrentStatusTabs => IsQualityCenterMode ? _qualityCenterTabs : _statusTabs;

    private bool CanBatchChangeOperator => HasPermission(PermissionConstants.CaseCreate);

    private bool CanShowBatchChangeOperator => CanBatchChangeOperator && _cases.Count > 0 && string.IsNullOrEmpty(_tabValue);

    private bool CanExport
        => _exportStartDate.HasValue
           && _exportEndDate.HasValue
           && _exportStartDate.Value.Date <= _exportEndDate.Value.Date;

    protected override async Task OnPageInitializedAsync()
    {
        await LoadRoleScopesAsync();
        await LoadFilterOptionsAsync();
        await LoadCasesAsync();
    }

    private async Task SearchAsync()
    {
        if (!TryReadDischargeRange(out _, out _))
        {
            return;
        }

        _pageIndex = 0;
        CancelBatchOperatorMode();
        await LoadCasesAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _hospitalFilterValue = "";
        _statusValue = "";
        _patientNumberValue = "";
        _patientNameValue = "";
        _dischargeStartDate = null;
        _dischargeEndDate = null;
        _surgeryTypeValues = [];
        _surgeonValues = [];
        _tabValue = "";
        ClearSort();
        _pageIndex = 0;
        CancelBatchOperatorMode();
        await LoadCasesAsync();
    }

    private async Task ChangeTabAsync(string value)
    {
        _tabValue = value;
        _pageIndex = 0;
        CancelBatchOperatorMode();
        await LoadCasesAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (_pageIndex == 0)
        {
            return;
        }

        _pageIndex--;
        await LoadCasesAsync();
    }

    private async Task NextPageAsync()
    {
        if (_pageIndex + 1 >= TotalPages)
        {
            return;
        }

        _pageIndex++;
        await LoadCasesAsync();
    }

    private async Task GoToPageAsync(int pageIndex)
    {
        if (_isLoading || pageIndex == _pageIndex || pageIndex < 0 || pageIndex >= TotalPages)
        {
            return;
        }

        _pageIndex = pageIndex;
        await LoadCasesAsync();
    }

    private IEnumerable<int> GetPagerItems()
    {
        if (TotalPages <= 7)
        {
            for (var i = 0; i < TotalPages; i++)
            {
                yield return i;
            }

            yield break;
        }

        yield return 0;
        var start = Math.Max(1, _pageIndex - 2);
        var end = Math.Min(TotalPages - 2, _pageIndex + 2);
        if (start > 1)
        {
            yield return -1;
        }

        for (var i = start; i <= end; i++)
        {
            yield return i;
        }

        if (end < TotalPages - 2)
        {
            yield return -1;
        }

        yield return TotalPages - 1;
    }

    private string GetPageButtonClass(int pageIndex)
        => pageIndex == _pageIndex ? "pager-page active" : "pager-page";

    private async Task OnSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task LoadFilterOptionsAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        var visibleQuery = ApplyRoleScope(_registryContext.Cases.AsNoTracking());
        var hospitalIds = await visibleQuery
            .Where(x => x.HospitalId != null && x.HospitalId != "")
            .Select(x => x.HospitalId!)
            .Distinct()
            .ToListAsync();

        var hospitalGuids = hospitalIds
            .Select(TryParseGuid)
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .ToList();

        _hospitalOptions.Clear();
        if (hospitalGuids.Count > 0)
        {
            _hospitalOptions.AddRange(await _registryContext.SystemHospitals.AsNoTracking()
                .Where(x => hospitalGuids.Contains(x.Id))
                .OrderBy(x => x.Name)
                .Select(x => new HospitalFilterOption(x.Id.ToString(), x.Name))
                .ToListAsync());
        }

        _surgeryTypeOptions.Clear();
        _surgeryTypeOptions.AddRange(RegistryFixedCatalog.Diseases
            .Select(x => new CaseFilterOption(x.Value, x.Text))
            .OrderBy(x => x.Text));

        var surgeonValues = await visibleQuery
            .Where(x => x.OperatorId != null && x.OperatorId != "")
            .Select(x => new { x.OperatorId, x.OperatorName })
            .Distinct()
            .ToListAsync();
        var surgeonIds = surgeonValues
            .Select(x => TryParseGuid(x.OperatorId))
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .Distinct()
            .ToList();
        var surgeonNames = surgeonIds.Count == 0
            ? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            : await _registryContext.SystemUsers.AsNoTracking()
                .Where(x => surgeonIds.Contains(x.Id))
                .ToDictionaryAsync(x => x.Id.ToString(), x => x.DisplayName == "" ? x.Account : x.DisplayName);

        _surgeonOptions.Clear();
        _surgeonOptions.AddRange(surgeonValues
            .Select(x => new CaseFilterOption(
                x.OperatorId ?? "",
                ResolveSurgeonFilterText(x.OperatorId, x.OperatorName, surgeonNames)))
            .Where(x => !string.IsNullOrWhiteSpace(x.Value))
            .GroupBy(x => x.Value, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.First())
            .OrderBy(x => x.Text));
    }

    private async Task LoadRoleScopesAsync()
    {
        if (_registryContext == null || !Guid.TryParse(CurrentUserId, out var userId))
        {
            return;
        }

        var scopes = await _registryContext.SystemUserRoleScopes.AsNoTracking()
            .Where(x => x.UserId == userId && x.RoleId == CurrentRoleId)
            .Select(x => x.HospitalId)
            .ToListAsync();

        _scopeHospitalIds.Clear();
        _scopeHospitalIds.AddRange(scopes
            .Select(x => x.ToString())
            .Distinct(StringComparer.OrdinalIgnoreCase));
    }

    private async Task LoadCasesAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            var query = await BuildCaseQueryAsync();
            if (query == null)
            {
                _cases.Clear();
                _totalCount = 0;
                _eligibleBatchTotalCount = 0;
                return;
            }

            _totalCount = await query.CountAsync();
            _eligibleBatchTotalCount = CanBatchChangeOperator ? await query.Where(x => x.Status == 3).CountAsync() : 0;
            if (_pageIndex >= TotalPages)
            {
                _pageIndex = TotalPages - 1;
            }

            var records = await ApplyCaseOrdering(query)
                .Skip(_pageIndex * PageSize)
                .Take(PageSize)
                .ToListAsync();
            var displayMaps = await LoadCaseDisplayMapsAsync(records);

            _cases.Clear();
            _cases.AddRange(records.Select(x =>
                new CaseListItem(
                    x.Id,
                    x.PatientName,
                    x.PatientSex,
                    ResolveSexText(x),
                    x.PatientNumber,
                    ResolveHospitalName(x, displayMaps.Hospitals),
                    x.DischargeTime,
                    ResolveOperatorName(x, displayMaps.Users),
                    ResolveSurgeryTypeText(x),
                    x.Status,
                    x.SubStatus,
                    x.Sort,
                    x.CreatedAt,
                    x.CreatedBy)));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<CaseDisplayMaps> LoadCaseDisplayMapsAsync(IReadOnlyCollection<RegistryCase> records)
    {
        if (_registryContext == null || records.Count == 0)
        {
            return new CaseDisplayMaps(
                new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase),
                new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase));
        }

        var hospitalIds = records
            .Where(x => string.IsNullOrWhiteSpace(x.HospitalName))
            .Select(x => TryParseGuid(x.HospitalId))
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .Distinct()
            .ToList();
        var userIds = records
            .Where(x => string.IsNullOrWhiteSpace(x.OperatorName))
            .Select(x => TryParseGuid(x.OperatorId))
            .Where(x => x.HasValue)
            .Select(x => x!.Value)
            .Distinct()
            .ToList();

        var hospitals = hospitalIds.Count == 0
            ? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            : await _registryContext.SystemHospitals.AsNoTracking()
                .Where(x => hospitalIds.Contains(x.Id))
                .ToDictionaryAsync(x => x.Id.ToString(), x => x.Name);
        var users = userIds.Count == 0
            ? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            : await _registryContext.SystemUsers.AsNoTracking()
                .Where(x => userIds.Contains(x.Id))
                .ToDictionaryAsync(x => x.Id.ToString(), x => x.DisplayName == "" ? x.Account : x.DisplayName);

        return new CaseDisplayMaps(hospitals, users);
    }

    private static string? ResolveHospitalName(RegistryCase item, IReadOnlyDictionary<string, string> hospitals)
        => !string.IsNullOrWhiteSpace(item.HospitalName) && !IsGuidText(item.HospitalName)
            ? item.HospitalName
            : TryGetMapText(hospitals, item.HospitalId) ?? TryGetMapText(hospitals, item.HospitalName);

    private static string? ResolveOperatorName(RegistryCase item, IReadOnlyDictionary<string, string> users)
        => !string.IsNullOrWhiteSpace(item.OperatorName) && !IsGuidText(item.OperatorName)
            ? item.OperatorName
            : TryGetMapText(users, item.OperatorId) ?? TryGetMapText(users, item.OperatorName);

    private static string? ResolveSurgeryTypeText(RegistryCase item)
    {
        if (!string.IsNullOrWhiteSpace(item.SurgeryTypeText) && !IsGuidText(item.SurgeryTypeText))
        {
            return item.SurgeryTypeText;
        }

        var value = GetRawFieldValue(item.DiseaseId, item.SurgeryTypeValue);
        if (string.IsNullOrWhiteSpace(value))
        {
            value = item.SurgeryTypeText;
        }

        var text = RegistryFixedCatalog.GetDiseaseName(value);
        return string.IsNullOrWhiteSpace(text) ? value : text;
    }

    private static string? ResolveSexText(RegistryCase item)
        => RegistryFixedCatalog.GetSexName(item.PatientSexText ?? item.PatientSex);

    private static string ResolveSurgeonFilterText(string? operatorId, string? operatorName, IReadOnlyDictionary<string, string> users)
    {
        if (!string.IsNullOrWhiteSpace(operatorName) && !IsGuidText(operatorName))
        {
            return operatorName.Trim();
        }

        var mappedName = TryGetMapText(users, operatorId) ?? TryGetMapText(users, operatorName);
        return string.IsNullOrWhiteSpace(mappedName) ? "未知术者" : mappedName;
    }

    private static string? TryGetMapText(IReadOnlyDictionary<string, string> map, string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        return map.TryGetValue(id, out var text) ? text : null;
    }

    private static bool IsGuidText(string? value)
        => Guid.TryParse(value, out _);

    private RenderFragment SortHeader(string column, string title) => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", GetSortHeaderClass(column));
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => ChangeSortAsync(column)));
        builder.OpenElement(4, "span");
        builder.AddContent(5, title);
        builder.CloseElement();
        builder.OpenElement(6, "span");
        builder.AddAttribute(7, "class", "case-sort-icon");
        builder.AddContent(8, GetSortText(column));
        builder.CloseElement();
        builder.CloseElement();
