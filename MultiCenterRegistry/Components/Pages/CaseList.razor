    private async Task ChangeSortAsync(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }

        _pageIndex = 0;
        await LoadCasesAsync();
    }

    private void ClearSort()
    {
        _sortColumn = "";
        _sortAscending = true;
    }

    private string GetSortHeaderClass(string column)
        => _sortColumn == column ? "case-sort-header active" : "case-sort-header";

    private string GetSortText(string column)
        => _sortColumn == column ? (_sortAscending ? "↑" : "↓") : "";

    private IOrderedQueryable<RegistryCase> ApplyCaseOrdering(IQueryable<RegistryCase> query)
    {
        if (string.IsNullOrWhiteSpace(_sortColumn))
        {
            return query
                .OrderByDescending(x => x.Sort)
                .ThenByDescending(x => x.CreatedAt)
                .ThenBy(x => x.PatientName);
        }

        var ordered = _sortColumn switch
        {
            "hospital" => _sortAscending ? query.OrderBy(x => x.HospitalName) : query.OrderByDescending(x => x.HospitalName),
            "status" => _sortAscending ? query.OrderBy(x => x.Status) : query.OrderByDescending(x => x.Status),
            "createdAt" => _sortAscending ? query.OrderBy(x => x.CreatedAt) : query.OrderByDescending(x => x.CreatedAt),
            "patientNumber" => _sortAscending ? query.OrderBy(x => x.PatientNumber) : query.OrderByDescending(x => x.PatientNumber),
            "patientName" => _sortAscending ? query.OrderBy(x => x.PatientName) : query.OrderByDescending(x => x.PatientName),
            "sex" => _sortAscending ? query.OrderBy(x => x.PatientSexText) : query.OrderByDescending(x => x.PatientSexText),
            "dischargeTime" => _sortAscending ? query.OrderBy(x => x.DischargeTime) : query.OrderByDescending(x => x.DischargeTime),
            "operator" => _sortAscending ? query.OrderBy(x => x.OperatorName) : query.OrderByDescending(x => x.OperatorName),
            "surgeryType" => _sortAscending ? query.OrderBy(x => x.SurgeryTypeText) : query.OrderByDescending(x => x.SurgeryTypeText),
            _ => _sortAscending ? query.OrderBy(x => x.CreatedAt) : query.OrderByDescending(x => x.CreatedAt)
        };

        return ordered
            .ThenByDescending(x => x.Sort)
            .ThenByDescending(x => x.CreatedAt)
            .ThenBy(x => x.PatientName);
    }

    private IQueryable<RegistryCase> ApplyTabFilter(IQueryable<RegistryCase> query)
    {
        if (IsQualityCenterMode)
        {
            return _tabValue switch
            {
                "pending" => query.Where(x => x.Status != 2),
                "history" => query.Where(x => x.Status == 2),
                _ => query
            };
        }

        return int.TryParse(_tabValue, out var status)
            ? query.Where(x => x.Status == status)
            : query;
    }

