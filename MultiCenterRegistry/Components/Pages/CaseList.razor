    private string BuildExportUrl()
    {
        var parts = new List<string>
        {
            $"start={Uri.EscapeDataString(FormatExportDate(_exportStartDate))}",
            $"end={Uri.EscapeDataString(FormatExportDate(_exportEndDate))}"
        };
        if (!string.IsNullOrWhiteSpace(_exportHospitalId))
