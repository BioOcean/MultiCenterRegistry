    private void ToggleExportPanel()
    {
        _showExportPanel = !_showExportPanel;
        if (_showExportPanel && string.IsNullOrWhiteSpace(_exportStartDate) && string.IsNullOrWhiteSpace(_exportEndDate))
        {
            var today = DateTime.Today;
            _exportStartDate = new DateTime(today.Year, 1, 1).ToString("yyyy-MM-dd");
            _exportEndDate = today.ToString("yyyy-MM-dd");
        }
    }

    private string BuildExportUrl()
    {
        var parts = new List<string>
        {
            $"start={Uri.EscapeDataString(_exportStartDate.Trim())}",
            $"end={Uri.EscapeDataString(_exportEndDate.Trim())}"
        };
        if (!string.IsNullOrWhiteSpace(_exportHospitalId))
        {
            parts.Add($"hospitalId={Uri.EscapeDataString(_exportHospitalId.Trim())}");
        }

        return $"/exports/cases.xlsx?{string.Join("&", parts)}";
    }

    private IQueryable<RegistryCase> ApplyRoleScope(IQueryable<RegistryCase> query)
    {
        if (HasPermission(PermissionConstants.QualityManage))
        {
            return query;
        }

        if (HasPermission(PermissionConstants.CaseApprove))
        {
            if (_scopeHospitalIds.Count > 0)
            {
                query = query.Where(x => x.HospitalId != null && _scopeHospitalIds.Contains(x.HospitalId));
            }

            if (_scopeDepartmentIds.Count > 0 && !_hasHospitalWideScope)
            {
                query = query.Where(x => x.DepartmentId != null && _scopeDepartmentIds.Contains(x.DepartmentId));
            }

            return query;
        }

        if (HasPermission(PermissionConstants.CaseSubmit))
        {
            query = query.Where(x => x.OperatorId == CurrentUserId);
        }

        return query;
    }

    private bool TryReadDischargeRange(out DateTime? start, out DateTime? end)
    {
        start = null;
        end = null;
        if (!TryParseDate(_dischargeStartValue, out start) || !TryParseDate(_dischargeEndValue, out end))
        {
            inj_snackbar.Add("出院时间格式不正确，请使用 yyyy-MM-dd", Severity.Warning);
            return false;
        }

        if (start.HasValue && end.HasValue && start.Value.Date > end.Value.Date)
        {
            inj_snackbar.Add("出院开始时间不能晚于出院结束时间", Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task<List<Guid>> GetCaseIdsByFieldValueAsync(string fieldName, string value)
    {
        if (_registryContext == null || string.IsNullOrWhiteSpace(value))
        {
            return [];
        }

        var expected = value.Trim();
        var values = await _registryContext.FormInstances.AsNoTracking()
            .Where(x => x.OwnerType == "case")
            .Join(
                _registryContext.FormFieldValues.AsNoTracking().Where(x => x.FieldName == fieldName),
                instance => instance.Id,
                value => value.FormInstanceId,
                (instance, value) => new { instance.OwnerId, value.FieldText, value.FieldValue })
            .ToListAsync();

        return values
            .Where(x => NormalizeFieldValue(fieldName, x.FieldText, x.FieldValue).Equals(expected, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.OwnerId)
            .Distinct()
            .ToList();
    }

    private async Task DeleteCaseAsync(Guid id, string patientName)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.CaseDelete))
        {
            return;
        }

        var currentStatus = await _registryContext.Cases.AsNoTracking()
            .Where(x => x.Id == id)
            .Select(x => (int?)x.Status)
            .FirstOrDefaultAsync();
        if (!currentStatus.HasValue)
        {
            inj_snackbar.Add("病例不存在", Severity.Warning);
            return;
        }

        if (currentStatus.Value == 2)
        {
            inj_snackbar.Add("已上报病例不能删除", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync($"确认删除病例“{patientName}”？病例表单、附件记录、意见、评审、汇总和投票都会删除。"))
        {
            return;
        }

        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        var appraiseIds = await _registryContext.CaseAppraises.AsNoTracking()
            .Where(x => x.CaseId == id)
            .Select(x => x.Id)
            .ToListAsync();
        var summaryIds = await _registryContext.CaseSummaries.AsNoTracking()
            .Where(x => x.CaseId == id)
            .Select(x => x.Id)
            .ToListAsync();
        var voteIds = await _registryContext.CaseVotes.AsNoTracking()
            .Where(x => x.CaseId == id)
            .Select(x => x.Id)
            .ToListAsync();
        var adviceIds = await _registryContext.CaseAdvices.AsNoTracking()
            .Where(x => x.CaseId == id)
            .Select(x => x.Id)
            .ToListAsync();

        await DeleteFormInstancesAsync("appraise", appraiseIds);
        await DeleteFormInstancesAsync("case", [id]);
        await _registryContext.CaseVotes.Where(x => x.CaseId == id).ExecuteDeleteAsync();
        await _registryContext.CaseSummaries.Where(x => x.CaseId == id).ExecuteDeleteAsync();
        await _registryContext.CaseAppraises.Where(x => x.CaseId == id).ExecuteDeleteAsync();
        await _registryContext.CaseAdvices.Where(x => x.CaseId == id).ExecuteDeleteAsync();
        await _registryContext.CaseFormData.Where(x => x.CaseId == id).ExecuteDeleteAsync();

        var targetIds = new List<Guid> { id };
        targetIds.AddRange(appraiseIds);
        targetIds.AddRange(summaryIds);
        targetIds.AddRange(voteIds);
        targetIds.AddRange(adviceIds);
        await _registryContext.MigrationMaps.Where(x => targetIds.Contains(x.TargetId)).ExecuteDeleteAsync();
        await _registryContext.Cases.Where(x => x.Id == id).ExecuteDeleteAsync();

        _registryContext.OperationLogs.Add(CreateOperationLog("病例", "删除", "case", id, patientName));
        await _registryContext.SaveChangesAsync();
        await transaction.CommitAsync();

        inj_snackbar.Add("病例已删除", Severity.Success);
        await LoadCasesAsync();
    }

    private async Task DeleteFormInstancesAsync(string ownerType, List<Guid> ownerIds)
    {
        if (_registryContext == null || ownerIds.Count == 0)
        {
            return;
        }

        var instanceIds = await _registryContext.FormInstances.AsNoTracking()
            .Where(x => x.OwnerType == ownerType && ownerIds.Contains(x.OwnerId))
            .Select(x => x.Id)
            .ToListAsync();
        if (instanceIds.Count == 0)
        {
            return;
        }

        var valueIds = await _registryContext.FormFieldValues.AsNoTracking()
            .Where(x => instanceIds.Contains(x.FormInstanceId))
            .Select(x => x.Id)
            .ToListAsync();
        if (valueIds.Count > 0)
        {
            await _registryContext.Files.Where(x => x.OwnerType == "form_field_value" && valueIds.Contains(x.OwnerId)).ExecuteDeleteAsync();
            await _registryContext.FormFieldValues.Where(x => valueIds.Contains(x.Id)).ExecuteDeleteAsync();
        }

        await _registryContext.FormInstances.Where(x => instanceIds.Contains(x.Id)).ExecuteDeleteAsync();
    }

    private async Task ImportCasesAsync(InputFileChangeEventArgs args)
    {
        if (_registryContext == null)
        {
            return;
        }

        if (!HasAnyPermission(PermissionConstants.ImportCase, PermissionConstants.QualityManage))
        {
            inj_snackbar.Add("当前账号没有导入病例权限", Severity.Warning);
            return;
        }

        var file = args.File;
        _isImporting = true;
        try
        {
            await using var stream = file.OpenReadStream(10 * 1024 * 1024);
            var rows = await SimpleTableReader.ReadAsync(stream, file.Name);
            if (rows.Count == 0)
            {
                inj_snackbar.Add("导入文件没有数据", Severity.Warning);
                return;
            }

            if (!await ConfirmAsync($"确认导入 {rows.Count} 行病例？"))
            {
                return;
            }

            var now = DateTime.Now;
            var imported = 0;
            var skipped = 0;
            await using var transaction = await _registryContext.Database.BeginTransactionAsync();
            var caseTemplateMaps = await _registryContext.FormTemplateMaps.AsNoTracking()
                .Where(x => x.BusinessType == "case")
                .ToListAsync();
            var templateMapByDisease = caseTemplateMaps
                .Where(x => x.TemplateName != "基本信息")
                .GroupBy(x => x.SourceFollowTemplateId, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.First(), StringComparer.OrdinalIgnoreCase);
            var baseMaps = caseTemplateMaps.Where(x => x.TemplateName == "基本信息").ToList();
            var templateIds = caseTemplateMaps.Select(x => x.FormTemplateId).Distinct().ToList();
            var definitions = await _registryContext.FormFieldDefinitions.AsNoTracking()
                .Where(x => templateIds.Contains(x.FormTemplateId))
                .OrderBy(x => x.Sort)
                .ThenBy(x => x.StorageKey)
                .ToListAsync();
            var definitionsByTemplate = definitions.GroupBy(x => x.FormTemplateId).ToDictionary(x => x.Key, x => x.ToList());
            var maxSort = await _registryContext.Cases.Select(x => (int?)x.Sort).MaxAsync() ?? 0;

            foreach (var row in rows)
            {
                var patientName = GetCell(row, "患者姓名");
                var diseaseId = GetCell(row, "疾病类型ID");
                if (string.IsNullOrWhiteSpace(patientName) || string.IsNullOrWhiteSpace(diseaseId) || !templateMapByDisease.TryGetValue(diseaseId, out var templateMap))
                {
                    skipped++;
                    continue;
                }

                var patientNumber = GetCell(row, "病案号");
                if (!string.IsNullOrWhiteSpace(patientNumber) && await _registryContext.Cases.AsNoTracking().AnyAsync(x => x.PatientNumber == patientNumber))
                {
                    skipped++;
                    continue;
                }

                if (!TryParseDate(GetCell(row, "入院时间"), out var admissionTime)
                    || !TryParseDate(GetCell(row, "出院时间"), out var dischargeTime)
                    || !TryParseDate(GetCell(row, "手术时间"), out var operationTime))
                {
                    skipped++;
                    continue;
                }

                var caseId = Guid.NewGuid();
                maxSort++;
                _registryContext.Cases.Add(new RegistryCase
                {
                    Id = caseId,
                    OldCaseId = caseId.ToString(),
                    PatientName = patientName,
                    PatientSex = EmptyToNull(GetCell(row, "性别")),
                    PatientAge = EmptyToNull(GetCell(row, "年龄")),
                    PatientNumber = EmptyToNull(patientNumber),
                    IdNumber = EmptyToNull(GetCell(row, "身份证号")),
                    DiseaseId = diseaseId,
                    HospitalId = EmptyToNull(GetCell(row, "医院ID")),
                    DepartmentId = EmptyToNull(GetCell(row, "科室ID")),
                    OperatorId = EmptyToNull(GetCell(row, "经办人ID")),
                    AdmissionTime = admissionTime,
                    DischargeTime = dischargeTime,
                    OperationTime = operationTime,
                    Status = 3,
                    SubStatus = 0,
                    Sort = maxSort,
                    CreatedAt = now,
                    CreatedBy = CurrentUserId
                });

                AddCaseForms(caseId, baseMaps.Append(templateMap), definitionsByTemplate, now);
                _registryContext.OperationLogs.Add(CreateOperationLog("病例", "导入", "case", caseId, file.Name));
                imported++;
            }

            await _registryContext.SaveChangesAsync();
            await transaction.CommitAsync();
            _showImportModal = false;
            inj_snackbar.Add($"导入完成：成功 {imported} 行，跳过 {skipped} 行", imported > 0 ? Severity.Success : Severity.Warning);
            await LoadCasesAsync();
        }
        finally
        {
            _isImporting = false;
        }
    }

    private void AddCaseForms(
        Guid caseId,
        IEnumerable<RegistryFormTemplateMap> maps,
        IReadOnlyDictionary<Guid, List<RegistryFormFieldDefinition>> definitionsByTemplate,
        DateTime now)
    {
        if (_registryContext == null)
        {
            return;
        }

        foreach (var map in maps)
        {
            var instance = new RegistryFormInstance
            {
                OwnerType = "case",
                OwnerId = caseId,
                FormTemplateId = map.FormTemplateId,
                FormTemplateMapId = map.Id,
                SourceCustomFormId = map.SourceCustomFormId,
                SourceFollowTemplateId = map.SourceFollowTemplateId,
                Status = 0,
                CreatedAt = now,
                CreatedBy = CurrentUserId
            };
            _registryContext.FormInstances.Add(instance);

            if (!definitionsByTemplate.TryGetValue(map.FormTemplateId, out var fields))
            {
                continue;
            }

            foreach (var field in fields)
            {
                _registryContext.FormFieldValues.Add(new RegistryFormFieldValue
                {
                    FormInstanceId = instance.Id,
                    FormFieldDefinitionId = field.Id,
                    StorageKey = field.StorageKey,
                    SourceSubjectId = field.SourceSubjectId,
                    FieldCode = field.FieldCode,
                    FieldName = field.FieldName,
                    Sort = field.Sort,
                    CreatedAt = now,
                    CreatedBy = CurrentUserId
                });
            }
        }
    }

    private static string ShowValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string ShowSex(string? value)
        => ShowValue(FormValueDisplayMapper.Normalize("性别", value));

    private static string ShowDischargeTime(CaseListItem item)
        => FormatDate(item.DischargeTime);

    private static string? GetFieldValue(CaseListItem item, string fieldName)
        => item.FieldValues.TryGetValue(fieldName, out var value) ? value : null;

    private static string NormalizeFieldValue(string fieldName, string? fieldText, string? fieldValue)
        => FormValueDisplayMapper.GetDisplayText(fieldName, fieldText, fieldValue);

    private static string GetRawFieldValue(string? fieldText, string? fieldValue)
        => string.IsNullOrWhiteSpace(fieldText) ? fieldValue?.Trim() ?? "" : fieldText.Trim();

    private string GetStatusTabClass(string value)
        => _tabValue == value ? "status-tab active" : "status-tab";

    private static Guid? TryParseGuid(string? value) => Guid.TryParse(value, out var id) ? id : null;

    private static string? GetDisplayName(string? id, IReadOnlyDictionary<Guid, string> names)
    {
        var guid = TryParseGuid(id);
        return guid.HasValue && names.TryGetValue(guid.Value, out var name) ? name : id;
    }

    private static string GetCell(IReadOnlyDictionary<string, string> row, string name)
        => row.TryGetValue(name, out var value) ? value.Trim() : "";

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static bool TryParseDate(string value, out DateTime? result)
    {
        result = null;
        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (!DateTime.TryParse(value, out var parsed))
        {
            return false;
        }

        result = parsed;
        return true;
    }

    private static string FormatDate(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "-";

    private static string GetStatusText(int status)
        => status switch
        {
            0 => "待审核",
            1 => "已回退",
            2 => "已上报",
            3 => "待填写",
            4 => "审核失败",
            _ => $"状态 {status}"
        };

    private static string GetStatusClass(int status)
        => status switch
        {
            0 => "status-review",
            1 => "status-returned",
            2 => "status-submitted",
            3 => "status-draft",
            4 => "status-failed",
            _ => "status-unknown"
        };

