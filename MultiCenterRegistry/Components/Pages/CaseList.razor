    private async Task EnsureOperatorOptionsAsync()
    {
        if (_registryContext == null || _operatorOptions.Count > 0)
        {
            return;
        }

        string[] operatorPermissionCodes = [PermissionConstants.CaseSubmit, "Power-MCR-N-N-N-Operator"];
        var rows = await (
            from user in _registryContext.SystemUsers.AsNoTracking()
            join userRole in _registryContext.SystemMapUserRoles.AsNoTracking() on user.Id equals userRole.UserId
            join rolePermission in _registryContext.SystemMapRolePermissions.AsNoTracking() on userRole.RoleId equals rolePermission.RoleId
            join permission in _registryContext.SystemPermissions.AsNoTracking() on rolePermission.PermissionId equals permission.Id
            where user.IsValid && permission.Code != null && operatorPermissionCodes.Contains(permission.Code)
            select new { user.Id, user.DisplayName, user.Account })
            .ToListAsync();

        _operatorOptions.AddRange(rows
            .GroupBy(x => x.Id)
            .Select(x => x.First())
            .OrderBy(x => x.DisplayName)
            .ThenBy(x => x.Account)
            .Select(x => new CaseFilterOption(x.Id.ToString(), x.DisplayName == "" ? x.Account : x.DisplayName)));
    }

    private async Task ChangeOperatorAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        if (!_isBatchOperatorMode || !CanBatchChangeOperator)
        {
            inj_snackbar.Add("当前账号没有该操作权限", Severity.Warning);
            return;
        }

        if (!Guid.TryParse(_targetOperatorId, out var operatorId))
        {
            inj_snackbar.Add("请选择术者", Severity.Warning);
            return;
        }

        var operatorName = await _registryContext.SystemUsers.AsNoTracking()
            .Where(x => x.Id == operatorId && x.IsValid)
            .Select(x => x.DisplayName == "" ? x.Account : x.DisplayName)
            .FirstOrDefaultAsync();
        if (string.IsNullOrWhiteSpace(operatorName))
        {
            inj_snackbar.Add("术者不存在或已停用", Severity.Warning);
            return;
        }

        var caseIds = await GetSelectedCaseIdsAsync();
        if (caseIds.Count == 0)
        {
            inj_snackbar.Add("请先选择病例", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync($"确认将 {caseIds.Count} 条病例的术者替换为“{operatorName}”？"))
        {
            return;
        }

        _isChangingOperator = true;
        try
        {
            var now = DateTime.Now;
            await using var transaction = await _registryContext.Database.BeginTransactionAsync();

            var cases = await _registryContext.Cases
                .Where(x => caseIds.Contains(x.Id) && x.Status == 3)
                .ToListAsync();
            if (cases.Count == 0)
            {
                inj_snackbar.Add("未找到可替换的待填写病例", Severity.Warning);
                return;
            }

            foreach (var item in cases)
            {
                item.OperatorId = _targetOperatorId;
                item.OperatorName = operatorName;
                item.UpdatedAt = now;
                item.UpdatedBy = CurrentUserId;
            }

            _registryContext.OperationLogs.Add(CreateOperationLog("病例", "批量替换术者", "case", Guid.Empty, $"{operatorName}:{cases.Count}"));
            await _registryContext.SaveChangesAsync();
            await transaction.CommitAsync();

            inj_snackbar.Add("术者已替换", Severity.Success);
            _showOperatorModal = false;
            _targetOperatorId = "";
            CancelBatchOperatorMode();
            await LoadFilterOptionsAsync();
            await LoadCasesAsync();
        }
        finally
        {
            _isChangingOperator = false;
        }
    }

    private async Task<List<Guid>> GetSelectedCaseIdsAsync()
    {
        if (!_selectAllFiltered)
        {
            return await _registryContext!.Cases.AsNoTracking()
                .Where(x => _selectedCaseIds.Contains(x.Id) && x.Status == 3)
                .Select(x => x.Id)
                .ToListAsync();
        }

        var query = await BuildCaseQueryAsync();
        if (query == null)
        {
            return [];
        }

        return await query
            .Where(x => x.Status == 3 && !_excludedCaseIds.Contains(x.Id))
            .Select(x => x.Id)
            .ToListAsync();
    }

    private void ToggleCaseSelection(CaseListItem item, ChangeEventArgs args)
    {
        if (!_isBatchOperatorMode || !CanSelectForOperator(item))
        {
            return;
        }

        var caseId = item.Id;
        var isChecked = args.Value is bool value && value;
        if (_selectAllFiltered)
        {
            if (isChecked)
            {
                _excludedCaseIds.Remove(caseId);
            }
            else
            {
                _excludedCaseIds.Add(caseId);
            }

            return;
        }

        if (isChecked)
        {
            _selectedCaseIds.Add(caseId);
        }
        else
        {
            _selectedCaseIds.Remove(caseId);
        }
    }

    private void ToggleCurrentPageSelection(ChangeEventArgs args)
    {
        if (!_isBatchOperatorMode)
        {
            return;
        }

        var isChecked = args.Value is bool value && value;
        if (isChecked)
        {
            _selectAllFiltered = true;
            _selectedCaseIds.Clear();
            _excludedCaseIds.Clear();
            return;
        }

        ClearSelection();
    }

