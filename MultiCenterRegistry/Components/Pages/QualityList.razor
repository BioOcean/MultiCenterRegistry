        Guid Id,
        string OldQualityId,
        string Name,
        DateTime QualityDate,
        string? TemplateId,
        string? HospitalId,
        string? QualityUserId,
        string? TemplateName,
        string? HospitalName,
        string? QualityUserName,
        int Status,
        DateTime CreatedAt,
        DateTime? UpdatedAt)
    {
        public DateTime FilledAt => UpdatedAt ?? CreatedAt;
    }

    private sealed record QualityMonthSummary(DateTime Month, int SubmittedCount, int UnsubmittedCount)
    {
        public string MonthText => Month.ToString("yyyy-MM");
    }

    private sealed record QualityHospitalDetail(string HospitalId, string HospitalName, Guid? QualityId, DateTime? SubmitTime, string? UserName);

    private sealed record HospitalOption(string Id, string Name);
    private sealed record TemplateOption(string Id, string Name);
}
