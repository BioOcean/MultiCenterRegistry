@page "/cases/{CaseId:guid}"
@inherits BasePage

<PageTitle>@(_case == null ? "病例详情" : $"{_case.PatientName} - 病例详情")</PageTitle>

<div class="detail-page case-detail-page">
    <div class="detail-header case-detail-header">
        <div class="case-header-main">
            <MudIconButton Class="case-back-button"
                           Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Primary"
                           OnClick="BackToList"
                           title="返回" />
            <div class="case-patient-line">
                <h1>@(_case?.PatientName ?? "病例详情")</h1>
                @if (_case != null)
                {
                    <span class="case-patient-meta">@GetCaseSubtitle()</span>
                    <span class="status-pill @GetStatusClass(_case.Status)">@GetStatusText(_case.Status)</span>
                }
            </div>
        </div>
        @if (_case != null && CanShowCaseActions())
        {
            <div class="header-actions case-header-actions">
                @if (_isEditing && HasPermission(PermissionConstants.CaseEdit))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveCaseAsync">保存表单</MudButton>
                }
                @if ((_case.Status is 1 or 3 or 4) && HasPermission(PermissionConstants.CaseSubmit))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" OnClick="SubmitCaseAsync">提交审核</MudButton>
                }
                @if (_case.Status == 0 && HasPermission(PermissionConstants.CaseApprove))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="ApproveCaseAsync">审核通过</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Close" OnClick="@(() => RejectCaseAsync(0))">审核不通过</MudButton>
                }
                @if (_case.Status == 2 && HasPermission(PermissionConstants.QualityManage))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Reply" OnClick="@(() => RejectCaseAsync(1))">质控退回</MudButton>
                }
                @if (CanDeleteCase)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteCaseAsync">删除病例</MudButton>
                }
            </div>
        }
    </div>

    @if (_isLoading)
    {
        <MudPaper Class="loading-panel" Elevation="0">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>正在加载病例详情</span>
        </MudPaper>
    }
    else if (_case == null || _edit == null)
    {
        <MudPaper Class="loading-panel" Elevation="0">未找到病例</MudPaper>
    }
    else
    {
        <div class="case-detail-scroll">
            @if (_advices.Count > 0)
            {
                <MudPaper Class="advice-panel" Elevation="0">
                    <div class="panel-title">
                        <h2>审核意见</h2>
                        <span>@_advices.Count 条</span>
                    </div>
                    <div class="advice-list">
                        @foreach (var advice in _advices)
                        {
                            <div class="advice-item">
                                <div>@ShowValue(advice.Content)</div>
                                <span>@GetAdviceTypeText(advice.AdviceType) · @FormatDateTime(advice.CreatedAt)</span>
                            </div>
                        }
                    </div>
                </MudPaper>
            }

            <div class="form-layout">
                <nav class="form-nav">
                    <div class="form-nav-title">表单目录</div>
                    @foreach (var navItem in _sections)
                    {
                        var visibleFields = GetVisibleFields(navItem);
                        <button type="button"
                                class="form-nav-link"
                                title="@navItem.Title"
                                @onclick="@(() => ScrollToSectionAsync(navItem.AnchorId))">
                            <span class="form-nav-dot"></span>
                            <span class="form-nav-text">@navItem.Title</span>
                            <span class="form-nav-count">@visibleFields.Count</span>
                        </button>
                    }
                </nav>

                <div class="form-content">
                    @foreach (var formSection in _sections)
                    {
                        var visibleFields = GetVisibleFields(formSection);
                        <MudPaper Class="form-section" Elevation="0">
                            <button type="button" id="@formSection.AnchorId" class="section-header" @onclick="@(() => ToggleSection(formSection.AnchorId))">
                                <span class="section-title">
                                    <span class="section-marker"></span>
                                    <span>@formSection.Title</span>
                                </span>
                                <span class="section-count">@visibleFields.Count 项</span>
                                <MudIcon Icon="@GetSectionIcon(formSection.AnchorId)" Size="Size.Small" />
                            </button>
                            @if (IsSectionExpanded(formSection.AnchorId))
                            {
                                <div class="@GetSectionFieldsClass(formSection)">
                                    @foreach (var field in visibleFields)
                                    {
                                        @FieldRow(field)
                                    }
                                    @if (NeedsGridFiller(visibleFields))
                                    {
                                        <div class="question-row filler" aria-hidden="true"></div>
                                    }
                                </div>
                            }
                        </MudPaper>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (_previewImageFile != null)
{
    <div class="image-preview-mask" role="presentation" @onclick="CloseImagePreview">
        <section class="image-preview-dialog" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <button type="button" class="image-preview-close" title="关闭" @onclick="CloseImagePreview">
                <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Medium" />
            </button>
            <img src="@GetFileUrl(_previewImageFile, false)" alt="" />
        </section>
    </div>
}

@code {
    [Parameter]
    public Guid CaseId { get; set; }

    private RegistryCase? _case;
    private CaseEditModel? _edit;
    private readonly List<CaseAdvice> _advices = [];
    private readonly List<RegistryFile> _files = [];
    private readonly List<CaseFormSection> _sections = [];
    private readonly List<FieldOption> _hospitalOptions = [];
    private readonly List<FieldOption> _operatorOptions = [];
    private readonly List<string> _scopeHospitalIds = [];
    private readonly HashSet<string> _expandedSections = new(StringComparer.OrdinalIgnoreCase);
    private RegistryFile? _previewImageFile;
    private bool _isLoading = true;
    private bool _isEditing;

    private bool CanDeleteCase
        => _case != null
           && HasPermission(PermissionConstants.CaseDelete)
           && _case.Status != 2
           && (!IsHospitalQualityRole || string.Equals(_case.CreatedBy, CurrentUserId, StringComparison.OrdinalIgnoreCase));

    private bool IsHospitalQualityRole
        => HasPermission(PermissionConstants.CaseApprove)
           && !HasPermission(PermissionConstants.QualityManage)
           && !HasPermission(PermissionConstants.CaseSubmit);

    protected override async Task OnPageInitializedAsync()
    {
        await LoadRoleScopesAsync();
        await LoadHospitalOptionsAsync();
        await LoadCaseAsync();
    }

    private async Task LoadRoleScopesAsync()
    {
        if (_registryContext == null || !Guid.TryParse(CurrentUserId, out var userId) || CurrentRoleId == Guid.Empty)
        {
            return;
        }

        _scopeHospitalIds.Clear();
        _scopeHospitalIds.AddRange(await _registryContext.SystemUserRoleScopes.AsNoTracking()
            .Where(x => x.UserId == userId && x.RoleId == CurrentRoleId)
            .Select(x => x.HospitalId.ToString())
            .Distinct()
            .ToListAsync());
    }

    private async Task LoadHospitalOptionsAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        var query = _registryContext.SystemHospitals.AsNoTracking();
        if (!HasPermission(PermissionConstants.QualityManage))
        {
            if (_scopeHospitalIds.Count == 0)
            {
                _hospitalOptions.Clear();
                return;
            }

            var scopeIds = _scopeHospitalIds.Select(TryParseGuid).Where(x => x.HasValue).Select(x => x!.Value).ToList();
            query = query.Where(x => scopeIds.Contains(x.Id));
        }

        _hospitalOptions.Clear();
        _hospitalOptions.AddRange(await query
            .OrderBy(x => x.Name)
            .Select(x => new FieldOption(x.Id.ToString(), x.Name))
            .ToListAsync());
    }

    private async Task LoadOperatorOptionsAsync(string? hospitalId)
    {
        if (_registryContext == null)
        {
            return;
        }

        string[] operatorPermissionCodes = [PermissionConstants.CaseSubmit, "Power-MCR-N-N-N-Operator"];
        var query =
            from user in _registryContext.SystemUsers.AsNoTracking()
            join userRole in _registryContext.SystemMapUserRoles.AsNoTracking() on user.Id equals userRole.UserId
            join rolePermission in _registryContext.SystemMapRolePermissions.AsNoTracking() on userRole.RoleId equals rolePermission.RoleId
            join permission in _registryContext.SystemPermissions.AsNoTracking() on rolePermission.PermissionId equals permission.Id
            where user.IsValid && permission.Code != null && operatorPermissionCodes.Contains(permission.Code)
            select new { user.Id, user.DisplayName, user.Account, userRole.RoleId };

        if (Guid.TryParse(hospitalId, out var hospitalGuid))
        {
            query = query.Where(x =>
                !_registryContext.SystemUserRoleScopes.Any(scope => scope.UserId == x.Id && scope.RoleId == x.RoleId)
                || _registryContext.SystemUserRoleScopes.Any(scope => scope.UserId == x.Id && scope.RoleId == x.RoleId && scope.HospitalId == hospitalGuid));
        }

        var rows = await query.ToListAsync();
        _operatorOptions.Clear();
        _operatorOptions.AddRange(rows
            .GroupBy(x => x.Id)
            .Select(x => x.First())
            .OrderBy(x => x.DisplayName)
            .ThenBy(x => x.Account)
            .Select(x => new FieldOption(x.Id.ToString(), x.DisplayName == "" ? x.Account : x.DisplayName)));

        await EnsureCurrentOperatorOptionAsync();
    }

    private async Task EnsureCurrentOperatorOptionAsync()
    {
        if (_registryContext == null || _edit == null || string.IsNullOrWhiteSpace(_edit.OperatorId) || _operatorOptions.Any(x => IsSameValue(x.Value, _edit.OperatorId)))
        {
            return;
        }

        var operatorText = _case?.OperatorName;
        if (Guid.TryParse(_edit.OperatorId, out var operatorId))
        {
            operatorText = await _registryContext.SystemUsers.AsNoTracking()
                .Where(x => x.Id == operatorId)
                .Select(x => x.DisplayName == "" ? x.Account : x.DisplayName)
                .FirstOrDefaultAsync() ?? operatorText;
        }

        _operatorOptions.Add(new FieldOption(_edit.OperatorId, string.IsNullOrWhiteSpace(operatorText) ? _edit.OperatorId : operatorText));
    }

    private async Task LoadCaseAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _isLoading = true;
        try
        {
            _case = await _registryContext.Cases.AsNoTracking().FirstOrDefaultAsync(x => x.Id == CaseId);
            if (_case != null && !await CanAccessCaseAsync(_case))
            {
                _case = null;
                inj_snackbar.Add("当前账号无权查看该病例", Severity.Warning);
            }

            _edit = _case == null ? null : CaseEditModel.FromCase(_case);
            _isEditing = CanEditCaseForm();

            _advices.Clear();
            _files.Clear();
            _sections.Clear();
            _expandedSections.Clear();
            if (_case == null)
            {
                return;
            }

            await LoadOperatorOptionsAsync(_edit?.HospitalId);
            BuildCaseSections();

            _advices.AddRange(await _registryContext.CaseAdvices.AsNoTracking()
                .Where(x => x.CaseId == CaseId)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync());
            _files.AddRange(await _registryContext.Files.AsNoTracking()
                .Where(x => x.OwnerType == "case" && x.OwnerId == CaseId)
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<bool> CanAccessCaseAsync(RegistryCase item)
    {
        if (_registryContext == null)
        {
            return false;
        }

        if (HasPermission(PermissionConstants.QualityManage))
        {
            return true;
        }

        if (HasPermission(PermissionConstants.CaseApprove))
        {
            return !string.IsNullOrWhiteSpace(item.HospitalId) && _scopeHospitalIds.Contains(item.HospitalId);
        }

        if (HasPermission(PermissionConstants.CaseSubmit) && string.Equals(item.OperatorId, CurrentUserId, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        if (HasAnyPermission(PermissionConstants.AppraiseEdit, PermissionConstants.AppraiseView))
        {
            return await _registryContext.CaseAppraises.AsNoTracking()
                .AnyAsync(x => x.CaseId == item.Id && x.ExpertId == CurrentUserId)
                || await _registryContext.CaseSummaries.AsNoTracking()
                    .AnyAsync(x => x.CaseId == item.Id && x.CreatedBy == CurrentUserId);
        }

        return false;
    }

    private void BuildCaseSections()
    {
        var basicFields = new List<CaseFormField>
        {
            new("patient_number", "病案号"),
            new("patient_name", "患者姓名"),
            new("patient_sex", "性别"),
            new("patient_age", "年龄"),
            new("id_number", "身份证号码"),
            new("department_name", "住院科室"),
            new("admission_time", "入院时间"),
            new("discharge_time", "出院时间"),
            new("hospital_stay_days", "住院天数", true),
            new("surgery_type", "手术类型", true),
            new("operator", "术者"),
            new("is_emergency_intervention", "是否急诊介入"),
            new("death_time", "死亡时间"),
            new("situation_reason", "情况说明/原因说明"),
            new("situation_supplement", "补充说明", true),
            new("discharge_mode", "离院方式")
        };

        if (GetDiseaseSpecificField() is { } diseaseSpecificField)
        {
            basicFields.Add(diseaseSpecificField);
        }

        AddCaseSection("case-basic", "患者基本信息", basicFields);
        AddCaseSection("case-summary", "病历摘要", [new("case_summary", "摘要内容", true)]);
        AddCaseSection("case-discharge-diagnosis", "出院诊断", [new("discharge_diagnosis", "出院诊断", true)]);
        AddCaseSection("case-lab-exam", "相关实验室检查", [new("lab_file", "化验单图片上传", true, true)]);
        AddCaseSection("case-assist-exam", "主要辅助检查",
        [
            new("ecg_file", "心电图图片上传", true, true),
            new("echo_file", "心脏彩超", true, true),
            new("other_exam", "其他检查", true)
        ]);
        AddCaseSection("case-intervention", "介入诊疗情况",
        [
            new("angiography_result", "造影检查结果", true),
            new("intervention_process", "介入经过", true)
        ]);
        AddCaseSection("case-rescue", "并发症救治情况", [new("rescue_process", "救治经过", true)]);
        AddCaseSection("case-discussion", "并发症讨论结论",
        [
            new("complication_discussion", "是否组织医院或科室并发症讨论", true),
            new("occurrence_reason", "发生原因", true),
            new("death_reason", "死亡原因", true),
            new("lessons_learned", "经验教训", true),
            new("improvement_measures", "改进措施", true)
        ]);
    }

    private void AddCaseSection(string anchorId, string title, List<CaseFormField> fields)
    {
        _sections.Add(new CaseFormSection(title, anchorId, fields));
        _expandedSections.Add(anchorId);
    }

    private CaseFormField? GetDiseaseSpecificField()
    {
        if (IsSameValue(_edit?.DiseaseId, "6237dd62-15b9-4676-972d-bf32476b3546"))
        {
            return new("coronary_intervention", "冠心病介入");
        }

        if (IsSameValue(_edit?.DiseaseId, "ae92e4fa-5e02-4d4c-a773-3dc79c4935bc"))
        {
            return new("ablation_intervention", "导管消融");
        }

        if (IsSameValue(_edit?.DiseaseId, "c1174c60-2ef2-45f6-85dd-5269b567f996"))
        {
            return new("structural_intervention", "结构性心脏病介入");
        }

        return null;
    }

    private void BackToList() => inj_navigationManager.NavigateTo(RouteConstants.CaseList);

    private async Task SaveCaseAsync()
    {
        if (_registryContext == null || _edit == null || !await RequirePermissionAsync(PermissionConstants.CaseEdit))
        {
            return;
        }

        if (!CanEditCaseForm())
        {
            inj_snackbar.Add("当前病例状态不能编辑表单", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_edit.PatientNumber) || string.IsNullOrWhiteSpace(_edit.DiseaseId))
        {
            inj_snackbar.Add("请填写病案号和手术类型", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认保存当前病例表单修改？"))
        {
            return;
        }

        var item = await _registryContext.Cases.FirstOrDefaultAsync(x => x.Id == CaseId);
        if (item == null)
        {
            inj_snackbar.Add("病例不存在", Severity.Warning);
            return;
        }

        ApplyEdit(item, _edit);
        await SaveFileRemarksAsync();
        item.UpdatedAt = ToDbTimestamp(DateTime.Now);
        item.UpdatedBy = CurrentUserId;

        _registryContext.OperationLogs.Add(CreateOperationLog("病例", "保存表单", "case", CaseId));
        await _registryContext.SaveChangesAsync();
        _isEditing = CanEditCaseForm();
        inj_snackbar.Add("病例表单已保存", Severity.Success);
        await LoadCaseAsync();
    }

    private void ApplyEdit(RegistryCase item, CaseEditModel edit)
    {
        item.PatientName = edit.PatientName.Trim();
        item.PatientNumber = EmptyToNull(edit.PatientNumber);
        item.PatientSex = EmptyToNull(edit.PatientSex);
        item.PatientSexText = RegistryFixedCatalog.GetSexName(edit.PatientSex);
        item.PatientAge = EmptyToNull(edit.PatientAge);
        item.IdNumber = EmptyToNull(edit.IdNumber);
        item.DiseaseId = EmptyToNull(edit.DiseaseId);
        item.DiseaseName = RegistryFixedCatalog.GetDiseaseName(edit.DiseaseId);
        item.SurgeryTypeValue = EmptyToNull(edit.DiseaseId);
        item.SurgeryTypeText = RegistryFixedCatalog.GetDiseaseName(edit.DiseaseId);
        item.HospitalId = EmptyToNull(edit.HospitalId);
        item.HospitalName = _hospitalOptions.FirstOrDefault(x => IsSameValue(x.Value, edit.HospitalId))?.Text;
        item.DepartmentName = EmptyToNull(edit.DepartmentName);
        item.OperatorId = EmptyToNull(edit.OperatorId);
        item.OperatorName = _operatorOptions.FirstOrDefault(x => IsSameValue(x.Value, edit.OperatorId))?.Text;
        item.AdmissionTime = ToDbTimestamp(edit.AdmissionTime);
        item.DischargeTime = ToDbTimestamp(edit.DischargeTime);
        item.OperationTime = ToDbTimestamp(edit.OperationTime);
        item.HospitalStayDays = edit.HospitalStayDays;
        if (!item.HospitalStayDays.HasValue && item.AdmissionTime.HasValue && item.DischargeTime.HasValue)
        {
            item.HospitalStayDays = Math.Max(0, (int)(item.DischargeTime.Value.Date - item.AdmissionTime.Value.Date).TotalDays);
        }

        item.CoronaryIntervention = EmptyToNull(edit.CoronaryIntervention);
        item.AblationIntervention = EmptyToNull(edit.AblationIntervention);
        item.StructuralIntervention = EmptyToNull(edit.StructuralIntervention);
        item.IsEmergencyIntervention = EmptyToNull(edit.IsEmergencyIntervention);
        item.DischargeMode = EmptyToNull(edit.DischargeMode);
        item.SituationReason = EmptyToNull(edit.SituationReason);
        item.SituationSupplement = ShouldShowSituationSupplement(edit) ? EmptyToNull(edit.SituationSupplement) : null;
        item.DeathTime = ShouldShowDeathTime(edit) ? ToDbTimestamp(edit.DeathTime) : null;
        item.CaseSummary = EmptyToNull(edit.CaseSummary);
        item.DischargeDiagnosis = EmptyToNull(edit.DischargeDiagnosis);
        item.OtherExam = EmptyToNull(edit.OtherExam);
        item.AngiographyResult = EmptyToNull(edit.AngiographyResult);
        item.InterventionProcess = EmptyToNull(edit.InterventionProcess);
        item.RescueProcess = EmptyToNull(edit.RescueProcess);
        item.ComplicationDiscussion = EmptyToNull(edit.ComplicationDiscussion);
        item.OccurrenceReason = ShouldShowDiscussionFollowup(edit) ? EmptyToNull(edit.OccurrenceReason) : null;
        item.DeathReason = ShouldShowDiscussionFollowup(edit) ? EmptyToNull(edit.DeathReason) : null;
        item.LessonsLearned = ShouldShowDiscussionFollowup(edit) ? EmptyToNull(edit.LessonsLearned) : null;
        item.ImprovementMeasures = ShouldShowDiscussionFollowup(edit) ? EmptyToNull(edit.ImprovementMeasures) : null;
    }

    private async Task SaveFileRemarksAsync()
    {
        if (_registryContext == null || _files.Count == 0)
        {
            return;
        }

        var remarks = _files.ToDictionary(x => x.Id, x => EmptyToNull(x.Remark));
        var fileIds = remarks.Keys.ToList();
        var files = await _registryContext.Files
            .Where(x => fileIds.Contains(x.Id) && x.OwnerType == "case" && x.OwnerId == CaseId)
            .ToListAsync();

        foreach (var file in files)
        {
            file.Remark = remarks[file.Id];
        }
    }

    private async Task SubmitCaseAsync()
    {
        if (_registryContext == null || _case == null || !await RequirePermissionAsync(PermissionConstants.CaseSubmit) || !await ConfirmAsync("确认提交该病例进入审核？"))
        {
            return;
        }

        if (_case.Status is not (1 or 3 or 4))
        {
            inj_snackbar.Add("当前状态不能提交审核", Severity.Warning);
            return;
        }

        await _registryContext.Cases.Where(x => x.Id == CaseId)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.Status, 0)
                .SetProperty(x => x.UpdatedAt, ToDbTimestamp(DateTime.Now))
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
        _registryContext.OperationLogs.Add(CreateOperationLog("病例", "提交审核", "case", CaseId));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("病例已提交审核", Severity.Success);
        await LoadCaseAsync();
    }

    private async Task ApproveCaseAsync()
    {
        if (_registryContext == null || _case == null || !await RequirePermissionAsync(PermissionConstants.CaseApprove) || !await ConfirmAsync("确认审核通过该病例？"))
        {
            return;
        }

        if (_case.Status != 0)
        {
            inj_snackbar.Add("当前状态不能审核通过", Severity.Warning);
            return;
        }

        await _registryContext.Cases.Where(x => x.Id == CaseId)
            .ExecuteUpdateAsync(setters => setters
                .SetProperty(x => x.Status, 2)
                .SetProperty(x => x.SubStatus, 0)
                .SetProperty(x => x.UpdatedAt, ToDbTimestamp(DateTime.Now))
                .SetProperty(x => x.UpdatedBy, CurrentUserId));
        _registryContext.OperationLogs.Add(CreateOperationLog("病例", "审核通过", "case", CaseId));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("病例审核通过", Severity.Success);
        await LoadCaseAsync();
    }

    private async Task RejectCaseAsync(int type)
    {
        if (_registryContext == null || _case == null)
        {
            return;
        }

        var permission = type == 0 ? PermissionConstants.CaseApprove : PermissionConstants.QualityManage;
        if (!await RequirePermissionAsync(permission))
        {
            return;
        }

        var advice = await PromptAsync(type == 0 ? "请输入审核不通过意见" : "请输入质控退回意见");
        if (string.IsNullOrWhiteSpace(advice) || !await ConfirmAsync("确认执行驳回/退回操作？"))
        {
            return;
        }

        if (type == 0 && _case.Status is 0 or 1)
        {
            await _registryContext.Cases.Where(x => x.Id == CaseId)
                .ExecuteUpdateAsync(setters => setters
                    .SetProperty(x => x.Status, 4)
                    .SetProperty(x => x.UpdatedAt, ToDbTimestamp(DateTime.Now))
                    .SetProperty(x => x.UpdatedBy, CurrentUserId));
        }
        else if (type == 1 && _case.Status == 2)
        {
            await _registryContext.Cases.Where(x => x.Id == CaseId)
                .ExecuteUpdateAsync(setters => setters
                    .SetProperty(x => x.Status, 1)
                    .SetProperty(x => x.SubStatus, -1)
                    .SetProperty(x => x.UpdatedAt, ToDbTimestamp(DateTime.Now))
                    .SetProperty(x => x.UpdatedBy, CurrentUserId));
        }
        else
        {
            inj_snackbar.Add("当前状态不能执行该操作", Severity.Warning);
            return;
        }

        _registryContext.CaseAdvices.Add(new CaseAdvice
        {
            CaseId = CaseId,
            AdviceType = type,
            Content = advice,
            CreatedAt = ToDbTimestamp(DateTime.Now)!.Value,
            CreatedBy = CurrentUserId
        });
        _registryContext.OperationLogs.Add(CreateOperationLog("病例", type == 0 ? "审核不通过" : "质控退回", "case", CaseId, advice));
        await _registryContext.SaveChangesAsync();
        inj_snackbar.Add("操作已完成", Severity.Success);
        await LoadCaseAsync();
    }

    private async Task DeleteCaseAsync()
    {
        if (_registryContext == null || _case == null || !await RequirePermissionAsync(PermissionConstants.CaseDelete))
        {
            return;
        }

        if (_case.Status == 2)
        {
            inj_snackbar.Add("已上报病例不能删除", Severity.Warning);
            return;
        }

        if (IsHospitalQualityRole && !string.Equals(_case.CreatedBy, CurrentUserId, StringComparison.OrdinalIgnoreCase))
        {
            inj_snackbar.Add("医院质控员只能删除自己创建的病例", Severity.Warning);
            return;
        }

        if (!await ConfirmAsync("确认删除该病例？病例附件、意见、评审和汇总都会删除。"))
        {
            return;
        }

        await using var transaction = await _registryContext.Database.BeginTransactionAsync();
        var appraiseIds = await _registryContext.CaseAppraises.AsNoTracking()
            .Where(x => x.CaseId == CaseId)
            .Select(x => x.Id)
            .ToListAsync();
        var summaryIds = await _registryContext.CaseSummaries.AsNoTracking()
            .Where(x => x.CaseId == CaseId)
            .Select(x => x.Id)
            .ToListAsync();
        var voteIds = await _registryContext.CaseVotes.AsNoTracking()
            .Where(x => x.CaseId == CaseId)
            .Select(x => x.Id)
            .ToListAsync();
        var adviceIds = await _registryContext.CaseAdvices.AsNoTracking()
            .Where(x => x.CaseId == CaseId)
            .Select(x => x.Id)
            .ToListAsync();

        await _registryContext.CaseVotes.Where(x => x.CaseId == CaseId).ExecuteDeleteAsync();
        await _registryContext.CaseSummaries.Where(x => x.CaseId == CaseId).ExecuteDeleteAsync();
        await _registryContext.CaseAppraises.Where(x => x.CaseId == CaseId).ExecuteDeleteAsync();
        await _registryContext.CaseAdvices.Where(x => x.CaseId == CaseId).ExecuteDeleteAsync();
        await _registryContext.Files.Where(x => x.OwnerType == "case" && x.OwnerId == CaseId).ExecuteDeleteAsync();

        var targetIds = new List<Guid> { CaseId };
        targetIds.AddRange(appraiseIds);
        targetIds.AddRange(summaryIds);
        targetIds.AddRange(voteIds);
        targetIds.AddRange(adviceIds);
        await _registryContext.MigrationMaps.Where(x => targetIds.Contains(x.TargetId)).ExecuteDeleteAsync();
        await _registryContext.Cases.Where(x => x.Id == CaseId).ExecuteDeleteAsync();

        _registryContext.OperationLogs.Add(CreateOperationLog("病例", "删除", "case", CaseId, _case.PatientName));
        await _registryContext.SaveChangesAsync();
        await transaction.CommitAsync();

        inj_snackbar.Add("病例已删除", Severity.Success);
        inj_navigationManager.NavigateTo(RouteConstants.CaseList);
    }

