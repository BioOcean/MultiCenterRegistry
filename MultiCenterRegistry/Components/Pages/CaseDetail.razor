    private List<RegistryFile> GetFilesForField(string fieldKey)
        => _files
            .Where(x => x.FilePath.Contains($"/{fieldKey}/", StringComparison.OrdinalIgnoreCase)
                        || x.FilePath.Contains($"\\{fieldKey}\\", StringComparison.OrdinalIgnoreCase))
            .ToList();

    private static bool IsImageFile(RegistryFile file)
        => file.ContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true
           || IsImageExtension(Path.GetExtension(file.FileName));

    private static bool IsImageExtension(string? extension)
        => extension?.ToLowerInvariant() is ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".webp";

    private string GetFileUrl(RegistryFile file, bool download)
        => $"{inj_navigationManager.BaseUri.TrimEnd('/')}/files/{file.Id}?download={download.ToString().ToLowerInvariant()}";

    private async Task UploadCaseFileAsync(string fieldKey, InputFileChangeEventArgs args)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.CaseEdit))
        {
            return;
        }

        var file = args.File;
        if (!IsAllowedCaseFile(file.Name, file.ContentType))
        {
            inj_snackbar.Add("请选择图片或 DICOM 文件", Severity.Warning);
            return;
        }

        const long maxFileSize = 50 * 1024 * 1024;
        var isDicom = IsDicomFile(file.Name, file.ContentType);
        var storageRoot = isDicom
            ? inj_configuration["FileStorage:DicomRoot"] ?? "FileStorage\\dicom"
            : inj_configuration["FileStorage:UploadRoot"] ?? "FileStorage\\upload";
        var storageArea = isDicom ? "dicom" : "upload";
        var rootPath = ResolveStorageRoot(storageRoot).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar);
        var relativeDirectory = Path.Combine("cases", CaseId.ToString("N"), fieldKey);
        var directory = Path.Combine(rootPath, relativeDirectory);
        Directory.CreateDirectory(directory);

        var extension = Path.GetExtension(file.Name);
        if (string.IsNullOrWhiteSpace(extension))
        {
            extension = isDicom ? ".dcm" : ".img";
        }

        var storedName = $"{Guid.NewGuid():N}{extension}";
        var fullPath = Path.Combine(directory, storedName);
        await using (var source = file.OpenReadStream(maxFileSize))
        await using (var target = File.Create(fullPath))
        {
            await source.CopyToAsync(target);
        }

        _registryContext.Files.Add(new RegistryFile
        {
            OwnerType = "case",
            OwnerId = CaseId,
            FileName = SanitizeFileName(file.Name),
            FilePath = NormalizeFilePath($"{storageArea}/{relativeDirectory}/{storedName}"),
            ContentType = string.IsNullOrWhiteSpace(file.ContentType) && isDicom ? "application/dicom" : file.ContentType,
            FileSize = file.Size,
            Remark = null,
            CreatedAt = ToDbTimestamp(DateTime.Now)!.Value,
            CreatedBy = CurrentUserId
        });
        _registryContext.OperationLogs.Add(CreateOperationLog("病例", "上传文件", "case", CaseId, fieldKey));
        await _registryContext.SaveChangesAsync();
        await LoadCaseFilesAsync();
        inj_snackbar.Add("文件已上传", Severity.Success);
    }

    private static bool IsAllowedCaseFile(string fileName, string? contentType)
        => IsImageFile(fileName, contentType) || IsDicomFile(fileName, contentType);

    private static bool IsDicomFile(string fileName, string? contentType)
        => string.Equals(contentType, "application/dicom", StringComparison.OrdinalIgnoreCase)
           || string.Equals(Path.GetExtension(fileName), ".dcm", StringComparison.OrdinalIgnoreCase);

    private static bool IsImageFile(string fileName, string? contentType)
        => contentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true
           || IsImageExtension(Path.GetExtension(fileName));

    private string ResolveStorageRoot(string root)
    {
        var normalizedRoot = NormalizeConfiguredPath(root);
        return Path.GetFullPath(Path.IsPathRooted(normalizedRoot) ? normalizedRoot : Path.Combine(inj_webHostEnvironment.ContentRootPath, normalizedRoot));
    }

    private static string NormalizeConfiguredPath(string value)
        => value.Trim()
            .Replace('\\', Path.DirectorySeparatorChar)
            .Replace('/', Path.DirectorySeparatorChar);

    private static string NormalizeFilePath(string value) => value.Replace('\\', '/');

    private static string SanitizeFileName(string fileName)
    {
        var invalidChars = Path.GetInvalidFileNameChars();
        var cleaned = new string(fileName.Select(x => invalidChars.Contains(x) ? '_' : x).ToArray()).Trim();
        return string.IsNullOrWhiteSpace(cleaned) ? "upload" : cleaned;
    }

    private async Task LoadCaseFilesAsync()
    {
        if (_registryContext == null)
        {
            return;
        }

        _files.Clear();
        _files.AddRange(await _registryContext.Files.AsNoTracking()
            .Where(x => x.OwnerType == "case" && x.OwnerId == CaseId)
            .OrderByDescending(x => x.CreatedAt)
            .ToListAsync());
    }

    private void UpdateFileRemark(Guid fileId, string? value)
    {
        var file = _files.FirstOrDefault(x => x.Id == fileId);
        if (file != null)
        {
            file.Remark = value;
        }
    }

    private void OpenImagePreview(RegistryFile file) => _previewImageFile = file;

    private void CloseImagePreview() => _previewImageFile = null;

    private async Task DeleteCaseFileAsync(Guid fileId)
    {
        if (_registryContext == null || !await RequirePermissionAsync(PermissionConstants.CaseEdit))
        {
            return;
        }

        if (!_isEditing)
        {
            inj_snackbar.Add("当前病例状态不能删除附件", Severity.Warning);
            return;
        }

        var file = await _registryContext.Files.FirstOrDefaultAsync(x => x.Id == fileId && x.OwnerType == "case" && x.OwnerId == CaseId);
        if (file == null)
        {
            inj_snackbar.Add("附件不存在", Severity.Warning);
            await LoadCaseFilesAsync();
            return;
        }

        if (!await ConfirmAsync("确认删除该附件？"))
        {
            return;
        }

        TryDeleteLocalFile(file.FilePath);
        if (_previewImageFile?.Id == fileId)
        {
            _previewImageFile = null;
        }

        _registryContext.Files.Remove(file);
        _registryContext.OperationLogs.Add(CreateOperationLog("病例", "删除文件", "case", CaseId, file.FileName));
        await _registryContext.SaveChangesAsync();
        await LoadCaseFilesAsync();
        inj_snackbar.Add("附件已删除", Severity.Success);
    }

    private void TryDeleteLocalFile(string? filePath)
    {
        if (string.IsNullOrWhiteSpace(filePath))
        {
            return;
        }

        var normalizedPath = NormalizeFilePath(filePath);
        var isDicom = normalizedPath.StartsWith("dicom/", StringComparison.OrdinalIgnoreCase);
        var storageRoot = isDicom
            ? inj_configuration["FileStorage:DicomRoot"] ?? "FileStorage\\dicom"
            : inj_configuration["FileStorage:UploadRoot"] ?? "FileStorage\\upload";
        var rootPath = ResolveStorageRoot(storageRoot);
        var relativePath = isDicom
            ? normalizedPath["dicom/".Length..]
            : normalizedPath.StartsWith("upload/", StringComparison.OrdinalIgnoreCase)
                ? normalizedPath["upload/".Length..]
                : normalizedPath;
        var fullPath = Path.GetFullPath(Path.Combine(rootPath, relativePath));
        if (!string.Equals(fullPath, rootPath, StringComparison.OrdinalIgnoreCase)
            && !fullPath.StartsWith(rootPath + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (File.Exists(fullPath))
        {
            File.Delete(fullPath);
        }
    }

