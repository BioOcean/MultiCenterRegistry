    private RenderFragment SelectField(IReadOnlyList<FixedOption> options, string? value, Action<string?> setter) => builder =>
    {
        builder.OpenComponent<McrSearchSelect>(0);
        builder.AddAttribute(1, "Class", "form-search-select");
        builder.AddAttribute(2, "Options", options);
        builder.AddAttribute(3, "Value", value);
        builder.AddAttribute(4, "ValueChanged", EventCallback.Factory.Create<string?>(this, setter));
        builder.AddAttribute(5, "Disabled", !_isEditing);
        builder.AddAttribute(6, "Placeholder", "请选择");
        builder.CloseComponent();
    };

    private RenderFragment HospitalField() => SelectField(_hospitalOptions.Select(x => new FixedOption(x.Value, x.Text)).ToList(), _edit?.HospitalId, SetHospital);

    private RenderFragment OperatorField() => SelectField(_operatorOptions.Select(x => new FixedOption(x.Value, x.Text)).ToList(), _edit?.OperatorId, value => _edit!.OperatorId = value);

    private void SetHospital(string? value)
    {
        if (_edit == null)
        {
            return;
        }

        _edit.HospitalId = value;
        _ = InvokeAsync(async () =>
        {
            await LoadOperatorOptionsAsync(value);
            StateHasChanged();
        });
    }

    private void SetDisease(string? value)
    {
        if (_edit != null)
        {
            _edit.DiseaseId = value;
            _edit.CoronaryIntervention = null;
            _edit.AblationIntervention = null;
            _edit.StructuralIntervention = null;
            _sections.Clear();
            _expandedSections.Clear();
            BuildCaseSections();
        }
    }

    private List<CaseFormField> GetVisibleFields(CaseFormSection section)
        => section.Fields.Where(field => IsVisibleField(section, field)).ToList();

    private bool IsVisibleField(CaseFormSection section, CaseFormField field)
    {
        if (field.Key == "death_time")
        {
            return ShouldShowDeathTime(_edit);
        }

        if (field.Key == "situation_supplement")
        {
            return ShouldShowSituationSupplement(_edit);
        }

        if (section.AnchorId == "case-discussion" && field.Key != "complication_discussion")
        {
            return ShouldShowDiscussionFollowup(_edit);
        }

        return true;
    }

    private static bool ShouldShowDeathTime(CaseEditModel? edit)
        => IsSameValue(edit?.DischargeMode, "死亡");

    private static bool ShouldShowSituationSupplement(CaseEditModel? edit)
        => IsSameValue(edit?.SituationReason, "4") || IsSameValue(edit?.SituationReason, "其他");

    private static bool ShouldShowDiscussionFollowup(CaseEditModel? edit)
        => IsSameValue(edit?.ComplicationDiscussion, "1") || IsSameValue(edit?.ComplicationDiscussion, "是");

    private string GetQuestionClass(CaseFormField field)
    {
        var classes = new List<string> { "question-row" };
        if (field.FullRow || field.IsFile)
        {
            classes.Add("full-row");
        }

        if (!_isEditing)
        {
            classes.Add("is-disabled");
        }

        return string.Join(" ", classes);
    }

    private string GetChoiceTagClass(string? currentValue, string optionValue)
    {
        var classes = new List<string> { "choice-tag", IsSameValue(currentValue, optionValue) ? "selected" : "unselected" };
        if (!_isEditing)
        {
            classes.Add("disabled");
        }

        return string.Join(" ", classes);
    }

    private static bool IsSameValue(string? left, string? right)
        => string.Equals(left?.Trim(), right?.Trim(), StringComparison.OrdinalIgnoreCase);

    private static Guid? TryParseGuid(string? value)
        => Guid.TryParse(value, out var guid) ? guid : null;

    private static string GetSectionFieldsClass(CaseFormSection section)
        => section.AnchorId == "case-basic" ? "section-fields basic-info-fields" : "section-fields";

    private static bool NeedsGridFiller(IReadOnlyList<CaseFormField> fields)
    {
        var occupiedColumns = 0;
        foreach (var field in fields)
        {
            if (field.FullRow || field.IsFile)
            {
                occupiedColumns = 0;
                continue;
            }

            occupiedColumns++;
            if (occupiedColumns == 2)
            {
                occupiedColumns = 0;
            }
        }

        return occupiedColumns == 1;
    }

    private bool IsSectionExpanded(string key) => _expandedSections.Contains(key);

    private void ToggleSection(string key)
    {
        if (!_expandedSections.Add(key))
        {
            _expandedSections.Remove(key);
        }
    }

    private string GetSectionIcon(string key)
        => IsSectionExpanded(key) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore;

    private async Task ScrollToSectionAsync(string anchorId)
        => await inj_jsRuntime.InvokeVoidAsync("mcrScrollToElement", anchorId);

    private bool CanShowCaseActions()
        => _case != null
            && (CanEditCaseForm()
                || ((_case.Status is 1 or 3 or 4) && HasPermission(PermissionConstants.CaseSubmit))
                || (_case.Status == 0 && HasPermission(PermissionConstants.CaseApprove))
                || (_case.Status == 2 && HasPermission(PermissionConstants.QualityManage))
                || CanDeleteCase);

    private bool CanEditCaseForm()
        => _case?.Status is not null and not (0 or 2)
           && HasPermission(PermissionConstants.CaseEdit);

    private string GetCaseSubtitle()
    {
        if (_case == null)
        {
            return "";
        }

        return $"{ShowSex(_case.PatientSexText ?? _case.PatientSex)} / {ShowValue(_case.PatientAge)}";
    }

    private static string ShowValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string ShowSex(string? value)
        => ShowValue(RegistryFixedCatalog.GetSexName(value));

    private static string FormatDateTime(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm") ?? "-";

    private static int? ParseInt(string? value)
        => int.TryParse(value, out var result) ? result : null;

    private static DateTime? ToDbTimestamp(DateTime? value)
        => value.HasValue ? DateTime.SpecifyKind(value.Value, DateTimeKind.Unspecified) : null;

    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string GetStatusText(int status)
        => status switch
        {
            0 => "待审核",
            1 => "已回退",
            2 => "已上报",
            3 => "待填写",
            4 => "审核失败",
            _ => $"状态 {status}"
        };

    private static string GetStatusClass(int status)
        => status switch
        {
            0 => "status-review",
            1 => "status-returned",
            2 => "status-submitted",
            3 => "status-draft",
            4 => "status-failed",
            _ => "status-unknown"
        };

    private static string GetAdviceTypeText(int type)
        => type switch
        {
            0 => "审核不通过",
            1 => "质控退回",
            _ => "其他意见"
        };

    private sealed record FieldOption(string Value, string Text);

    private sealed record CaseFormSection(string Title, string AnchorId, List<CaseFormField> Fields);

    private sealed record CaseFormField(string Key, string Title, bool FullRow = false, bool IsFile = false);

