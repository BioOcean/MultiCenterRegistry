                    builder.OpenElement(sequence++, "img");
                    builder.AddAttribute(sequence++, "src", GetFileUrl(file, false));
                    builder.AddAttribute(sequence++, "alt", "");
                    builder.CloseElement();
                    builder.OpenElement(sequence++, "span");
                    builder.AddContent(sequence++, "查看大图");
                    builder.CloseElement();
                    builder.CloseElement();
                }
                else
                {
                    builder.OpenElement(sequence++, "div");
                    builder.AddAttribute(sequence++, "class", "file-preview file-preview-file");
                    builder.OpenComponent<MudIcon>(sequence++);
                    builder.AddAttribute(sequence++, "Icon", Icons.Material.Filled.InsertDriveFile);
                    builder.AddAttribute(sequence++, "Size", Size.Small);
                    builder.CloseComponent();
                    builder.CloseElement();
                }

                builder.OpenElement(sequence++, "textarea");
                builder.AddAttribute(sequence++, "class", "form-textarea file-remark");
                builder.AddAttribute(sequence++, "placeholder", "备注");
                builder.AddAttribute(sequence++, "disabled", !_isEditing);
                builder.AddAttribute(sequence++, "value", file.Remark ?? "");
                builder.AddAttribute(sequence++, "oninput", EventCallback.Factory.Create<ChangeEventArgs>(this, args => UpdateFileRemark(file.Id, args.Value?.ToString())));
