@page "/"
@inherits BasePage

<PageTitle>正在进入</PageTitle>

<div class="detail-page">
    <MudPaper Class="loading-panel" Elevation="0">
        @if (_isLoading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            <span>正在进入系统</span>
        }
        else
        {
            <span>暂无可用功能</span>
        }
    </MudPaper>
</div>

@code {
    private bool _isLoading = true;

    protected override Task OnPageInitializedAsync()
    {
        var targetPath = FeatureCatalog.GetDefaultPath(CurrentPermissionCodes);
        if (string.IsNullOrWhiteSpace(targetPath))
        {
            _isLoading = false;
            return Task.CompletedTask;
        }

        inj_navigationManager.NavigateTo(targetPath, true);
        return Task.CompletedTask;
    }
}
