<MudDialog Class="mcr-dialog mcr-prompt-dialog"
           TitleClass="mcr-dialog-title"
           ContentClass="mcr-dialog-content"
           ActionsClass="mcr-dialog-actions">
    <TitleContent>
        <MudText Typo="Typo.h6">输入内容</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mcr-prompt-message">@Message</MudText>
        <MudTextField T="string"
                      @bind-Value="_value"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="4"
                      AutoFocus="true"
                      Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">取消</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">确定</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance DialogInstance { get; set; } = default!;

    [Parameter]
    public string Message { get; set; } = "";

    private string? _value;

    private void Submit()
        => DialogInstance.Close(DialogResult.Ok(_value?.Trim() ?? ""));

    private void Cancel()
        => DialogInstance.Cancel();
}
