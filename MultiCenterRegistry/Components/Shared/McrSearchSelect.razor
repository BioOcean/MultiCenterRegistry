@namespace MultiCenterRegistry.Components.Shared

<MudAutocomplete T="string"
                 Class="@RootClass"
                 InputClass="mcr-search-select-input"
                 PopoverClass="mcr-search-select-popover"
                 Value="@Value"
                 ValueChanged="SelectValueAsync"
                 SearchFunc="SearchOptionsAsync"
                 ToStringFunc="GetOptionText"
                 Placeholder="@Placeholder"
                 Disabled="@Disabled"
                 Variant="Variant.Outlined"
                 Margin="Margin.Dense"
                 Dense="true"
                 MaxItems="500"
                 MaxHeight="260"
                 MinCharacters="0"
                 OpenOnFocus="true"
                 CoerceText="true"
                 CoerceValue="false"
                 ResetValueOnEmptyText="true"
                 Strict="false"
                 OpenIcon="@Icons.Material.Filled.ArrowDropDown">
    <ItemTemplate Context="value">
        <span class="mcr-search-select-option-text">@GetOptionText(value)</span>
    </ItemTemplate>
    <NoItemsTemplate>
        <span class="mcr-search-select-empty">无匹配选项</span>
    </NoItemsTemplate>
</MudAutocomplete>

@code {
    [Parameter]
    public IReadOnlyList<FixedOption> Options { get; set; } = [];

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "请选择";

    [Parameter]
    public string? Class { get; set; }

    private string RootClass
        => string.Join(" ", new[] { "mcr-search-select", Class, Disabled ? "is-disabled" : null }.Where(x => !string.IsNullOrWhiteSpace(x)));

    private Task<IEnumerable<string>> SearchOptionsAsync(string? searchText, System.Threading.CancellationToken cancellationToken)
        => Task.FromResult(Options
            .Where(x => string.IsNullOrWhiteSpace(searchText) || x.Text.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase))
            .Select(x => x.Value)
            .Distinct(StringComparer.OrdinalIgnoreCase));

    private Task SelectValueAsync(string? value)
        => ValueChanged.InvokeAsync(string.IsNullOrWhiteSpace(value) ? null : value);

    private string GetOptionText(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? ""
            : Options.FirstOrDefault(x => string.Equals(x.Value, value, StringComparison.OrdinalIgnoreCase))?.Text ?? "";
}
